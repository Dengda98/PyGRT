    coeffs->dM[0][1][2][2].time_degree = 3;
    coeffs->dM[0][1][2][2].c[1][3] = 8.0 * c_phi * k2 * k_minus_one_times_k_plus_one * two_k2_minus_one_sq / s_theta;
    coeffs->dM[0][1][2][2].c[0][4] = -8.0 * c_theta_c_phi * k2 * k_minus_one_times_k_plus_one * two_k2_minus_one_sq / s_theta;
    coeffs->dM[0][1][2][2].c[1][5] = -8.0 * c_phi * two_k2_minus_one * k4_factor_alt / s_theta;
    coeffs->dM[0][1][2][2].c[0][6] = 8.0 * c_theta_c_phi * two_k2_minus_one * k4_factor_alt / s_theta;
    coeffs->dM[0][1][2][2].c[1][7] = 8.0 * c_phi * k4_factor_alt2 / s_theta;
    coeffs->dM[0][1][2][2].c[0][8] = -8.0 * c_theta_c_phi * k4_factor_alt2 / s_theta;
    coeffs->dM[0][1][2][2].c[1][9] = -64.0 * c_phi * two_k2_minus_one / s_theta;
    coeffs->dM[0][1][2][2].c[0][10] = 64.0 * c_theta_c_phi * two_k2_minus_one / s_theta;
    coeffs->dM[0][1][2][2].c[1][11] = 32.0 * c_phi / s_theta;
    coeffs->dM[0][1][2][2].c[0][12] = -32.0 * c_theta_c_phi / s_theta;
    coeffs->dM[1][1][2][2].degree = 12;
    coeffs->dM[1][1][2][2].time_degree = 3;
    coeffs->dM[1][1][2][2].c[1][3] = 8.0 * k2 * s_phi * k_minus_one_times_k_plus_one * two_k2_minus_one_sq / s_theta;
    coeffs->dM[1][1][2][2].c[0][4] = -8.0 * c_theta * k2 * s_phi * k_minus_one_times_k_plus_one * two_k2_minus_one_sq / s_theta;
    coeffs->dM[1][1][2][2].c[1][5] = -8.0 * s_phi * two_k2_minus_one * k4_factor_alt / s_theta;
    coeffs->dM[1][1][2][2].c[0][6] = 8.0 * c_theta_s_phi * two_k2_minus_one * k4_factor_alt / s_theta;
    coeffs->dM[1][1][2][2].c[1][7] = 8.0 * s_phi * k4_factor_alt2 / s_theta;
    coeffs->dM[1][1][2][2].c[0][8] = -8.0 * c_theta_s_phi * k4_factor_alt2 / s_theta;
    coeffs->dM[1][1][2][2].c[1][9] = -64.0 * s_phi * two_k2_minus_one / s_theta;
    coeffs->dM[1][1][2][2].c[0][10] = 64.0 * c_theta_s_phi * two_k2_minus_one / s_theta;
    coeffs->dM[1][1][2][2].c[1][11] = 32.0 * s_phi / s_theta;
    coeffs->dM[1][1][2][2].c[0][12] = -32.0 * c_theta_s_phi / s_theta;
}

static void make_lamb3_S_coefficients(const LAMB3_VARS *V, LAMB3_COEFF_SET *coeffs) {
    const real_t k = V->k;
    const real_t c_theta = V->ct_ref;
    const real_t s_theta = V->st_ref;
    const real_t c_phi = V->cf;
    const real_t s_phi = V->sf;
    const real_t k2 = k * k;
    const real_t c_theta2 = c_theta * c_theta;
    const real_t s_theta2 = s_theta * s_theta;
    const real_t s_theta3 = s_theta2 * s_theta;
    const real_t c_phi2 = c_phi * c_phi;
    const real_t s_phi2 = s_phi * s_phi;
    const real_t c_phi_s_phi = c_phi * s_phi;
    const real_t c_theta_c_phi = c_theta * c_phi;
    const real_t c_theta_s_phi = c_theta * s_phi;
    const real_t c_phi2_minus_s_phi2 = (c_phi - s_phi) * (c_phi + s_phi);
    const real_t c_phi2_minus_c_theta2_s_phi2 = (c_phi - c_theta_s_phi) * (c_phi + c_theta_s_phi);
    const real_t k_minus_one_times_k_plus_one = (k - 1.0) * (k + 1.0);
    const real_t k_minus_two_times_k_plus_two = (k - 2.0) * (k + 2.0);
    const real_t two_k2_minus_one = 2.0 * k2 - 1.0;
    const real_t s_k2_factor_6_7 = 6.0 * k2 - 7.0;
    const real_t s_k2_factor_13_19 = 13.0 * k2 - 19.0;
    const real_t s_k2_factor_12_25 = 12.0 * k2 - 25.0;
    const real_t s_k2_minus_three = k2 - 3.0;

    /* S 波反射项 */
    memset(coeffs, 0, sizeof(*coeffs));
    coeffs->M[0][0][0].degree = 10;
    coeffs->M[0][0][0].time_degree = 3;
    coeffs->M[0][0][0].c[0][0] = c_phi2;
    coeffs->M[0][0][0].c[2][0] = -c_phi2_minus_s_phi2 / s_theta2;
    coeffs->M[0][0][0].c[1][1] = 2.0 * c_theta * c_phi2_minus_s_phi2 / s_theta2;
    coeffs->M[0][0][0].c[0][2] = -(16.0 * c_phi2 * k2 * s_theta2 - 8.0 * c_phi2 * s_theta2 + c_phi2 - c_theta2 * s_phi2 - s_theta2) / s_theta2;
    coeffs->M[0][0][0].c[2][2] = 8.0 * c_phi2_minus_s_phi2 * two_k2_minus_one / s_theta2;
    coeffs->M[0][0][0].c[1][3] = -16.0 * c_theta * c_phi2_minus_s_phi2 * two_k2_minus_one / s_theta2;
    coeffs->M[0][0][0].c[0][4] = 8.0 *
                                 (4.0 * c_phi2 * k2 * s_theta2 + 2.0 * c_phi2 * k2 - 3.0 * c_phi2 * s_theta2 - c_phi2 - 2.0 * c_theta2 * k2 * s_phi2 +
                                  c_theta2 * s_phi2 + 4.0 * k2 * s_phi2 * s_theta2 - 2.0 * k2 * s_theta2 - 4.0 * s_phi2 * s_theta2 + s_theta2) /
                                 s_theta2;
    coeffs->M[0][0][0].c[2][4] = -8.0 * c_phi2_minus_s_phi2 / s_theta2;
    coeffs->M[0][0][0].c[1][5] = 16.0 * c_theta * c_phi2_minus_s_phi2 / s_theta2;
    coeffs->M[0][0][0].c[0][6] =
        8.0 *
        (4.0 * c_phi2 * c_theta2 * k2 - 4.0 * c_phi2 * c_theta2 - 2.0 * c_phi2 * k2 * s_theta2 - 4.0 * c_phi2 * k2 + 2.0 * c_phi2 * s_theta2 +
         3.0 * c_phi2 + 4.0 * c_theta2 * k2 * s_phi2 - 3.0 * c_theta2 * s_phi2 - 4.0 * k2 * s_phi2 * s_theta2 - 4.0 * k2 * s_phi2 +
         4.0 * k2 * s_theta2 + 8.0 * s_phi2 * s_theta2 + 4.0 * s_phi2 - 3.0 * s_theta2) /
        s_theta2;
    coeffs->M[0][0][0].c[2][6] = -16.0 * c_phi2_minus_s_phi2 * s_k2_minus_three / s_theta2;
    coeffs->M[0][0][0].c[1][7] = 32.0 * c_theta * c_phi2_minus_s_phi2 * s_k2_minus_three / s_theta2;
    coeffs->M[0][0][0].c[0][8] = -16.0 *
                                 (2.0 * c_phi2 * c_theta2 * k2 - 4.0 * c_phi2 * c_theta2 - c_phi2 * k2 + c_phi2 + c_theta2 * k2 * s_phi2 -
                                  c_theta2 * s_phi2 - 2.0 * k2 * s_phi2 + k2 * s_theta2 + 2.0 * s_phi2 * s_theta2 + 4.0 * s_phi2 - s_theta2) /
                                 s_theta2;
    coeffs->M[0][0][0].c[2][8] = -32.0 * c_phi2_minus_s_phi2 / s_theta2;
    coeffs->M[0][0][0].c[1][9] = 64.0 * c_theta * c_phi2_minus_s_phi2 / s_theta2;
    coeffs->M[0][0][0].c[0][10] = -32.0 * (c_theta_c_phi - s_phi) * (c_theta_c_phi + s_phi) / s_theta2;
    coeffs->dM[0][0][0][0].degree = 11;
    coeffs->dM[0][0][0][0].time_degree = 3;
    coeffs->dM[0][0][0][0].c[1][0] = c_phi * (3.0 * c_phi2 - 2.0) / s_theta;
    coeffs->dM[0][0][0][0].c[3][0] = -c_phi * (3.0 * c_phi2 - s_phi2 - 2.0) / s_theta3;
    coeffs->dM[0][0][0][0].c[0][1] = -c_theta_c_phi * (3.0 * c_phi2 - 2.0) / s_theta;
    coeffs->dM[0][0][0][0].c[2][1] = 3.0 * c_theta_c_phi * (3.0 * c_phi2 - s_phi2 - 2.0) / s_theta3;
    coeffs->dM[0][0][0][0].c[1][2] = -c_phi *
                                     (6.0 * c_phi2 * c_theta2 + 48.0 * c_phi2 * k2 * s_theta2 - 24.0 * c_phi2 * s_theta2 + 3.0 * c_phi2 -
                                      3.0 * c_theta2 * s_phi2 - 4.0 * c_theta2 - 32.0 * k2 * s_theta2 + 15.0 * s_theta2 - 2.0) /
                                     s_theta3;
    coeffs->dM[0][0][0][0].c[3][2] = 8.0 * c_phi * two_k2_minus_one * (3.0 * c_phi2 - s_phi2 - 2.0) / s_theta3;
    coeffs->dM[0][0][0][0].c[0][3] =
        c_theta_c_phi *
        (48.0 * c_phi2 * k2 * s_theta2 - 24.0 * c_phi2 * s_theta2 + 3.0 * c_phi2 - c_theta2 * s_phi2 - 32.0 * k2 * s_theta2 + 15.0 * s_theta2 - 2.0) /
        s_theta3;
    coeffs->dM[0][0][0][0].c[2][3] = -24.0 * c_theta_c_phi * two_k2_minus_one * (3.0 * c_phi2 - s_phi2 - 2.0) / s_theta3;
    coeffs->dM[0][0][0][0].c[1][4] =
        8.0 * c_phi *
        (12.0 * c_phi2 * c_theta2 * k2 - 6.0 * c_phi2 * c_theta2 + 12.0 * c_phi2 * k2 * s_theta2 + 6.0 * c_phi2 * k2 - 9.0 * c_phi2 * s_theta2 -
         3.0 * c_phi2 - 6.0 * c_theta2 * k2 * s_phi2 - 8.0 * c_theta2 * k2 + 3.0 * c_theta2 * s_phi2 + 4.0 * c_theta2 +
         12.0 * k2 * s_phi2 * s_theta2 - 10.0 * k2 * s_theta2 - 4.0 * k2 - 12.0 * s_phi2 * s_theta2 + 7.0 * s_theta2 + 2.0) /
        s_theta3;
    coeffs->dM[0][0][0][0].c[3][4] = -8.0 * c_phi * (8.0 * c_phi2 * k2 - 5.0 * c_phi2 + 8.0 * k2 * s_phi2 - 8.0 * k2 - 9.0 * s_phi2 + 6.0) / s_theta3;
    coeffs->dM[0][0][0][0].c[0][5] =
        -8.0 * c_theta_c_phi *
        (12.0 * c_phi2 * k2 * s_theta2 + 6.0 * c_phi2 * k2 - 9.0 * c_phi2 * s_theta2 - 3.0 * c_phi2 - 2.0 * c_theta2 * k2 * s_phi2 +
         c_theta2 * s_phi2 + 12.0 * k2 * s_phi2 * s_theta2 - 10.0 * k2 * s_theta2 - 4.0 * k2 - 12.0 * s_phi2 * s_theta2 + 7.0 * s_theta2 + 2.0) /
        s_theta3;
    coeffs->dM[0][0][0][0].c[2][5] =
        24.0 * c_theta_c_phi * (8.0 * c_phi2 * k2 - 5.0 * c_phi2 + 8.0 * k2 * s_phi2 - 8.0 * k2 - 9.0 * s_phi2 + 6.0) / s_theta3;
    coeffs->dM[0][0][0][0].c[1][6] = -8.0 * c_phi *
                                     (12.0 * c_phi2 * c_theta2 * k2 - 6.0 * c_phi2 * c_theta2 + 6.0 * c_phi2 * k2 * s_theta2 + 12.0 * c_phi2 * k2 -
                                      6.0 * c_phi2 * s_theta2 - 9.0 * c_phi2 + 12.0 * c_theta2 * k2 * s_phi2 - 16.0 * c_theta2 * k2 -
                                      15.0 * c_theta2 * s_phi2 + 12.0 * c_theta2 + 12.0 * k2 * s_phi2 * s_theta2 + 12.0 * k2 * s_phi2 -
                                      8.0 * k2 * s_theta2 - 8.0 * k2 - 24.0 * s_phi2 * s_theta2 - 12.0 * s_phi2 + 7.0 * s_theta2 + 6.0) /
                                     s_theta3;
    coeffs->dM[0][0][0][0].c[3][6] = 16.0 * c_phi * (c_phi2 * k2 + c_phi2 + 5.0 * k2 * s_phi2 - 2.0 * k2 - 11.0 * s_phi2 + 2.0) / s_theta3;
    coeffs->dM[0][0][0][0].c[0][7] =
        -8.0 * c_theta_c_phi *
        (4.0 * c_phi2 * c_theta2 * k2 - 4.0 * c_phi2 * c_theta2 - 6.0 * c_phi2 * k2 * s_theta2 - 12.0 * c_phi2 * k2 + 6.0 * c_phi2 * s_theta2 +
         9.0 * c_phi2 + 4.0 * c_theta2 * k2 * s_phi2 - 3.0 * c_theta2 * s_phi2 - 12.0 * k2 * s_phi2 * s_theta2 - 12.0 * k2 * s_phi2 +
         8.0 * k2 * s_theta2 + 8.0 * k2 + 24.0 * s_phi2 * s_theta2 + 12.0 * s_phi2 - 7.0 * s_theta2 - 6.0) /
        s_theta3;
    coeffs->dM[0][0][0][0].c[2][7] = -48.0 * c_theta_c_phi * (c_phi2 * k2 + c_phi2 + 5.0 * k2 * s_phi2 - 2.0 * k2 - 11.0 * s_phi2 + 2.0) / s_theta3;
    coeffs->dM[0][0][0][0].c[1][8] =
        16.0 * c_phi *
        (6.0 * c_phi2 * c_theta2 + 3.0 * c_phi2 * k2 - 3.0 * c_phi2 + 9.0 * c_theta2 * k2 * s_phi2 - 4.0 * c_theta2 * k2 - 21.0 * c_theta2 * s_phi2 +
         4.0 * c_theta2 + 6.0 * k2 * s_phi2 - k2 * s_theta2 - 2.0 * k2 - 6.0 * s_phi2 * s_theta2 - 12.0 * s_phi2 + s_theta2 + 2.0) /
        s_theta3;
    coeffs->dM[0][0][0][0].c[3][8] = -32.0 * c_phi * (c_phi2 - 3.0 * s_phi2) / s_theta3;
    coeffs->dM[0][0][0][0].c[0][9] =
        16.0 * c_theta_c_phi *
        (2.0 * c_phi2 * c_theta2 * k2 - 4.0 * c_phi2 * c_theta2 - 3.0 * c_phi2 * k2 + 3.0 * c_phi2 + c_theta2 * k2 * s_phi2 - c_theta2 * s_phi2 -
         6.0 * k2 * s_phi2 + k2 * s_theta2 + 2.0 * k2 + 6.0 * s_phi2 * s_theta2 + 12.0 * s_phi2 - s_theta2 - 2.0) /
        s_theta3;
    coeffs->dM[0][0][0][0].c[2][9] = 96.0 * c_theta_c_phi * (c_phi2 - 3.0 * s_phi2) / s_theta3;
    coeffs->dM[0][0][0][0].c[1][10] = -96.0 * c_phi * (c_phi2 * c_theta2 - 2.0 * c_theta2 * s_phi2 - s_phi2) / s_theta3;
    coeffs->dM[0][0][0][0].c[0][11] = 32.0 * c_theta_c_phi * (c_phi2 * c_theta2 - 3.0 * s_phi2) / s_theta3;
    coeffs->dM[1][0][0][0].degree = 11;
    coeffs->dM[1][0][0][0].time_degree = 3;
    coeffs->dM[1][0][0][0].c[1][0] = 3.0 * c_phi2 * s_phi / s_theta;
    coeffs->dM[1][0][0][0].c[3][0] = -s_phi * (3.0 * c_phi2 - s_phi2) / s_theta3;
    coeffs->dM[1][0][0][0].c[0][1] = -3.0 * c_phi2 * c_theta_s_phi / s_theta;
    coeffs->dM[1][0][0][0].c[2][1] = 3.0 * c_theta_s_phi * (3.0 * c_phi2 - s_phi2) / s_theta3;
    coeffs->dM[1][0][0][0].c[1][2] =
        -s_phi *
        (6.0 * c_phi2 * c_theta2 + 48.0 * c_phi2 * k2 * s_theta2 - 24.0 * c_phi2 * s_theta2 + 3.0 * c_phi2 - 3.0 * c_theta2 * s_phi2 - s_theta2) /
        s_theta3;
    coeffs->dM[1][0][0][0].c[3][2] = 8.0 * s_phi * (3.0 * c_phi2 - s_phi2) * two_k2_minus_one / s_theta3;
    coeffs->dM[1][0][0][0].c[0][3] =
        c_theta_s_phi * (48.0 * c_phi2 * k2 * s_theta2 - 24.0 * c_phi2 * s_theta2 + 3.0 * c_phi2 - c_theta2 * s_phi2 - s_theta2) / s_theta3;
    coeffs->dM[1][0][0][0].c[2][3] = -24.0 * c_theta_s_phi * (3.0 * c_phi2 - s_phi2) * two_k2_minus_one / s_theta3;
    coeffs->dM[1][0][0][0].c[1][4] = 8.0 * s_phi *
                                     (12.0 * c_phi2 * c_theta2 * k2 - 6.0 * c_phi2 * c_theta2 + 12.0 * c_phi2 * k2 * s_theta2 + 6.0 * c_phi2 * k2 -
                                      9.0 * c_phi2 * s_theta2 - 3.0 * c_phi2 - 6.0 * c_theta2 * k2 * s_phi2 + 3.0 * c_theta2 * s_phi2 +
                                      12.0 * k2 * s_phi2 * s_theta2 - 10.0 * k2 * s_theta2 - 12.0 * s_phi2 * s_theta2 + 9.0 * s_theta2) /
                                     s_theta3;
    coeffs->dM[1][0][0][0].c[3][4] = -8.0 * s_phi * (8.0 * c_phi2 * k2 - 5.0 * c_phi2 + 8.0 * k2 * s_phi2 - 8.0 * k2 - 9.0 * s_phi2 + 8.0) / s_theta3;
    coeffs->dM[1][0][0][0].c[0][5] =
        -8.0 * c_theta_s_phi *
        (12.0 * c_phi2 * k2 * s_theta2 + 6.0 * c_phi2 * k2 - 9.0 * c_phi2 * s_theta2 - 3.0 * c_phi2 - 2.0 * c_theta2 * k2 * s_phi2 +
         c_theta2 * s_phi2 + 12.0 * k2 * s_phi2 * s_theta2 - 10.0 * k2 * s_theta2 - 12.0 * s_phi2 * s_theta2 + 9.0 * s_theta2) /
        s_theta3;
    coeffs->dM[1][0][0][0].c[2][5] =
        24.0 * c_theta_s_phi * (8.0 * c_phi2 * k2 - 5.0 * c_phi2 + 8.0 * k2 * s_phi2 - 8.0 * k2 - 9.0 * s_phi2 + 8.0) / s_theta3;
    coeffs->dM[1][0][0][0].c[1][6] = -8.0 * s_phi *
                                     (12.0 * c_phi2 * c_theta2 * k2 - 6.0 * c_phi2 * c_theta2 + 6.0 * c_phi2 * k2 * s_theta2 + 12.0 * c_phi2 * k2 -
                                      6.0 * c_phi2 * s_theta2 - 9.0 * c_phi2 + 12.0 * c_theta2 * k2 * s_phi2 - 16.0 * c_theta2 * k2 -
                                      15.0 * c_theta2 * s_phi2 + 16.0 * c_theta2 + 12.0 * k2 * s_phi2 * s_theta2 + 12.0 * k2 * s_phi2 -
                                      12.0 * k2 * s_theta2 - 8.0 * k2 - 24.0 * s_phi2 * s_theta2 - 12.0 * s_phi2 + 19.0 * s_theta2 + 8.0) /
                                     s_theta3;
    coeffs->dM[1][0][0][0].c[3][6] = 16.0 * s_phi * (c_phi2 * k2 + c_phi2 + 5.0 * k2 * s_phi2 - 4.0 * k2 - 11.0 * s_phi2 + 8.0) / s_theta3;
    coeffs->dM[1][0][0][0].c[0][7] =
        -8.0 * c_theta_s_phi *
        (4.0 * c_phi2 * c_theta2 * k2 - 4.0 * c_phi2 * c_theta2 - 6.0 * c_phi2 * k2 * s_theta2 - 12.0 * c_phi2 * k2 + 6.0 * c_phi2 * s_theta2 +
         9.0 * c_phi2 + 4.0 * c_theta2 * k2 * s_phi2 - 3.0 * c_theta2 * s_phi2 - 12.0 * k2 * s_phi2 * s_theta2 - 12.0 * k2 * s_phi2 +
         12.0 * k2 * s_theta2 + 8.0 * k2 + 24.0 * s_phi2 * s_theta2 + 12.0 * s_phi2 - 19.0 * s_theta2 - 8.0) /
        s_theta3;
    coeffs->dM[1][0][0][0].c[2][7] = -48.0 * c_theta_s_phi * (c_phi2 * k2 + c_phi2 + 5.0 * k2 * s_phi2 - 4.0 * k2 - 11.0 * s_phi2 + 8.0) / s_theta3;
    coeffs->dM[1][0][0][0].c[1][8] =
        16.0 * s_phi *
        (6.0 * c_phi2 * c_theta2 + 3.0 * c_phi2 * k2 - 3.0 * c_phi2 + 9.0 * c_theta2 * k2 * s_phi2 - 8.0 * c_theta2 * k2 - 21.0 * c_theta2 * s_phi2 +
         16.0 * c_theta2 + 6.0 * k2 * s_phi2 - k2 * s_theta2 - 4.0 * k2 - 6.0 * s_phi2 * s_theta2 - 12.0 * s_phi2 + 5.0 * s_theta2 + 8.0) /
        s_theta3;
    coeffs->dM[1][0][0][0].c[3][8] = -32.0 * s_phi * (c_phi2 - 3.0 * s_phi2 + 2.0) / s_theta3;
    coeffs->dM[1][0][0][0].c[0][9] =
        16.0 * c_theta_s_phi *
        (2.0 * c_phi2 * c_theta2 * k2 - 4.0 * c_phi2 * c_theta2 - 3.0 * c_phi2 * k2 + 3.0 * c_phi2 + c_theta2 * k2 * s_phi2 - c_theta2 * s_phi2 -
         6.0 * k2 * s_phi2 + k2 * s_theta2 + 4.0 * k2 + 6.0 * s_phi2 * s_theta2 + 12.0 * s_phi2 - 5.0 * s_theta2 - 8.0) /
        s_theta3;
    coeffs->dM[1][0][0][0].c[2][9] = 96.0 * c_theta_s_phi * (c_phi2 - 3.0 * s_phi2 + 2.0) / s_theta3;
    coeffs->dM[1][0][0][0].c[1][10] =
        -32.0 * s_phi * (3.0 * c_phi2 * c_theta2 - 6.0 * c_theta2 * s_phi2 + 4.0 * c_theta2 - 3.0 * s_phi2 + 2.0) / s_theta3;
