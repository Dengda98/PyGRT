        k_prime_square;
    coeffs->dM[0][2][2].c[2][2] = -4.0 * c_phi * time_scale2 * z_minus * (kappa_1_sq - kappa_2);
    coeffs->dM[0][2][2].c[1][3] = 2.0 * c_phi * kappa_1 * time_scale * (4.0 * k_prime_square * kappa_2 - 3.0 * k_prime_square + 2.0) / k_prime_square;
    coeffs->dM[0][2][2].c[3][3] = 8.0 * c_phi * kappa_1 * time_scale3 * (kappa_1_sq - kappa_2);
    coeffs->dM[0][2][2].c[0][4] = -c_phi *
                                  (4.0 * k_prime_square * kappa_2 * z_minus + 4.0 * k_prime_square * kappa_2 * z_plus - k_prime_square * z_minus -
                                   3.0 * k_prime_square * z_plus - 8.0 * kappa_2 * z_minus + 2.0 * z_minus + 2.0 * z_plus) /
                                  k_prime_square;
    coeffs->dM[0][2][2].c[2][4] =
        -4.0 * c_phi * time_scale2 * (kappa_1_sq - kappa_2) * (k_prime_square * z_minus + k_prime_square * z_plus - 2.0 * z_minus) / k_prime_square;
    coeffs->dM[0][2][2].c[1][5] = 2.0 * c_phi * kappa_1 * time_scale * (k_prime_square - 2.0) * (4.0 * kappa_2 - 1.0) / k_prime_square;
    coeffs->dM[0][2][2].c[3][5] = 8.0 * c_phi * kappa_1 * time_scale3 * (k_prime_square - 2.0) * (kappa_1_sq - kappa_2) / k_prime_square;
    coeffs->dM[0][2][2].c[0][6] =
        c_phi *
        (8.0 * k_prime_square * kappa_2 * z_minus - 4.0 * k_prime_square * kappa_2 * z_plus - 5.0 * k_prime_square * z_minus +
         k_prime_square * z_plus - 8.0 * kappa_2 * z_minus + 8.0 * kappa_2 * z_plus + 4.0 * z_minus - 2.0 * z_plus) /
        k_prime_square;
    coeffs->dM[0][2][2].c[2][6] = 4.0 * c_phi * time_scale2 * (kappa_1_sq - kappa_2) *
                                  (2.0 * k_prime_square * z_minus - k_prime_square * z_plus - 2.0 * z_minus + 2.0 * z_plus) / k_prime_square;
    coeffs->dM[0][2][2].c[1][7] =
        -2.0 * c_phi * kappa_1 * time_scale * (8.0 * k_prime_square * kappa_2 - 5.0 * k_prime_square - 8.0 * kappa_2 + 4.0) / k_prime_square;
    coeffs->dM[0][2][2].c[3][7] = -16.0 * c_phi * kappa_1 * time_scale3 * k_prime_minus_one_times_plus_one * (kappa_1_sq - kappa_2) / k_prime_square;
    coeffs->dM[0][2][2].c[0][8] =
        c_phi * (z_minus + z_plus) * (8.0 * k_prime_square * kappa_2 - 5.0 * k_prime_square - 8.0 * kappa_2 + 4.0) / k_prime_square;
    coeffs->dM[0][2][2].c[2][8] =
        8.0 * c_phi * time_scale2 * k_prime_minus_one_times_plus_one * (kappa_1_sq - kappa_2) * (z_minus + z_plus) / k_prime_square;
    coeffs->dM[0][2][2].c[1][9] =
        -2.0 * c_phi * kappa_1 * time_scale * (8.0 * k_prime_square * kappa_2 - 5.0 * k_prime_square - 8.0 * kappa_2 + 4.0) / k_prime_square;
    coeffs->dM[0][2][2].c[3][9] = -16.0 * c_phi * kappa_1 * time_scale3 * k_prime_minus_one_times_plus_one * (kappa_1_sq - kappa_2) / k_prime_square;
    coeffs->dM[0][2][2].c[0][10] = -c_phi *
                                   (4.0 * k_prime_square * kappa_2 * z_minus - 8.0 * k_prime_square * kappa_2 * z_plus - k_prime_square * z_minus +
                                    5.0 * k_prime_square * z_plus - 8.0 * kappa_2 * z_minus + 8.0 * kappa_2 * z_plus + 2.0 * z_minus - 4.0 * z_plus) /
                                   k_prime_square;
    coeffs->dM[0][2][2].c[2][10] = -4.0 * c_phi * time_scale2 * (kappa_1_sq - kappa_2) *
                                   (k_prime_square * z_minus - 2.0 * k_prime_square * z_plus - 2.0 * z_minus + 2.0 * z_plus) / k_prime_square;
    coeffs->dM[0][2][2].c[1][11] = 2.0 * c_phi * kappa_1 * time_scale * (k_prime_square - 2.0) * (4.0 * kappa_2 - 1.0) / k_prime_square;
    coeffs->dM[0][2][2].c[3][11] = 8.0 * c_phi * kappa_1 * time_scale3 * (k_prime_square - 2.0) * (kappa_1_sq - kappa_2) / k_prime_square;
    coeffs->dM[0][2][2].c[0][12] =
        -c_phi *
        (4.0 * k_prime_square * kappa_2 * z_minus + 4.0 * k_prime_square * kappa_2 * z_plus - 3.0 * k_prime_square * z_minus -
         k_prime_square * z_plus - 8.0 * kappa_2 * z_plus + 2.0 * z_minus + 2.0 * z_plus) /
        k_prime_square;
    coeffs->dM[0][2][2].c[2][12] =
        -4.0 * c_phi * time_scale2 * (kappa_1_sq - kappa_2) * (k_prime_square * z_minus + k_prime_square * z_plus - 2.0 * z_plus) / k_prime_square;
    coeffs->dM[0][2][2].c[1][13] =
        2.0 * c_phi * kappa_1 * time_scale * (4.0 * k_prime_square * kappa_2 - 3.0 * k_prime_square + 2.0) / k_prime_square;
    coeffs->dM[0][2][2].c[3][13] = 8.0 * c_phi * kappa_1 * time_scale3 * (kappa_1_sq - kappa_2);
    coeffs->dM[0][2][2].c[0][14] =
        -c_phi * (4.0 * k_prime_square * kappa_2 * z_plus - k_prime_square * z_minus - 3.0 * k_prime_square * z_plus + 2.0 * z_plus) / k_prime_square;
    coeffs->dM[0][2][2].c[2][14] = -4.0 * c_phi * time_scale2 * z_plus * (kappa_1_sq - kappa_2);
    coeffs->dM[0][2][2].c[1][15] = -2.0 * c_phi * kappa_1 * time_scale;
    coeffs->dM[0][2][2].c[0][16] = c_phi * z_plus;
    coeffs->dM[1][2][2].degree = 16;
    coeffs->dM[1][2][2].time_degree = 4;
    coeffs->dM[1][2][2].c[0][0] = s_phi * z_minus;
    coeffs->dM[1][2][2].c[1][1] = -2.0 * kappa_1 * s_phi * time_scale;
    coeffs->dM[1][2][2].c[0][2] =
        -s_phi * (4.0 * k_prime_square * kappa_2 * z_minus - 3.0 * k_prime_square * z_minus - k_prime_square * z_plus + 2.0 * z_minus) /
        k_prime_square;
    coeffs->dM[1][2][2].c[2][2] = -4.0 * s_phi * time_scale2 * z_minus * (kappa_1_sq - kappa_2);
    coeffs->dM[1][2][2].c[1][3] = 2.0 * kappa_1 * s_phi * time_scale * (4.0 * k_prime_square * kappa_2 - 3.0 * k_prime_square + 2.0) / k_prime_square;
    coeffs->dM[1][2][2].c[3][3] = 8.0 * kappa_1 * s_phi * time_scale3 * (kappa_1_sq - kappa_2);
    coeffs->dM[1][2][2].c[0][4] = -s_phi *
                                  (4.0 * k_prime_square * kappa_2 * z_minus + 4.0 * k_prime_square * kappa_2 * z_plus - k_prime_square * z_minus -
                                   3.0 * k_prime_square * z_plus - 8.0 * kappa_2 * z_minus + 2.0 * z_minus + 2.0 * z_plus) /
                                  k_prime_square;
    coeffs->dM[1][2][2].c[2][4] =
        -4.0 * s_phi * time_scale2 * (kappa_1_sq - kappa_2) * (k_prime_square * z_minus + k_prime_square * z_plus - 2.0 * z_minus) / k_prime_square;
    coeffs->dM[1][2][2].c[1][5] = 2.0 * kappa_1 * s_phi * time_scale * (k_prime_square - 2.0) * (4.0 * kappa_2 - 1.0) / k_prime_square;
    coeffs->dM[1][2][2].c[3][5] = 8.0 * kappa_1 * s_phi * time_scale3 * (k_prime_square - 2.0) * (kappa_1_sq - kappa_2) / k_prime_square;
    coeffs->dM[1][2][2].c[0][6] =
        s_phi *
        (8.0 * k_prime_square * kappa_2 * z_minus - 4.0 * k_prime_square * kappa_2 * z_plus - 5.0 * k_prime_square * z_minus +
         k_prime_square * z_plus - 8.0 * kappa_2 * z_minus + 8.0 * kappa_2 * z_plus + 4.0 * z_minus - 2.0 * z_plus) /
        k_prime_square;
    coeffs->dM[1][2][2].c[2][6] = 4.0 * s_phi * time_scale2 * (kappa_1_sq - kappa_2) *
                                  (2.0 * k_prime_square * z_minus - k_prime_square * z_plus - 2.0 * z_minus + 2.0 * z_plus) / k_prime_square;
    coeffs->dM[1][2][2].c[1][7] =
        -2.0 * kappa_1 * s_phi * time_scale * (8.0 * k_prime_square * kappa_2 - 5.0 * k_prime_square - 8.0 * kappa_2 + 4.0) / k_prime_square;
    coeffs->dM[1][2][2].c[3][7] = -16.0 * kappa_1 * s_phi * time_scale3 * k_prime_minus_one_times_plus_one * (kappa_1_sq - kappa_2) / k_prime_square;
    coeffs->dM[1][2][2].c[0][8] =
        s_phi * (z_minus + z_plus) * (8.0 * k_prime_square * kappa_2 - 5.0 * k_prime_square - 8.0 * kappa_2 + 4.0) / k_prime_square;
    coeffs->dM[1][2][2].c[2][8] =
        8.0 * s_phi * time_scale2 * k_prime_minus_one_times_plus_one * (kappa_1_sq - kappa_2) * (z_minus + z_plus) / k_prime_square;
    coeffs->dM[1][2][2].c[1][9] =
        -2.0 * kappa_1 * s_phi * time_scale * (8.0 * k_prime_square * kappa_2 - 5.0 * k_prime_square - 8.0 * kappa_2 + 4.0) / k_prime_square;
    coeffs->dM[1][2][2].c[3][9] = -16.0 * kappa_1 * s_phi * time_scale3 * k_prime_minus_one_times_plus_one * (kappa_1_sq - kappa_2) / k_prime_square;
    coeffs->dM[1][2][2].c[0][10] = -s_phi *
                                   (4.0 * k_prime_square * kappa_2 * z_minus - 8.0 * k_prime_square * kappa_2 * z_plus - k_prime_square * z_minus +
                                    5.0 * k_prime_square * z_plus - 8.0 * kappa_2 * z_minus + 8.0 * kappa_2 * z_plus + 2.0 * z_minus - 4.0 * z_plus) /
                                   k_prime_square;
    coeffs->dM[1][2][2].c[2][10] = -4.0 * s_phi * time_scale2 * (kappa_1_sq - kappa_2) *
                                   (k_prime_square * z_minus - 2.0 * k_prime_square * z_plus - 2.0 * z_minus + 2.0 * z_plus) / k_prime_square;
    coeffs->dM[1][2][2].c[1][11] = 2.0 * kappa_1 * s_phi * time_scale * (k_prime_square - 2.0) * (4.0 * kappa_2 - 1.0) / k_prime_square;
    coeffs->dM[1][2][2].c[3][11] = 8.0 * kappa_1 * s_phi * time_scale3 * (k_prime_square - 2.0) * (kappa_1_sq - kappa_2) / k_prime_square;
    coeffs->dM[1][2][2].c[0][12] =
        -s_phi *
        (4.0 * k_prime_square * kappa_2 * z_minus + 4.0 * k_prime_square * kappa_2 * z_plus - 3.0 * k_prime_square * z_minus -
         k_prime_square * z_plus - 8.0 * kappa_2 * z_plus + 2.0 * z_minus + 2.0 * z_plus) /
        k_prime_square;
    coeffs->dM[1][2][2].c[2][12] =
        -4.0 * s_phi * time_scale2 * (kappa_1_sq - kappa_2) * (k_prime_square * z_minus + k_prime_square * z_plus - 2.0 * z_plus) / k_prime_square;
    coeffs->dM[1][2][2].c[1][13] =
        2.0 * kappa_1 * s_phi * time_scale * (4.0 * k_prime_square * kappa_2 - 3.0 * k_prime_square + 2.0) / k_prime_square;
    coeffs->dM[1][2][2].c[3][13] = 8.0 * kappa_1 * s_phi * time_scale3 * (kappa_1_sq - kappa_2);
    coeffs->dM[1][2][2].c[0][14] =
        -s_phi * (4.0 * k_prime_square * kappa_2 * z_plus - k_prime_square * z_minus - 3.0 * k_prime_square * z_plus + 2.0 * z_plus) / k_prime_square;
    coeffs->dM[1][2][2].c[2][14] = -4.0 * s_phi * time_scale2 * z_plus * (kappa_1_sq - kappa_2);
    coeffs->dM[1][2][2].c[1][15] = -2.0 * kappa_1 * s_phi * time_scale;
    coeffs->dM[1][2][2].c[0][16] = s_phi * z_plus;

    if (make_vertical) {
        for (int i = 0; i < 3; ++i) {
            for (int j = 0; j < 3; ++j) {
                make_lamb3_vertical_source_derivative(&coeffs->M[i][j], 1, &coeffs->dM[2][i][j]);
            }
        }
    }
}

static void make_lamb3_SP_coefficients(const LAMB3_VARS *V, LAMB3_CONVERSION_COEFF_SET *coeffs) {
    /* SP 只需将 PS 的 z_- 取反，再按式 (8.1.6g)-(8.1.6h) 置换分量 */
    make_lamb3_PS_coefficients(V, -1.0, 0, coeffs);
    transform_lamb3_conversion_matrix(coeffs->M);
    for (int k = 0; k < 2; ++k) {
        transform_lamb3_conversion_matrix(coeffs->dM[k]);
    }
    for (int i = 0; i < 3; ++i) {
        for (int j = 0; j < 3; ++j) {
            /* SP 的 M_,3' = -(x^2+1) M */
            make_lamb3_vertical_source_derivative(&coeffs->M[i][j], -1, &coeffs->dM[2][i][j]);
        }
    }
}
