    coeffs->M[1][2][1].c[1][8] = -32.0 * s_phi * s_k2_minus_three / s_theta;
    coeffs->M[1][2][1].c[0][9] = 32.0 * c_theta_s_phi * s_k2_minus_three / s_theta;
    coeffs->M[1][2][1].c[1][10] = -32.0 * s_phi / s_theta;
    coeffs->M[1][2][1].c[0][11] = 32.0 * c_theta_s_phi / s_theta;
    coeffs->dM[0][1][2][1].degree = 12;
    coeffs->dM[0][1][2][1].time_degree = 3;
    coeffs->dM[0][1][2][1].c[0][2] = -8.0 * c_phi_s_phi * k_minus_one_times_k_plus_one;
    coeffs->dM[0][1][2][1].c[2][2] = 16.0 * c_phi_s_phi * k_minus_one_times_k_plus_one / s_theta2;
    coeffs->dM[0][1][2][1].c[1][3] = -32.0 * c_theta_c_phi * s_phi * k_minus_one_times_k_plus_one / s_theta2;
    coeffs->dM[0][1][2][1].c[0][4] = 8.0 * c_phi_s_phi * (c_theta2 * k2 - c_theta2 + 5.0 * k2 * s_theta2 + k2 - 6.0 * s_theta2 - 1.0) / s_theta2;
    coeffs->dM[0][1][2][1].c[2][4] = -16.0 * c_phi_s_phi * (5.0 * k2 - 6.0) / s_theta2;
    coeffs->dM[0][1][2][1].c[1][5] = 32.0 * c_theta_c_phi * s_phi * (5.0 * k2 - 6.0) / s_theta2;
    coeffs->dM[0][1][2][1].c[0][6] =
        -8.0 * c_phi_s_phi * (5.0 * c_theta2 * k2 - 6.0 * c_theta2 + 8.0 * k2 * s_theta2 + 5.0 * k2 - 13.0 * s_theta2 - 6.0) / s_theta2;
    coeffs->dM[0][1][2][1].c[2][6] = 16.0 * c_phi_s_phi * (8.0 * k2 - 13.0) / s_theta2;
    coeffs->dM[0][1][2][1].c[1][7] = -32.0 * c_theta_c_phi * s_phi * (8.0 * k2 - 13.0) / s_theta2;
    coeffs->dM[0][1][2][1].c[0][8] =
        8.0 * c_phi_s_phi * (8.0 * c_theta2 * k2 - 13.0 * c_theta2 + 4.0 * k2 * s_theta2 + 8.0 * k2 - 12.0 * s_theta2 - 13.0) / s_theta2;
    coeffs->dM[0][1][2][1].c[2][8] = -64.0 * c_phi_s_phi * s_k2_minus_three / s_theta2;
    coeffs->dM[0][1][2][1].c[1][9] = 128.0 * c_theta_c_phi * s_phi * s_k2_minus_three / s_theta2;
    coeffs->dM[0][1][2][1].c[0][10] = -32.0 * c_phi_s_phi * (c_theta2 * k2 - 3.0 * c_theta2 + k2 - s_theta2 - 3.0) / s_theta2;
    coeffs->dM[0][1][2][1].c[2][10] = -64.0 * c_phi_s_phi / s_theta2;
    coeffs->dM[0][1][2][1].c[1][11] = 128.0 * c_theta_c_phi * s_phi / s_theta2;
    coeffs->dM[0][1][2][1].c[0][12] = -32.0 * c_phi_s_phi * (c_theta2 + 1.0) / s_theta2;
    coeffs->dM[1][1][2][1].degree = 12;
    coeffs->dM[1][1][2][1].time_degree = 3;
    coeffs->dM[1][1][2][1].c[0][2] = 8.0 * c_phi2 * k_minus_one_times_k_plus_one;
    coeffs->dM[1][1][2][1].c[2][2] = -8.0 * c_phi2_minus_s_phi2 * k_minus_one_times_k_plus_one / s_theta2;
    coeffs->dM[1][1][2][1].c[1][3] = 16.0 * c_theta * c_phi2_minus_s_phi2 * k_minus_one_times_k_plus_one / s_theta2;
    coeffs->dM[1][1][2][1].c[0][4] =
        -8.0 * (5.0 * c_phi2 * k2 * s_theta2 + c_phi2 * k2 - 6.0 * c_phi2 * s_theta2 - c_phi2 - c_theta2 * k2 * s_phi2 + c_theta2 * s_phi2) /
        s_theta2;
    coeffs->dM[1][1][2][1].c[2][4] = 8.0 * c_phi2_minus_s_phi2 * (5.0 * k2 - 6.0) / s_theta2;
    coeffs->dM[1][1][2][1].c[1][5] = -16.0 * c_theta * c_phi2_minus_s_phi2 * (5.0 * k2 - 6.0) / s_theta2;
    coeffs->dM[1][1][2][1].c[0][6] = 8.0 *
                                     (8.0 * c_phi2 * k2 * s_theta2 + 5.0 * c_phi2 * k2 - 13.0 * c_phi2 * s_theta2 - 6.0 * c_phi2 -
                                      5.0 * c_theta2 * k2 * s_phi2 + 6.0 * c_theta2 * s_phi2) /
                                     s_theta2;
    coeffs->dM[1][1][2][1].c[2][6] = -8.0 * c_phi2_minus_s_phi2 * (8.0 * k2 - 13.0) / s_theta2;
    coeffs->dM[1][1][2][1].c[1][7] = 16.0 * c_theta * c_phi2_minus_s_phi2 * (8.0 * k2 - 13.0) / s_theta2;
    coeffs->dM[1][1][2][1].c[0][8] = -8.0 *
                                     (4.0 * c_phi2 * k2 * s_theta2 + 8.0 * c_phi2 * k2 - 12.0 * c_phi2 * s_theta2 - 13.0 * c_phi2 -
                                      8.0 * c_theta2 * k2 * s_phi2 + 13.0 * c_theta2 * s_phi2) /
                                     s_theta2;
    coeffs->dM[1][1][2][1].c[2][8] = 32.0 * c_phi2_minus_s_phi2 * s_k2_minus_three / s_theta2;
    coeffs->dM[1][1][2][1].c[1][9] = -64.0 * c_theta * c_phi2_minus_s_phi2 * s_k2_minus_three / s_theta2;
    coeffs->dM[1][1][2][1].c[0][10] =
        32.0 * (c_phi2 * k2 - c_phi2 * s_theta2 - 3.0 * c_phi2 - c_theta2 * k2 * s_phi2 + 3.0 * c_theta2 * s_phi2) / s_theta2;
    coeffs->dM[1][1][2][1].c[2][10] = 32.0 * c_phi2_minus_s_phi2 / s_theta2;
    coeffs->dM[1][1][2][1].c[1][11] = -64.0 * c_theta * c_phi2_minus_s_phi2 / s_theta2;
    coeffs->dM[1][1][2][1].c[0][12] = 32.0 * c_phi2_minus_c_theta2_s_phi2 / s_theta2;
    coeffs->M[1][2][2].degree = 11;
    coeffs->M[1][2][2].time_degree = 3;
    coeffs->M[1][2][2].c[0][1] = 8.0 * k_minus_one_times_k_plus_one;
    coeffs->M[1][2][2].c[0][3] = -8.0 * s_k2_factor_6_7;
    coeffs->M[1][2][2].c[0][5] = 8.0 * s_k2_factor_13_19;
    coeffs->M[1][2][2].c[0][7] = -8.0 * s_k2_factor_12_25;
    coeffs->M[1][2][2].c[0][9] = 32.0 * k_minus_two_times_k_plus_two;
    coeffs->M[1][2][2].c[0][11] = 32.0;
    coeffs->dM[0][1][2][2].degree = 12;
    coeffs->dM[0][1][2][2].time_degree = 3;
    coeffs->dM[0][1][2][2].c[1][1] = 8.0 * c_phi * k_minus_one_times_k_plus_one / s_theta;
    coeffs->dM[0][1][2][2].c[0][2] = -8.0 * c_theta_c_phi * k_minus_one_times_k_plus_one / s_theta;
    coeffs->dM[0][1][2][2].c[1][3] = -8.0 * c_phi * s_k2_factor_6_7 / s_theta;
    coeffs->dM[0][1][2][2].c[0][4] = 8.0 * c_theta_c_phi * s_k2_factor_6_7 / s_theta;
    coeffs->dM[0][1][2][2].c[1][5] = 8.0 * c_phi * s_k2_factor_13_19 / s_theta;
    coeffs->dM[0][1][2][2].c[0][6] = -8.0 * c_theta_c_phi * s_k2_factor_13_19 / s_theta;
    coeffs->dM[0][1][2][2].c[1][7] = -8.0 * c_phi * s_k2_factor_12_25 / s_theta;
    coeffs->dM[0][1][2][2].c[0][8] = 8.0 * c_theta_c_phi * s_k2_factor_12_25 / s_theta;
    coeffs->dM[0][1][2][2].c[1][9] = 32.0 * c_phi * k_minus_two_times_k_plus_two / s_theta;
    coeffs->dM[0][1][2][2].c[0][10] = -32.0 * c_theta_c_phi * k_minus_two_times_k_plus_two / s_theta;
    coeffs->dM[0][1][2][2].c[1][11] = 32.0 * c_phi / s_theta;
    coeffs->dM[0][1][2][2].c[0][12] = -32.0 * c_theta_c_phi / s_theta;
    coeffs->dM[1][1][2][2].degree = 12;
    coeffs->dM[1][1][2][2].time_degree = 3;
    coeffs->dM[1][1][2][2].c[1][1] = 8.0 * s_phi * k_minus_one_times_k_plus_one / s_theta;
    coeffs->dM[1][1][2][2].c[0][2] = -8.0 * c_theta_s_phi * k_minus_one_times_k_plus_one / s_theta;
    coeffs->dM[1][1][2][2].c[1][3] = -8.0 * s_phi * s_k2_factor_6_7 / s_theta;
    coeffs->dM[1][1][2][2].c[0][4] = 8.0 * c_theta_s_phi * s_k2_factor_6_7 / s_theta;
    coeffs->dM[1][1][2][2].c[1][5] = 8.0 * s_phi * s_k2_factor_13_19 / s_theta;
    coeffs->dM[1][1][2][2].c[0][6] = -8.0 * c_theta_s_phi * s_k2_factor_13_19 / s_theta;
    coeffs->dM[1][1][2][2].c[1][7] = -8.0 * s_phi * s_k2_factor_12_25 / s_theta;
    coeffs->dM[1][1][2][2].c[0][8] = 8.0 * c_theta_s_phi * s_k2_factor_12_25 / s_theta;
    coeffs->dM[1][1][2][2].c[1][9] = 32.0 * s_phi * k_minus_two_times_k_plus_two / s_theta;
    coeffs->dM[1][1][2][2].c[0][10] = -32.0 * c_theta_s_phi * k_minus_two_times_k_plus_two / s_theta;
    coeffs->dM[1][1][2][2].c[1][11] = 32.0 * s_phi / s_theta;
    coeffs->dM[1][1][2][2].c[0][12] = -32.0 * c_theta_s_phi / s_theta;
}

static void make_lamb3_vertical_source_derivative(const LAMB3_POLY_COEFF *base, const int constant_sign,
                                                        LAMB3_POLY_COEFF *result) {
    memset(result, 0, sizeof(*result));
    result->degree = base->degree + 2;
    result->time_degree = base->time_degree;
    for (int r = 0; r <= base->time_degree; ++r) {
        for (int m = 0; m <= base->degree; ++m) {
            result->c[r][m] += constant_sign * base->c[r][m];
            result->c[r][m + 2] -= base->c[r][m];
        }
    }
}

static void copy_lamb3_poly_with_sign(const LAMB3_POLY_COEFF *source, const int sign, LAMB3_POLY_COEFF *target) {
    *target = *source;
    if (sign < 0) {
        for (int r = 0; r <= target->time_degree; ++r) {
            for (int m = 0; m <= target->degree; ++m) {
                target->c[r][m] = -target->c[r][m];
            }
        }
    }
}

/** 按式 (8.1.6g)-(8.1.6h) 将 PS 分子变换为 SP 分子 */
static void transform_lamb3_conversion_matrix(LAMB3_POLY_COEFF matrix[3][3]) {
    LAMB3_POLY_COEFF source[3][3];
    memcpy(source, matrix, sizeof(source));
    copy_lamb3_poly_with_sign(&source[0][0], 1, &matrix[0][0]);
    copy_lamb3_poly_with_sign(&source[0][1], 1, &matrix[0][1]);
    copy_lamb3_poly_with_sign(&source[2][0], -1, &matrix[0][2]);
    copy_lamb3_poly_with_sign(&source[1][0], 1, &matrix[1][0]);
    copy_lamb3_poly_with_sign(&source[1][1], 1, &matrix[1][1]);
    copy_lamb3_poly_with_sign(&source[2][1], -1, &matrix[1][2]);
    copy_lamb3_poly_with_sign(&source[0][2], -1, &matrix[2][0]);
    copy_lamb3_poly_with_sign(&source[1][2], -1, &matrix[2][1]);
    copy_lamb3_poly_with_sign(&source[2][2], 1, &matrix[2][2]);
}

static void make_lamb3_PS_coefficients(const LAMB3_VARS *V, const real_t z_minus_sign, const int make_vertical, LAMB3_CONVERSION_COEFF_SET *coeffs) {
    const real_t z_plus = (V->source_depth + V->receiver_depth) / V->R;
    const real_t z_minus = z_minus_sign * (V->receiver_depth - V->source_depth) / V->R;
    const real_t time_scale = V->r / V->R;
    const real_t k_prime = V->kp;
    const real_t k_prime2 = V->kp2;
    const real_t k_prime_square = k_prime * k_prime;
    const real_t c_phi = V->cf;
    const real_t s_phi = V->sf;
    const real_t kappa_1 = 1.0 / k_prime;
    const real_t kappa_2 = 1.0 / k_prime2;
    const real_t c_phi2 = c_phi * c_phi;
    const real_t s_phi2 = s_phi * s_phi;
    const real_t c_phi_s_phi = c_phi * s_phi;
    const real_t z_plus2 = z_plus * z_plus;
    const real_t z_plus3 = z_plus2 * z_plus;
    const real_t z_minus2 = z_minus * z_minus;
    const real_t z_minus3 = z_minus2 * z_minus;
    const real_t z_plus_z_minus = z_plus * z_minus;
    const real_t kappa_1_sq = kappa_1 * kappa_1;
    const real_t kappa_2_sq = kappa_2 * kappa_2;
    const real_t time_scale2 = time_scale * time_scale;
    const real_t time_scale3 = time_scale2 * time_scale;
    const real_t time_scale4 = time_scale2 * time_scale2;
    const real_t k_prime_minus_one_times_plus_one = (k_prime - 1.0) * (k_prime + 1.0);
    const real_t c_phi2_minus_s_phi2 = (c_phi - s_phi) * (c_phi + s_phi);

    /* PS 转换项 */
    memset(coeffs, 0, sizeof(*coeffs));
    coeffs->M[0][0].degree = 14;
    coeffs->M[0][0].time_degree = 4;
    coeffs->M[0][0].c[0][0] = -c_phi2 * z_minus2 + s_phi2 * z_minus2 + s_phi2;
    coeffs->M[0][0].c[1][1] = 4.0 * kappa_1 * time_scale * z_minus * c_phi2_minus_s_phi2;
    coeffs->M[0][0].c[0][2] =
        -(3.0 * c_phi2 * k_prime_square * z_minus2 + 2.0 * c_phi2 * k_prime_square * z_plus_z_minus - 2.0 * c_phi2 * z_minus2 +
          4.0 * k_prime_square * kappa_2 * s_phi2 - 3.0 * k_prime_square * s_phi2 * z_minus2 - 2.0 * k_prime_square * s_phi2 * z_plus_z_minus -
          5.0 * k_prime_square * s_phi2 + 2.0 * s_phi2 * z_minus2 + 2.0 * s_phi2) /
        k_prime_square;
    coeffs->M[0][0].c[2][2] = -4.0 * time_scale2 * (c_phi2 * kappa_1_sq - kappa_2 * s_phi2);
    coeffs->M[0][0].c[1][3] = 4.0 * kappa_1 * time_scale * c_phi2_minus_s_phi2 *
                              (3.0 * k_prime_square * z_minus + k_prime_square * z_plus - 2.0 * z_minus) / k_prime_square;
    coeffs->M[0][0].c[0][4] =
        -(2.0 * c_phi2 * k_prime_square * z_minus2 + 6.0 * c_phi2 * k_prime_square * z_plus_z_minus + c_phi2 * k_prime_square * z_plus2 -
          2.0 * c_phi2 * z_minus2 - 4.0 * c_phi2 * z_plus_z_minus + 12.0 * k_prime_square * kappa_2 * s_phi2 -
          2.0 * k_prime_square * s_phi2 * z_minus2 - 6.0 * k_prime_square * s_phi2 * z_plus_z_minus - k_prime_square * s_phi2 * z_plus2 -
          9.0 * k_prime_square * s_phi2 - 8.0 * kappa_2 * s_phi2 + 2.0 * s_phi2 * z_minus2 + 4.0 * s_phi2 * z_plus_z_minus + 6.0 * s_phi2) /
        k_prime_square;
    coeffs->M[0][0].c[2][4] = -4.0 * time_scale2 * (3.0 * k_prime_square - 2.0) * (c_phi2 * kappa_1_sq - kappa_2 * s_phi2) / k_prime_square;
    coeffs->M[0][0].c[1][5] = 4.0 * kappa_1 * time_scale * c_phi2_minus_s_phi2 *
                              (2.0 * k_prime_square * z_minus + 3.0 * k_prime_square * z_plus - 2.0 * z_minus - 2.0 * z_plus) / k_prime_square;
    coeffs->M[0][0].c[0][6] =
        (2.0 * c_phi2 * k_prime_square * z_minus2 - 4.0 * c_phi2 * k_prime_square * z_plus_z_minus - 3.0 * c_phi2 * k_prime_square * z_plus2 -
         2.0 * c_phi2 * z_minus2 + 4.0 * c_phi2 * z_plus_z_minus + 2.0 * c_phi2 * z_plus2 - 8.0 * k_prime_square * kappa_2 * s_phi2 -
         2.0 * k_prime_square * s_phi2 * z_minus2 + 4.0 * k_prime_square * s_phi2 * z_plus_z_minus + 3.0 * k_prime_square * s_phi2 * z_plus2 +
         5.0 * k_prime_square * s_phi2 + 8.0 * kappa_2 * s_phi2 + 2.0 * s_phi2 * z_minus2 - 4.0 * s_phi2 * z_plus_z_minus - 2.0 * s_phi2 * z_plus2 -
         4.0 * s_phi2) /
        k_prime_square;
    coeffs->M[0][0].c[2][6] = -8.0 * time_scale2 * k_prime_minus_one_times_plus_one * (c_phi2 * kappa_1_sq - kappa_2 * s_phi2) / k_prime_square;
    coeffs->M[0][0].c[1][7] =
        -8.0 * kappa_1 * time_scale * c_phi2_minus_s_phi2 * k_prime_minus_one_times_plus_one * (z_minus - z_plus) / k_prime_square;
    coeffs->M[0][0].c[0][8] =
        (3.0 * c_phi2 * k_prime_square * z_minus2 + 4.0 * c_phi2 * k_prime_square * z_plus_z_minus - 2.0 * c_phi2 * k_prime_square * z_plus2 -
         2.0 * c_phi2 * z_minus2 - 4.0 * c_phi2 * z_plus_z_minus + 2.0 * c_phi2 * z_plus2 + 8.0 * k_prime_square * kappa_2 * s_phi2 -
         3.0 * k_prime_square * s_phi2 * z_minus2 - 4.0 * k_prime_square * s_phi2 * z_plus_z_minus + 2.0 * k_prime_square * s_phi2 * z_plus2 -
         5.0 * k_prime_square * s_phi2 - 8.0 * kappa_2 * s_phi2 + 2.0 * s_phi2 * z_minus2 + 4.0 * s_phi2 * z_plus_z_minus - 2.0 * s_phi2 * z_plus2 +
         4.0 * s_phi2) /
        k_prime_square;
    coeffs->M[0][0].c[2][8] = 8.0 * time_scale2 * k_prime_minus_one_times_plus_one * (c_phi2 * kappa_1_sq - kappa_2 * s_phi2) / k_prime_square;
    coeffs->M[0][0].c[1][9] = -4.0 * kappa_1 * time_scale * c_phi2_minus_s_phi2 *
                              (3.0 * k_prime_square * z_minus + 2.0 * k_prime_square * z_plus - 2.0 * z_minus - 2.0 * z_plus) / k_prime_square;
    coeffs->M[0][0].c[0][10] =
        (c_phi2 * k_prime_square * z_minus2 + 6.0 * c_phi2 * k_prime_square * z_plus_z_minus + 2.0 * c_phi2 * k_prime_square * z_plus2 -
         4.0 * c_phi2 * z_plus_z_minus - 2.0 * c_phi2 * z_plus2 + 12.0 * k_prime_square * kappa_2 * s_phi2 - k_prime_square * s_phi2 * z_minus2 -
         6.0 * k_prime_square * s_phi2 * z_plus_z_minus - 2.0 * k_prime_square * s_phi2 * z_plus2 - 9.0 * k_prime_square * s_phi2 -
         8.0 * kappa_2 * s_phi2 + 4.0 * s_phi2 * z_plus_z_minus + 2.0 * s_phi2 * z_plus2 + 6.0 * s_phi2) /
        k_prime_square;
    coeffs->M[0][0].c[2][10] = 4.0 * time_scale2 * (3.0 * k_prime_square - 2.0) * (c_phi2 * kappa_1_sq - kappa_2 * s_phi2) / k_prime_square;
    coeffs->M[0][0].c[1][11] = -4.0 * kappa_1 * time_scale * c_phi2_minus_s_phi2 *
                               (k_prime_square * z_minus + 3.0 * k_prime_square * z_plus - 2.0 * z_plus) / k_prime_square;
    coeffs->M[0][0].c[0][12] = (2.0 * c_phi2 * k_prime_square * z_plus_z_minus + 3.0 * c_phi2 * k_prime_square * z_plus2 - 2.0 * c_phi2 * z_plus2 +
                                4.0 * k_prime_square * kappa_2 * s_phi2 - 2.0 * k_prime_square * s_phi2 * z_plus_z_minus -
                                3.0 * k_prime_square * s_phi2 * z_plus2 - 5.0 * k_prime_square * s_phi2 + 2.0 * s_phi2 * z_plus2 + 2.0 * s_phi2) /
                               k_prime_square;
    coeffs->M[0][0].c[2][12] = 4.0 * time_scale2 * (c_phi2 * kappa_1_sq - kappa_2 * s_phi2);
    coeffs->M[0][0].c[1][13] = -4.0 * kappa_1 * time_scale * z_plus * c_phi2_minus_s_phi2;
    coeffs->M[0][0].c[0][14] = c_phi2 * z_plus2 - s_phi2 * z_plus2 - s_phi2;
    coeffs->dM[0][0][0].degree = 16;
    coeffs->dM[0][0][0].time_degree = 4;
    coeffs->dM[0][0][0].c[0][0] = c_phi * z_minus * (c_phi2 * z_minus2 - 3.0 * s_phi2 * z_minus2 - 3.0 * s_phi2);
