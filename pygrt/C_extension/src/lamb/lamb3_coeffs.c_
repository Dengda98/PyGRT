/**
 * @file   lamb3_coeffs.c_
 * @author Zhu Dengda (zhudengda@mail.iggcas.ac.cn)
 * @date   2026-09
 *
 *    第三类 Lamb 问题的多项式系数构造
 *
 *    本文件直接按第四章和第八章的矩阵公式构造多项式；多项式运算只负责
 *    因子的相乘、相加以及按 x 和 tbar 保存系数，不再手动展开系数
 */

#include <string.h>

#include "grt/common/const.h"
#include "grt/lamb/lamb_poly.h"


/** 源点、接收点及材料参数 */
typedef struct {
    real_t nu;                              ///< 泊松比 nu
    real_t k;                               ///< P、S 波速比 k=beta/alpha
    real_t k2;                              ///< k^2
    real_t kp;                              ///< k'=sqrt(1-k^2)
    real_t kp2;                             ///< k'^2=1-k^2
    real_t R;                               ///< 源点和接收点的水平距离 R
    real_t r;                               ///< 直接路径长度
    real_t rp;                              ///< 反射路径长度
    real_t depsrc;                          ///< 源点深度 x3'
    real_t deprcv;                          ///< 接收点深度 x3
    real_t theta;                           ///< 直接波射线角 theta
    real_t theta_ref;                       ///< 反射波射线角 theta'
    real_t phi;                             ///< 水平面方位角 phi
    real_t st;                              ///< sin(theta)
    real_t ct;                              ///< cos(theta)
    real_t st_ref;                          ///< sin(theta')
    real_t ct_ref;                          ///< cos(theta')
    real_t sf;                              ///< sin(phi)
    real_t cf;                              ///< cos(phi)
    real_t theta_c;                         ///< 临界角 theta_c=asin(k)
    real_t tps;                             ///< PS 转换项的归一化到时
    real_t tsp;                             ///< SP 转换项的归一化到时
    real_t t_sPs;                           ///< sPs 项的归一化到时
    real_t reflection_P;                    ///< 反射 P 波的归一化到时
    real_t reflection_S;                    ///< 反射 S 波的归一化到时
    real_t varsigma;                        ///< r/rp，反射项的时间缩放
    real_t r_over_R;                        ///< r/R，转换项的时间缩放
    real_t kap1;                            ///< 1/k'
    real_t kap2;                            ///< 1/k'^2
    real_t conversion_scale;                ///< PS/SP 位移项的公共系数
    real_t conversion_dscale;              ///< PS/SP 导数项的公共系数
    real_t angle_ratio;                     ///< sf/cf，|cf| 过小时为 0
    bool use_angle_ratio;                   ///< |cf| 是否足够大，可用 sf/cf 复用分量
    bool supercritical;                    ///< 反射射线角是否超过临界角
    cplx_t rayleigh[3];                     ///< 反射项 Rayleigh 多项式的三个根
    cplx_t rayleigh_shifted[3];             ///< 平移后的反射根
    cplx_t rayleigh_ps[3];                  ///< PS/SP 转换项分母的三个根
} LAMB3_VARS;


/** 反射项的一组预计算多项式系数 */
typedef struct {
    LAMB_TBAR_X_POLY M[2][3][3];                ///< M[xi][i][j]，xi=0/1 对应 U/V
    LAMB_TBAR_X_POLY dM[3][2][3][3];            ///< dM[k][xi][i][j]，源点坐标导数
    LAMB_TBAR_X_POLY d2M[2][3][3][3][3];        ///< d2M[xi][k][kp][i][j]，混合导数的积分分子
} LAMB3_COEFF_SET;


/** 转换项的一组预计算多项式系数 */
typedef struct {
    LAMB_TBAR_X_POLY M[3][3];                   ///< M[i][j]，i,j 为接收点和源点分量
    LAMB_TBAR_X_POLY dM[3][3][3];               ///< dM[k][i][j]，源点坐标导数
    LAMB_TBAR_X_POLY d2M[3][3][3][3];           ///< d2M[k][kp][i][j]，混合导数的积分分子
} LAMB3_CONVERSION_COEFF_SET;


/** 一个关于 p 的偶部和 i*p 奇部表达式 */
typedef struct {
    LAMB_TBAR_X_POLY even;                      ///< 不含 p 的部分
    LAMB_TBAR_X_POLY odd;                       ///< i*p 的系数
} LAMB3_PARITY_POLY;


/** 反射项变量替换后的公共多项式 */
typedef struct {
    LAMB_TBAR_X_POLY x;                         ///< 当前积分变量 x
    LAMB_TBAR_X_POLY x2;                        ///< x^2
    LAMB_TBAR_X_POLY qbar;                      ///< qbar=(x*cos(theta')-tbar)/sin(theta')
    LAMB_TBAR_X_POLY qbar2;                     ///< qbar^2
    LAMB_TBAR_X_POLY pbar2;                     ///< pbar^2
    LAMB_TBAR_X_POLY g;                         ///< P 项中的 x^2-k^2 或 S 项中的 x^2-1
    LAMB_TBAR_X_POLY eta_other2;                ///< 未选作 x 的互补垂向根平方
    LAMB_TBAR_X_POLY gamma;                     ///< gamma
    LAMB_TBAR_X_POLY gamma2;                    ///< gamma^2
    LAMB_TBAR_X_POLY gamma4;                    ///< gamma^4
    LAMB_TBAR_X_POLY g2;                        ///< g^2
    LAMB_TBAR_X_POLY epsilon;                   ///< epsilon
    LAMB_TBAR_X_POLY bar_epsilon;               ///< bar_epsilon
    LAMB_TBAR_X_POLY zeta;                      ///< zeta
    LAMB_TBAR_X_POLY kappa;                     ///< kappa
    LAMB_TBAR_X_POLY bar_kappa;                 ///< bar_kappa
    LAMB_TBAR_X_POLY kappa_prime;               ///< kappa'=kappa+2*pbar^2
    LAMB_TBAR_X_POLY bar_kappa_prime;           ///< bar_kappa'=bar_kappa+2*pbar^2
    LAMB_TBAR_X_POLY dplus;                     ///< gamma^4+16*x^2*g^2*eta_other^2
    LAMB_TBAR_X_POLY dminus;                    ///< gamma^4-16*x^2*g^2*eta_other^2
    LAMB_TBAR_X_POLY dplus_zeta;                ///< SS 中 zeta 对应的公共因子
} LAMB3_REFLECTION_GEOMETRY;


/** 转换项变量替换后的公共多项式 */
typedef struct {
    LAMB_TBAR_X_POLY x;                         ///< 积分变量 x
    LAMB_TBAR_X_POLY x2;                        ///< x^2
    LAMB_TBAR_X_POLY x4;                        ///< x^4
    LAMB_TBAR_X_POLY effective_time;            ///< tbar*r/R
    LAMB_TBAR_X_POLY effective_time2;           ///< (tbar*r/R)^2
    LAMB_TBAR_X_POLY q;                         ///< qtilde
    LAMB_TBAR_X_POLY W;                         ///< W(x)
    LAMB_TBAR_X_POLY F;                         ///< F(x)
    LAMB_TBAR_X_POLY gap;                       ///< qtilde^2-W
    LAMB_TBAR_X_POLY x2_plus_one;               ///< x^2+1
    LAMB_TBAR_X_POLY x2_minus_one;              ///< x^2-1
    LAMB_TBAR_X_POLY x4_minus_one;              ///< x^4-1
    LAMB_TBAR_X_POLY epsilon;                   ///< epsilon
    LAMB_TBAR_X_POLY bar_epsilon;               ///< bar_epsilon
    LAMB_TBAR_X_POLY zeta;                      ///< zeta
    LAMB_TBAR_X_POLY kappa;                     ///< kappa
    LAMB_TBAR_X_POLY bar_kappa;                 ///< bar_kappa
    LAMB_TBAR_X_POLY kappa_prime;               ///< kappa'=kappa+2W
    LAMB_TBAR_X_POLY bar_kappa_prime;           ///< bar_kappa'=bar_kappa+2W
} LAMB3_CONVERSION_GEOMETRY;


/** 清空一个关于 p 的偶部和奇部表达式 */
static void lamb3_parity_zero(LAMB3_PARITY_POLY *value)
{
    grt_lamb_tbar_x_poly_zero(&value->even);
    grt_lamb_tbar_x_poly_zero(&value->odd);
}


/** 把不含 p 的多项式转换为偶部表达式 */
static void lamb3_parity_from_real(const LAMB_TBAR_X_POLY *source, LAMB3_PARITY_POLY *result)
{
    result->even = *source;
    grt_lamb_tbar_x_poly_zero(&result->odd);
}


/** 缩放一个关于 p 的偶部和奇部表达式 */
static void lamb3_parity_scale(const LAMB3_PARITY_POLY *source, const real_t scale,
                               LAMB3_PARITY_POLY *result)
{
    grt_lamb_tbar_x_poly_scale(&source->even, scale, &result->even);
    grt_lamb_tbar_x_poly_scale(&source->odd, scale, &result->odd);
}


/** 相加两个关于 p 的偶部和奇部表达式 */
static void lamb3_parity_add(const LAMB3_PARITY_POLY *left, const LAMB3_PARITY_POLY *right,
                             LAMB3_PARITY_POLY *result)
{
    grt_lamb_tbar_x_poly_add(&left->even, &right->even, &result->even);
    grt_lamb_tbar_x_poly_add(&left->odd, &right->odd, &result->odd);
}


/** 将缩放后的偶部和奇部表达式加到另一个表达式 */
static void lamb3_parity_add_scaled(const LAMB3_PARITY_POLY *base, const real_t scale,
                                    const LAMB3_PARITY_POLY *term, LAMB3_PARITY_POLY *result)
{
    LAMB3_PARITY_POLY scaled;
    lamb3_parity_scale(term, scale, &scaled);
    lamb3_parity_add(base, &scaled, result);
}


/** 乘以一个不含 p 的多项式 */
static void lamb3_parity_mul_real(const LAMB3_PARITY_POLY *left, const LAMB_TBAR_X_POLY *right,
                                  LAMB3_PARITY_POLY *result)
{
    grt_lamb_tbar_x_poly_mul(&left->even, right, &result->even);
    grt_lamb_tbar_x_poly_mul(&left->odd, right, &result->odd);
}


/** 相乘两个关于 p 的表达式并用 p^2 规约 */
static void lamb3_parity_mul(const LAMB3_PARITY_POLY *left, const LAMB3_PARITY_POLY *right,
                             const LAMB_TBAR_X_POLY *p2, LAMB3_PARITY_POLY *result)
{
    LAMB_TBAR_X_POLY even_even;
    LAMB_TBAR_X_POLY odd_odd;
    LAMB_TBAR_X_POLY odd_odd_p2;
    LAMB_TBAR_X_POLY even_odd;
    LAMB_TBAR_X_POLY odd_even;

    grt_lamb_tbar_x_poly_mul(&left->even, &right->even, &even_even);
    grt_lamb_tbar_x_poly_mul(&left->odd, &right->odd, &odd_odd);
    grt_lamb_tbar_x_poly_mul(&odd_odd, p2, &odd_odd_p2);
    grt_lamb_tbar_x_poly_add_scaled(&even_even, -1.0, &odd_odd_p2, &result->even);

    grt_lamb_tbar_x_poly_mul(&left->even, &right->odd, &even_odd);
    grt_lamb_tbar_x_poly_mul(&left->odd, &right->even, &odd_even);
    grt_lamb_tbar_x_poly_add(&even_odd, &odd_even, &result->odd);
}


/** 构造 q*c_phi-i*p*s_phi 或 q*s_phi+i*p*c_phi */
static void lamb3_parity_set_xi(const LAMB_TBAR_X_POLY *q, const real_t c_phi, const real_t s_phi,
                                const bool first, LAMB3_PARITY_POLY *result)
{
    const real_t q_factor = first ? c_phi : s_phi;
    const real_t p_factor = first ? -s_phi : c_phi;
    grt_lamb_tbar_x_poly_scale(q, q_factor, &result->even);
    grt_lamb_tbar_x_poly_const(&result->odd, p_factor);
}


/** 构造反射项的变量替换和角度组合 */
static void lamb3_make_reflection_geometry(const LAMB3_VARS *V, const bool s_wave,
                                           LAMB3_REFLECTION_GEOMETRY *G)
{
    const real_t k2 = V->k2;
    const real_t c_theta = V->ct_ref;
    const real_t s_theta = V->st_ref;
    const real_t c_phi = V->cf;
    const real_t s_phi = V->sf;
    const real_t s_theta2 = s_theta * s_theta;

    LAMB_TBAR_X_POLY one;
    LAMB_TBAR_X_POLY tbar;
    LAMB_TBAR_X_POLY tbar2;
    LAMB_TBAR_X_POLY xt;
    LAMB_TBAR_X_POLY constant;
    LAMB_TBAR_X_POLY term1;
    LAMB_TBAR_X_POLY term2;

    memset(G, 0, sizeof(*G));
    grt_lamb_tbar_x_poly_const(&one, 1.0);
    grt_lamb_tbar_x_poly_x(&G->x);
    grt_lamb_tbar_x_poly_mul(&G->x, &G->x, &G->x2);
    grt_lamb_tbar_x_poly_tbar(&tbar);
    grt_lamb_tbar_x_poly_mul(&tbar, &tbar, &tbar2);
    grt_lamb_tbar_x_poly_mul(&G->x, &tbar, &xt);

    grt_lamb_tbar_x_poly_scale(&G->x, c_theta, &G->qbar);
    grt_lamb_tbar_x_poly_add_scaled(&G->qbar, -1.0, &tbar, &G->qbar);
    grt_lamb_tbar_x_poly_scale(&G->qbar, 1.0 / s_theta, &G->qbar);
    grt_lamb_tbar_x_poly_mul(&G->qbar, &G->qbar, &G->qbar2);

    G->pbar2 = G->x2;
    grt_lamb_tbar_x_poly_add_scaled(&G->pbar2, -2.0 * c_theta, &xt, &G->pbar2);
    grt_lamb_tbar_x_poly_add(&G->pbar2, &tbar2, &G->pbar2);
    grt_lamb_tbar_x_poly_const(&constant, s_wave ? s_theta2 : k2 * s_theta2);
    grt_lamb_tbar_x_poly_add_scaled(&G->pbar2, -1.0, &constant, &G->pbar2);
    grt_lamb_tbar_x_poly_scale(&G->pbar2, 1.0 / s_theta2, &G->pbar2);

    G->g = G->x2;
    grt_lamb_tbar_x_poly_const(&constant, s_wave ? 1.0 : k2);
    grt_lamb_tbar_x_poly_add_scaled(&G->g, -1.0, &constant, &G->g);

    G->eta_other2 = G->x2;
    grt_lamb_tbar_x_poly_const(&constant, s_wave ? k2 - 1.0 : 1.0 - k2);
    grt_lamb_tbar_x_poly_add(&G->eta_other2, &constant, &G->eta_other2);

    grt_lamb_tbar_x_poly_scale(&G->x2, 2.0, &G->gamma);
    grt_lamb_tbar_x_poly_const(&constant, s_wave ? -1.0 : 1.0 - 2.0 * k2);
    grt_lamb_tbar_x_poly_add(&G->gamma, &constant, &G->gamma);
    grt_lamb_tbar_x_poly_mul(&G->gamma, &G->gamma, &G->gamma2);
    grt_lamb_tbar_x_poly_mul(&G->gamma2, &G->gamma2, &G->gamma4);
    grt_lamb_tbar_x_poly_mul(&G->g, &G->g, &G->g2);

    grt_lamb_tbar_x_poly_product4_scaled(&G->x2, &G->g2, &G->eta_other2, &one, 16.0, &term1);
    grt_lamb_tbar_x_poly_add(&G->gamma4, &term1, &G->dplus);
    grt_lamb_tbar_x_poly_add_scaled(&G->gamma4, -1.0, &term1, &G->dminus);

    grt_lamb_tbar_x_poly_add(&G->x2, &one, &term2);
    grt_lamb_tbar_x_poly_product4_scaled(&G->x2, &G->g, &G->eta_other2, &term2, 16.0, &term1);
    grt_lamb_tbar_x_poly_add(&G->gamma4, &term1, &G->dplus_zeta);

    grt_lamb_tbar_x_poly_scale(&G->qbar2, c_phi * c_phi, &term1);
    grt_lamb_tbar_x_poly_scale(&G->pbar2, -s_phi * s_phi, &term2);
    grt_lamb_tbar_x_poly_add(&term1, &term2, &G->epsilon);

    grt_lamb_tbar_x_poly_scale(&G->qbar2, s_phi * s_phi, &term1);
    grt_lamb_tbar_x_poly_scale(&G->pbar2, -c_phi * c_phi, &term2);
    grt_lamb_tbar_x_poly_add(&term1, &term2, &G->bar_epsilon);

    grt_lamb_tbar_x_poly_add(&G->qbar2, &G->pbar2, &term1);
    grt_lamb_tbar_x_poly_scale(&term1, s_phi * c_phi, &G->zeta);

    grt_lamb_tbar_x_poly_scale(&G->qbar2, c_phi * c_phi, &term1);
    grt_lamb_tbar_x_poly_scale(&G->pbar2, -3.0 * s_phi * s_phi, &term2);
    grt_lamb_tbar_x_poly_add(&term1, &term2, &G->kappa);

    grt_lamb_tbar_x_poly_scale(&G->qbar2, s_phi * s_phi, &term1);
    grt_lamb_tbar_x_poly_scale(&G->pbar2, -3.0 * c_phi * c_phi, &term2);
    grt_lamb_tbar_x_poly_add(&term1, &term2, &G->bar_kappa);

    grt_lamb_tbar_x_poly_add_scaled(&G->kappa, 2.0, &G->pbar2, &G->kappa_prime);
    grt_lamb_tbar_x_poly_add_scaled(&G->bar_kappa, 2.0, &G->pbar2, &G->bar_kappa_prime);
}


/** 构造反射项的标准水平源点导数矩阵 */
static void lamb3_make_standard_reflection_derivatives(const LAMB3_REFLECTION_GEOMETRY *G,
                                                        const LAMB_TBAR_X_POLY *factor,
                                                        const LAMB_TBAR_X_POLY *low,
                                                        const LAMB_TBAR_X_POLY *vertical,
                                                        const real_t c_phi, const real_t s_phi,
                                                        LAMB_TBAR_X_POLY first[3][3],
                                                        LAMB_TBAR_X_POLY second[3][3])
{
    grt_lamb_tbar_x_poly_product3_scaled(factor, &G->qbar, &G->kappa, c_phi, &first[0][0]);
    grt_lamb_tbar_x_poly_product3_scaled(factor, &G->qbar, &G->kappa_prime, s_phi, &first[0][1]);
    grt_lamb_tbar_x_poly_product2_scaled(low, &G->epsilon, 1.0, &first[0][2]);
    first[1][0] = first[0][1];
    grt_lamb_tbar_x_poly_product3_scaled(factor, &G->qbar, &G->bar_kappa_prime, c_phi, &first[1][1]);
    grt_lamb_tbar_x_poly_product2_scaled(low, &G->zeta, 1.0, &first[1][2]);
    grt_lamb_tbar_x_poly_scale(&first[0][2], -1.0, &first[2][0]);
    grt_lamb_tbar_x_poly_scale(&first[1][2], -1.0, &first[2][1]);
    grt_lamb_tbar_x_poly_product2_scaled(vertical, &G->qbar, -c_phi, &first[2][2]);

    grt_lamb_tbar_x_poly_product3_scaled(factor, &G->qbar, &G->kappa_prime, s_phi, &second[0][0]);
    grt_lamb_tbar_x_poly_product3_scaled(factor, &G->qbar, &G->bar_kappa_prime, c_phi, &second[0][1]);
    grt_lamb_tbar_x_poly_product2_scaled(low, &G->zeta, 1.0, &second[0][2]);
    second[1][0] = second[0][1];
    grt_lamb_tbar_x_poly_product3_scaled(factor, &G->qbar, &G->bar_kappa, s_phi, &second[1][1]);
    grt_lamb_tbar_x_poly_product2_scaled(low, &G->bar_epsilon, 1.0, &second[1][2]);
    grt_lamb_tbar_x_poly_scale(&second[0][2], -1.0, &second[2][0]);
    grt_lamb_tbar_x_poly_scale(&second[1][2], -1.0, &second[2][1]);
    grt_lamb_tbar_x_poly_product2_scaled(vertical, &G->qbar, -s_phi, &second[2][2]);
}


/** 构造 SS 表 8.2.4 中的一个公共导数因子 */
static void lamb3_make_S_derivative_term(const LAMB3_REFLECTION_GEOMETRY *G,
                                         const LAMB_TBAR_X_POLY *first_factor,
                                         const LAMB_TBAR_X_POLY *second_factor,
                                         LAMB_TBAR_X_POLY *result)
{
    LAMB_TBAR_X_POLY term1;
    LAMB_TBAR_X_POLY term2;

    grt_lamb_tbar_x_poly_add(&G->x2, first_factor, &term1);
    grt_lamb_tbar_x_poly_mul(&term1, &G->dminus, &term1);
    grt_lamb_tbar_x_poly_product5_scaled(&G->x2, &G->x2, &G->g, &G->eta_other2, second_factor, 32.0, &term2);
    grt_lamb_tbar_x_poly_add_scaled(&term1, -1.0, &term2, result);
}


/** 构造 P、S 反射项的基本矩阵 */
static void lamb3_make_reflection_matrices(const LAMB3_REFLECTION_GEOMETRY *G, const LAMB3_VARS *V,
                                           const bool s_wave, LAMB3_COEFF_SET *coeffs)
{
    const real_t c_phi = V->cf;
    const real_t s_phi = V->sf;
    LAMB_TBAR_X_POLY common;
    LAMB_TBAR_X_POLY low;
    LAMB_TBAR_X_POLY vertical;
    LAMB_TBAR_X_POLY term1;
    LAMB_TBAR_X_POLY term2;

    memset(coeffs, 0, sizeof(*coeffs));

    if (!s_wave) {
        /* 表 8.2.1，xi=1 */
        grt_lamb_tbar_x_poly_product2_scaled(&G->dplus, &G->epsilon, -1.0, &coeffs->M[0][0][0]);
        grt_lamb_tbar_x_poly_product2_scaled(&G->dplus, &G->zeta, -1.0, &coeffs->M[0][0][1]);
        grt_lamb_tbar_x_poly_product3_scaled(&G->dplus, &G->x, &G->qbar, -c_phi, &coeffs->M[0][0][2]);
        coeffs->M[0][1][0] = coeffs->M[0][0][1];
        grt_lamb_tbar_x_poly_product2_scaled(&G->dplus, &G->bar_epsilon, -1.0, &coeffs->M[0][1][1]);
        grt_lamb_tbar_x_poly_product3_scaled(&G->dplus, &G->x, &G->qbar, -s_phi, &coeffs->M[0][1][2]);
        grt_lamb_tbar_x_poly_scale(&coeffs->M[0][0][2], -1.0, &coeffs->M[0][2][0]);
        grt_lamb_tbar_x_poly_scale(&coeffs->M[0][1][2], -1.0, &coeffs->M[0][2][1]);
        grt_lamb_tbar_x_poly_product2_scaled(&G->dplus, &G->x2, 1.0, &coeffs->M[0][2][2]);

        /* 表 8.2.1，xi=2 */
        grt_lamb_tbar_x_poly_product4_scaled(&G->x, &G->eta_other2, &G->g, &G->gamma2, 1.0, &common);
        grt_lamb_tbar_x_poly_product2_scaled(&common, &G->epsilon, -8.0, &coeffs->M[1][0][0]);
        grt_lamb_tbar_x_poly_product2_scaled(&common, &G->zeta, -8.0, &coeffs->M[1][0][1]);
        grt_lamb_tbar_x_poly_product3_scaled(&common, &G->x, &G->qbar, -8.0 * c_phi, &coeffs->M[1][0][2]);
        coeffs->M[1][1][0] = coeffs->M[1][0][1];
        grt_lamb_tbar_x_poly_product2_scaled(&common, &G->bar_epsilon, -8.0, &coeffs->M[1][1][1]);
        grt_lamb_tbar_x_poly_product3_scaled(&common, &G->x, &G->qbar, -8.0 * s_phi, &coeffs->M[1][1][2]);
        grt_lamb_tbar_x_poly_scale(&coeffs->M[1][0][2], -1.0, &coeffs->M[1][2][0]);
        grt_lamb_tbar_x_poly_scale(&coeffs->M[1][1][2], -1.0, &coeffs->M[1][2][1]);
        grt_lamb_tbar_x_poly_product3_scaled(&common, &G->x, &G->x, 8.0, &coeffs->M[1][2][2]);
    } else {
        /* 表 8.2.3，xi=1 */
        grt_lamb_tbar_x_poly_add(&G->x2, &G->bar_epsilon, &term1);
        grt_lamb_tbar_x_poly_mul(&term1, &G->dminus, &term1);
        grt_lamb_tbar_x_poly_product5_scaled(&G->x2, &G->x2, &G->g, &G->eta_other2, &G->epsilon, 32.0, &term2);
        grt_lamb_tbar_x_poly_add_scaled(&term1, -1.0, &term2, &coeffs->M[0][0][0]);
        grt_lamb_tbar_x_poly_product2_scaled(&G->dplus_zeta, &G->zeta, -1.0, &coeffs->M[0][0][1]);
        grt_lamb_tbar_x_poly_product3_scaled(&G->dplus, &G->x, &G->qbar, -c_phi, &coeffs->M[0][0][2]);
        coeffs->M[0][1][0] = coeffs->M[0][0][1];
        grt_lamb_tbar_x_poly_add(&G->x2, &G->epsilon, &term1);
        grt_lamb_tbar_x_poly_mul(&term1, &G->dminus, &term1);
        grt_lamb_tbar_x_poly_product5_scaled(&G->x2, &G->x2, &G->g, &G->eta_other2, &G->bar_epsilon, 32.0, &term2);
        grt_lamb_tbar_x_poly_add_scaled(&term1, -1.0, &term2, &coeffs->M[0][1][1]);
        grt_lamb_tbar_x_poly_product3_scaled(&G->dplus, &G->x, &G->qbar, -s_phi, &coeffs->M[0][1][2]);
        grt_lamb_tbar_x_poly_scale(&coeffs->M[0][0][2], -1.0, &coeffs->M[0][2][0]);
        grt_lamb_tbar_x_poly_scale(&coeffs->M[0][1][2], -1.0, &coeffs->M[0][2][1]);
        grt_lamb_tbar_x_poly_product2_scaled(&G->g, &G->dplus, 1.0, &coeffs->M[0][2][2]);

        /* 表 8.2.3，xi=2 */
        grt_lamb_tbar_x_poly_product3_scaled(&G->x, &G->x, &G->x, 1.0, &common);
        grt_lamb_tbar_x_poly_product3_scaled(&common, &G->eta_other2, &G->gamma2, 1.0, &common);
        grt_lamb_tbar_x_poly_product2_scaled(&common, &G->epsilon, -8.0, &coeffs->M[1][0][0]);
        grt_lamb_tbar_x_poly_product2_scaled(&common, &G->zeta, -8.0, &coeffs->M[1][0][1]);
        grt_lamb_tbar_x_poly_product4_scaled(&G->x, &G->x, &G->g, &G->eta_other2, 1.0, &low);
        grt_lamb_tbar_x_poly_mul(&low, &G->gamma2, &low);
        grt_lamb_tbar_x_poly_product2_scaled(&low, &G->qbar, -8.0 * c_phi, &coeffs->M[1][0][2]);
        coeffs->M[1][1][0] = coeffs->M[1][0][1];
        grt_lamb_tbar_x_poly_product2_scaled(&common, &G->bar_epsilon, -8.0, &coeffs->M[1][1][1]);
        grt_lamb_tbar_x_poly_product2_scaled(&low, &G->qbar, -8.0 * s_phi, &coeffs->M[1][1][2]);
        grt_lamb_tbar_x_poly_scale(&coeffs->M[1][0][2], -1.0, &coeffs->M[1][2][0]);
        grt_lamb_tbar_x_poly_scale(&coeffs->M[1][1][2], -1.0, &coeffs->M[1][2][1]);
        grt_lamb_tbar_x_poly_product4_scaled(&G->x, &G->eta_other2, &G->g2, &G->gamma2, 8.0, &coeffs->M[1][2][2]);
    }

    for (int xi = 0; xi < 2; ++xi) {
        if (!s_wave) {
            /* 表 8.2.2 的两组导数共用同一矩阵模板 */
            if (xi == 0) {
                common = G->dplus;
            } else {
                grt_lamb_tbar_x_poly_product4_scaled(&G->x, &G->eta_other2, &G->g, &G->gamma2, 8.0, &common);
            }
            grt_lamb_tbar_x_poly_product2_scaled(&common, &G->x, 1.0, &low);
            grt_lamb_tbar_x_poly_product3_scaled(&common, &G->x, &G->x, 1.0, &vertical);
            lamb3_make_standard_reflection_derivatives(G, &common, &low, &vertical, c_phi, s_phi,
                                                        coeffs->dM[0][xi], coeffs->dM[1][xi]);
        } else if (xi == 0) {
            LAMB_TBAR_X_POLY term11;
            LAMB_TBAR_X_POLY term22;
            LAMB_TBAR_X_POLY term11_2;
            LAMB_TBAR_X_POLY term22_2;

            lamb3_make_S_derivative_term(G, &G->bar_kappa_prime, &G->kappa, &term11);
            lamb3_make_S_derivative_term(G, &G->kappa, &G->bar_kappa_prime, &term22);
            lamb3_make_S_derivative_term(G, &G->bar_kappa, &G->kappa_prime, &term11_2);
            lamb3_make_S_derivative_term(G, &G->kappa_prime, &G->bar_kappa, &term22_2);

            grt_lamb_tbar_x_poly_product2_scaled(&term11, &G->qbar, -c_phi, &coeffs->dM[0][xi][0][0]);
            grt_lamb_tbar_x_poly_product3_scaled(&G->dplus_zeta, &G->kappa_prime, &G->qbar, s_phi, &coeffs->dM[0][xi][0][1]);
            grt_lamb_tbar_x_poly_product3_scaled(&G->dplus, &G->x, &G->epsilon, 1.0, &coeffs->dM[0][xi][0][2]);
            coeffs->dM[0][xi][1][0] = coeffs->dM[0][xi][0][1];
            grt_lamb_tbar_x_poly_product2_scaled(&term22, &G->qbar, -c_phi, &coeffs->dM[0][xi][1][1]);
            grt_lamb_tbar_x_poly_product3_scaled(&G->dplus, &G->x, &G->zeta, 1.0, &coeffs->dM[0][xi][1][2]);
            grt_lamb_tbar_x_poly_scale(&coeffs->dM[0][xi][0][2], -1.0, &coeffs->dM[0][xi][2][0]);
            grt_lamb_tbar_x_poly_scale(&coeffs->dM[0][xi][1][2], -1.0, &coeffs->dM[0][xi][2][1]);
            grt_lamb_tbar_x_poly_product3_scaled(&G->g, &G->dplus, &G->qbar, -c_phi, &coeffs->dM[0][xi][2][2]);

            grt_lamb_tbar_x_poly_product2_scaled(&term11_2, &G->qbar, -s_phi, &coeffs->dM[1][xi][0][0]);
            grt_lamb_tbar_x_poly_product3_scaled(&G->dplus_zeta, &G->bar_kappa_prime, &G->qbar, c_phi, &coeffs->dM[1][xi][0][1]);
            grt_lamb_tbar_x_poly_product3_scaled(&G->dplus, &G->x, &G->zeta, 1.0, &coeffs->dM[1][xi][0][2]);
            coeffs->dM[1][xi][1][0] = coeffs->dM[1][xi][0][1];
            grt_lamb_tbar_x_poly_product2_scaled(&term22_2, &G->qbar, -s_phi, &coeffs->dM[1][xi][1][1]);
            grt_lamb_tbar_x_poly_product3_scaled(&G->dplus, &G->x, &G->bar_epsilon, 1.0, &coeffs->dM[1][xi][1][2]);
            grt_lamb_tbar_x_poly_scale(&coeffs->dM[1][xi][0][2], -1.0, &coeffs->dM[1][xi][2][0]);
            grt_lamb_tbar_x_poly_scale(&coeffs->dM[1][xi][1][2], -1.0, &coeffs->dM[1][xi][2][1]);
            grt_lamb_tbar_x_poly_product3_scaled(&G->g, &G->dplus, &G->qbar, -s_phi, &coeffs->dM[1][xi][2][2]);
        } else {
            grt_lamb_tbar_x_poly_product4_scaled(&G->x, &G->x, &G->x, &G->eta_other2, 8.0, &common);
            grt_lamb_tbar_x_poly_mul(&common, &G->gamma2, &common);
            grt_lamb_tbar_x_poly_product4_scaled(&G->x, &G->x, &G->g, &G->eta_other2, 8.0, &low);
            grt_lamb_tbar_x_poly_mul(&low, &G->gamma2, &low);
            grt_lamb_tbar_x_poly_product4_scaled(&G->x, &G->g, &G->g, &G->eta_other2, 8.0, &vertical);
            grt_lamb_tbar_x_poly_mul(&vertical, &G->gamma2, &vertical);
            lamb3_make_standard_reflection_derivatives(G, &common, &low, &vertical, c_phi, s_phi,
                                                        coeffs->dM[0][xi], coeffs->dM[1][xi]);
        }

        for (int i = 0; i < 3; ++i) {
            for (int j = 0; j < 3; ++j) {
                grt_lamb_tbar_x_poly_product2_scaled(&G->x, &coeffs->M[xi][i][j], -1.0,
                                           &coeffs->dM[2][xi][i][j]);
            }
        }
    }
}


/** 构造反射项中 M 的 p 偶部和奇部 */
static void lamb3_make_reflection_parity_matrices(const LAMB3_REFLECTION_GEOMETRY *G,
                                                  const LAMB3_VARS *V, const bool s_wave,
                                                  LAMB3_PARITY_POLY base[3][3],
                                                  LAMB3_PARITY_POLY complement[3][3])
{
    const real_t c_phi = V->cf;
    const real_t s_phi = V->sf;
    LAMB3_PARITY_POLY xi1;
    LAMB3_PARITY_POLY xi2;
    LAMB3_PARITY_POLY epsilon;
    LAMB3_PARITY_POLY bar_epsilon;
    LAMB3_PARITY_POLY zeta;
    LAMB3_PARITY_POLY factor;
    LAMB3_PARITY_POLY term1;
    LAMB3_PARITY_POLY term2;
    LAMB_TBAR_X_POLY x4;
    LAMB_TBAR_X_POLY common;
    LAMB_TBAR_X_POLY low;
    LAMB_TBAR_X_POLY real_term;

    for (int i = 0; i < 3; ++i) {
        for (int j = 0; j < 3; ++j) {
            lamb3_parity_zero(&base[i][j]);
            lamb3_parity_zero(&complement[i][j]);
        }
    }

    grt_lamb_tbar_x_poly_mul(&G->x2, &G->x2, &x4);
    lamb3_parity_set_xi(&G->qbar, c_phi, s_phi, true, &xi1);
    lamb3_parity_set_xi(&G->qbar, c_phi, s_phi, false, &xi2);
    lamb3_parity_mul(&xi1, &xi1, &G->pbar2, &epsilon);
    lamb3_parity_mul(&xi2, &xi2, &G->pbar2, &bar_epsilon);
    lamb3_parity_mul(&xi1, &xi2, &G->pbar2, &zeta);

    if (!s_wave) {
        lamb3_parity_mul_real(&epsilon, &G->dplus, &base[0][0]);
        lamb3_parity_scale(&base[0][0], -1.0, &base[0][0]);
        lamb3_parity_mul_real(&zeta, &G->dplus, &base[0][1]);
        lamb3_parity_scale(&base[0][1], -1.0, &base[0][1]);
        lamb3_parity_mul_real(&xi1, &G->x, &term1);
        lamb3_parity_mul_real(&term1, &G->dplus, &base[0][2]);
        lamb3_parity_scale(&base[0][2], -1.0, &base[0][2]);
        base[1][0] = base[0][1];
        lamb3_parity_mul_real(&bar_epsilon, &G->dplus, &base[1][1]);
        lamb3_parity_scale(&base[1][1], -1.0, &base[1][1]);
        lamb3_parity_mul_real(&xi2, &G->x, &term1);
        lamb3_parity_mul_real(&term1, &G->dplus, &base[1][2]);
        lamb3_parity_scale(&base[1][2], -1.0, &base[1][2]);
        lamb3_parity_scale(&base[0][2], -1.0, &base[2][0]);
        lamb3_parity_scale(&base[1][2], -1.0, &base[2][1]);
        lamb3_parity_from_real(&G->x2, &factor);
        lamb3_parity_mul_real(&factor, &G->dplus, &base[2][2]);

        grt_lamb_tbar_x_poly_product4_scaled(&G->x, &G->eta_other2, &G->g, &G->gamma2, 8.0, &common);
        lamb3_parity_mul_real(&epsilon, &common, &complement[0][0]);
        lamb3_parity_scale(&complement[0][0], -1.0, &complement[0][0]);
        lamb3_parity_mul_real(&zeta, &common, &complement[0][1]);
        lamb3_parity_scale(&complement[0][1], -1.0, &complement[0][1]);
        lamb3_parity_mul_real(&xi1, &G->x, &term1);
        lamb3_parity_mul_real(&term1, &common, &complement[0][2]);
        lamb3_parity_scale(&complement[0][2], -1.0, &complement[0][2]);
        complement[1][0] = complement[0][1];
        lamb3_parity_mul_real(&bar_epsilon, &common, &complement[1][1]);
        lamb3_parity_scale(&complement[1][1], -1.0, &complement[1][1]);
        lamb3_parity_mul_real(&xi2, &G->x, &term1);
        lamb3_parity_mul_real(&term1, &common, &complement[1][2]);
        lamb3_parity_scale(&complement[1][2], -1.0, &complement[1][2]);
        lamb3_parity_mul_real(&xi1, &G->x, &term1);
        lamb3_parity_mul_real(&term1, &common, &complement[2][0]);
        lamb3_parity_mul_real(&xi2, &G->x, &term1);
        lamb3_parity_mul_real(&term1, &common, &complement[2][1]);
        lamb3_parity_from_real(&G->x2, &factor);
        lamb3_parity_mul_real(&factor, &common, &complement[2][2]);
    } else {
        lamb3_parity_from_real(&G->x2, &factor);
        lamb3_parity_add(&factor, &bar_epsilon, &term1);
        lamb3_parity_mul_real(&term1, &G->dminus, &base[0][0]);
        grt_lamb_tbar_x_poly_product3_scaled(&x4, &G->g, &G->eta_other2, 32.0, &real_term);
        lamb3_parity_mul_real(&epsilon, &real_term, &term2);
        lamb3_parity_add_scaled(&base[0][0], -1.0, &term2, &base[0][0]);
        lamb3_parity_mul_real(&zeta, &G->dplus_zeta, &base[0][1]);
        lamb3_parity_scale(&base[0][1], -1.0, &base[0][1]);
        lamb3_parity_mul_real(&xi1, &G->x, &term1);
        lamb3_parity_mul_real(&term1, &G->dplus, &base[0][2]);
        lamb3_parity_scale(&base[0][2], -1.0, &base[0][2]);
        base[1][0] = base[0][1];
        lamb3_parity_from_real(&G->x2, &factor);
        lamb3_parity_add(&factor, &epsilon, &term1);
        lamb3_parity_mul_real(&term1, &G->dminus, &base[1][1]);
        grt_lamb_tbar_x_poly_product3_scaled(&x4, &G->g, &G->eta_other2, 32.0, &real_term);
        lamb3_parity_mul_real(&bar_epsilon, &real_term, &term2);
        lamb3_parity_add_scaled(&base[1][1], -1.0, &term2, &base[1][1]);
        lamb3_parity_mul_real(&xi2, &G->x, &term1);
        lamb3_parity_mul_real(&term1, &G->dplus, &base[1][2]);
        lamb3_parity_scale(&base[1][2], -1.0, &base[1][2]);
        lamb3_parity_scale(&base[0][2], -1.0, &base[2][0]);
        lamb3_parity_scale(&base[1][2], -1.0, &base[2][1]);
        lamb3_parity_from_real(&G->g, &factor);
        lamb3_parity_mul_real(&factor, &G->dplus, &base[2][2]);

        grt_lamb_tbar_x_poly_product4_scaled(&G->x, &G->x, &G->x, &G->eta_other2, -8.0, &common);
        grt_lamb_tbar_x_poly_mul(&common, &G->gamma2, &common);
        grt_lamb_tbar_x_poly_product4_scaled(&G->x, &G->x, &G->g, &G->eta_other2, -8.0, &low);
        grt_lamb_tbar_x_poly_mul(&low, &G->gamma2, &low);
        lamb3_parity_mul_real(&epsilon, &common, &complement[0][0]);
        lamb3_parity_mul_real(&zeta, &common, &complement[0][1]);
        complement[1][0] = complement[0][1];
        lamb3_parity_mul_real(&xi1, &low, &complement[0][2]);
        lamb3_parity_mul_real(&bar_epsilon, &common, &complement[1][1]);
        lamb3_parity_mul_real(&xi2, &low, &complement[1][2]);
        complement[2][0] = complement[0][2];
        lamb3_parity_scale(&complement[2][0], -1.0, &complement[2][0]);
        lamb3_parity_mul_real(&xi2, &low, &complement[2][1]);
        lamb3_parity_scale(&complement[2][1], -1.0, &complement[2][1]);
        grt_lamb_tbar_x_poly_product4_scaled(&G->x, &G->g, &G->g, &G->eta_other2, 8.0, &real_term);
        grt_lamb_tbar_x_poly_mul(&real_term, &G->gamma2, &real_term);
        lamb3_parity_from_real(&real_term, &complement[2][2]);
    }
}


/**
 * 按式 (8.1.6) 的方向因子构造反射项混合二阶导数分子
 * 接收点水平因子为 xi，源点水平因子为 -xi，竖向因子由 -x 和互易矩阵给出
 */
static void lamb3_make_reflection_mixed_coefficients(const LAMB3_REFLECTION_GEOMETRY *G,
                                                     const LAMB3_VARS *V, const bool s_wave,
                                                     LAMB3_COEFF_SET *coeffs)
{
    const int direction_sign[3] = {-1, -1, 1};
    LAMB3_PARITY_POLY base[3][3];
    LAMB3_PARITY_POLY complement[3][3];
    LAMB3_PARITY_POLY source_factor[3];
    LAMB3_PARITY_POLY receiver_factor[2];
    LAMB3_PARITY_POLY factor;
    LAMB3_PARITY_POLY partner;
    LAMB3_PARITY_POLY result;

    lamb3_make_reflection_parity_matrices(G, V, s_wave, base, complement);
    lamb3_parity_set_xi(&G->qbar, V->cf, V->sf, true, &receiver_factor[0]);
    lamb3_parity_set_xi(&G->qbar, V->cf, V->sf, false, &receiver_factor[1]);
    lamb3_parity_set_xi(&G->qbar, V->cf, V->sf, true, &source_factor[0]);
    lamb3_parity_set_xi(&G->qbar, V->cf, V->sf, false, &source_factor[1]);
    lamb3_parity_scale(&source_factor[0], -1.0, &source_factor[0]);
    lamb3_parity_scale(&source_factor[1], -1.0, &source_factor[1]);
    lamb3_parity_from_real(&G->x, &source_factor[2]);
    lamb3_parity_scale(&source_factor[2], -1.0, &source_factor[2]);

    memset(coeffs->d2M, 0, sizeof(coeffs->d2M));
    for (int xi = 0; xi < 2; ++xi) {
        const LAMB3_PARITY_POLY (*matrix)[3] = xi == 0 ? base : complement;
        for (int receiver_direction = 0; receiver_direction < 3; ++receiver_direction) {
            for (int source_direction = 0; source_direction < 3; ++source_direction) {
                for (int i = 0; i < 3; ++i) {
                    for (int j = 0; j < 3; ++j) {
                        if (receiver_direction < 2) {
                            lamb3_parity_mul(&receiver_factor[receiver_direction], &source_factor[source_direction],
                                             &G->pbar2, &factor);
                            lamb3_parity_mul(&factor, &matrix[i][j], &G->pbar2, &result);
                        } else {
                            lamb3_parity_mul_real(&source_factor[source_direction], &G->x, &factor);
                            lamb3_parity_scale(&factor, -1.0, &factor);
                            partner = matrix[j][i];
                            lamb3_parity_scale(&partner, direction_sign[i] * direction_sign[j], &partner);
                            lamb3_parity_mul(&factor, &partner, &G->pbar2, &result);
                        }
                        /* 关于 p 的奇部在对称积分中抵消，只需保存偶部 */
                        coeffs->d2M[xi][receiver_direction][source_direction][i][j] = result.even;
                    }
                }
            }
        }
    }
}


/** 构造 PS 转换项的变量替换和角度组合 */
static void lamb3_make_conversion_geometry(const LAMB3_VARS *V, const bool sp_wave,
                                           LAMB3_CONVERSION_GEOMETRY *G)
{
    const real_t z_plus = (V->depsrc + V->deprcv) / V->R;
    const real_t z_minus = (sp_wave ? -1.0 : 1.0) * (V->deprcv - V->depsrc) / V->R;
    const real_t kappa1 = V->kap1;
    const real_t kappa2 = V->kap2;
    const real_t c_phi = V->cf;
    const real_t s_phi = V->sf;

    LAMB_TBAR_X_POLY one;
    LAMB_TBAR_X_POLY tbar;
    LAMB_TBAR_X_POLY constant;
    LAMB_TBAR_X_POLY term;
    LAMB_TBAR_X_POLY middle;
    LAMB_TBAR_X_POLY q2;

    memset(G, 0, sizeof(*G));
    grt_lamb_tbar_x_poly_const(&one, 1.0);
    grt_lamb_tbar_x_poly_x(&G->x);
    grt_lamb_tbar_x_poly_mul(&G->x, &G->x, &G->x2);
    grt_lamb_tbar_x_poly_mul(&G->x2, &G->x2, &G->x4);

    grt_lamb_tbar_x_poly_tbar(&tbar);
    grt_lamb_tbar_x_poly_scale(&tbar, V->r_over_R, &G->effective_time);
    grt_lamb_tbar_x_poly_mul(&G->effective_time, &G->effective_time, &G->effective_time2);

    grt_lamb_tbar_x_poly_scale(&G->x2, z_plus, &G->q);
    grt_lamb_tbar_x_poly_product2_scaled(&G->effective_time, &G->x, -2.0 * kappa1, &term);
    grt_lamb_tbar_x_poly_add(&G->q, &term, &G->q);
    grt_lamb_tbar_x_poly_const(&constant, z_minus);
    grt_lamb_tbar_x_poly_add(&G->q, &constant, &G->q);

    grt_lamb_tbar_x_poly_scale(&G->x4, z_plus * z_plus + 1.0, &G->W);
    grt_lamb_tbar_x_poly_product2_scaled(&G->effective_time, &G->x, -4.0 * kappa1 * z_plus, &term);
    grt_lamb_tbar_x_poly_mul(&term, &G->x2, &term);
    grt_lamb_tbar_x_poly_add(&G->W, &term, &G->W);

    grt_lamb_tbar_x_poly_const(&middle, 2.0 * (z_plus * z_minus + 1.0 - 2.0 * kappa2));
    grt_lamb_tbar_x_poly_scale(&G->effective_time2, 4.0 * kappa2, &term);
    grt_lamb_tbar_x_poly_add(&middle, &term, &middle);
    grt_lamb_tbar_x_poly_mul(&middle, &G->x2, &term);
    grt_lamb_tbar_x_poly_add(&G->W, &term, &G->W);

    grt_lamb_tbar_x_poly_product2_scaled(&G->effective_time, &G->x, -4.0 * kappa1 * z_minus, &term);
    grt_lamb_tbar_x_poly_add(&G->W, &term, &G->W);
    grt_lamb_tbar_x_poly_const(&constant, z_minus * z_minus + 1.0);
    grt_lamb_tbar_x_poly_add(&G->W, &constant, &G->W);

    grt_lamb_tbar_x_poly_mul(&G->q, &G->q, &q2);
    grt_lamb_tbar_x_poly_add_scaled(&q2, -1.0, &G->W, &G->gap);

    grt_lamb_tbar_x_poly_scale(&G->x2, 2.0 * (1.0 - kappa1 * kappa1), &term);
    grt_lamb_tbar_x_poly_add(&G->x4, &term, &G->F);
    grt_lamb_tbar_x_poly_add(&G->F, &one, &G->F);

    grt_lamb_tbar_x_poly_add(&G->x2, &one, &G->x2_plus_one);
    grt_lamb_tbar_x_poly_add_scaled(&G->x2, -1.0, &one, &G->x2_minus_one);
    grt_lamb_tbar_x_poly_add_scaled(&G->x4, -1.0, &one, &G->x4_minus_one);

    grt_lamb_tbar_x_poly_scale(&q2, c_phi * c_phi, &term);
    grt_lamb_tbar_x_poly_scale(&G->W, -s_phi * s_phi, &constant);
    grt_lamb_tbar_x_poly_add(&term, &constant, &G->epsilon);

    grt_lamb_tbar_x_poly_scale(&q2, s_phi * s_phi, &term);
    grt_lamb_tbar_x_poly_scale(&G->W, -c_phi * c_phi, &constant);
    grt_lamb_tbar_x_poly_add(&term, &constant, &G->bar_epsilon);

    grt_lamb_tbar_x_poly_add(&q2, &G->W, &term);
    grt_lamb_tbar_x_poly_scale(&term, s_phi * c_phi, &G->zeta);

    grt_lamb_tbar_x_poly_scale(&q2, c_phi * c_phi, &term);
    grt_lamb_tbar_x_poly_scale(&G->W, -3.0 * s_phi * s_phi, &constant);
    grt_lamb_tbar_x_poly_add(&term, &constant, &G->kappa);

    grt_lamb_tbar_x_poly_scale(&q2, s_phi * s_phi, &term);
    grt_lamb_tbar_x_poly_scale(&G->W, -3.0 * c_phi * c_phi, &constant);
    grt_lamb_tbar_x_poly_add(&term, &constant, &G->bar_kappa);

    grt_lamb_tbar_x_poly_add_scaled(&G->kappa, 2.0, &G->W, &G->kappa_prime);
    grt_lamb_tbar_x_poly_add_scaled(&G->bar_kappa, 2.0, &G->W, &G->bar_kappa_prime);
}


/** 构造 PS 转换项的基本矩阵和两个水平源点导数矩阵 */
static void lamb3_make_conversion_ps_matrices(const LAMB3_CONVERSION_GEOMETRY *G,
                                              const LAMB3_VARS *V,
                                              LAMB3_CONVERSION_COEFF_SET *coeffs)
{
    const real_t c_phi = V->cf;
    const real_t s_phi = V->sf;

    memset(coeffs, 0, sizeof(*coeffs));

    /* 式 (8.3.3a)，PS 的基本矩阵 */
    grt_lamb_tbar_x_poly_product2_scaled(&G->x2_plus_one, &G->epsilon, 1.0, &coeffs->M[0][0]);
    grt_lamb_tbar_x_poly_product2_scaled(&G->x2_plus_one, &G->zeta, 1.0, &coeffs->M[0][1]);
    grt_lamb_tbar_x_poly_product2_scaled(&G->x4_minus_one, &G->q, c_phi, &coeffs->M[0][2]);
    coeffs->M[1][0] = coeffs->M[0][1];
    grt_lamb_tbar_x_poly_product2_scaled(&G->x2_plus_one, &G->bar_epsilon, 1.0, &coeffs->M[1][1]);
    grt_lamb_tbar_x_poly_product2_scaled(&G->x4_minus_one, &G->q, s_phi, &coeffs->M[1][2]);
    grt_lamb_tbar_x_poly_product2_scaled(&G->gap, &G->q, c_phi, &coeffs->M[2][0]);
    grt_lamb_tbar_x_poly_product2_scaled(&G->gap, &G->q, s_phi, &coeffs->M[2][1]);
    grt_lamb_tbar_x_poly_product2_scaled(&G->x2_minus_one, &G->gap, 1.0, &coeffs->M[2][2]);

    /* 式 (8.3.3b)，源点方向 1 */
    grt_lamb_tbar_x_poly_product3_scaled(&G->x2_plus_one, &G->kappa, &G->q, -c_phi, &coeffs->dM[0][0][0]);
    grt_lamb_tbar_x_poly_product3_scaled(&G->x2_plus_one, &G->kappa_prime, &G->q, -s_phi, &coeffs->dM[0][0][1]);
    grt_lamb_tbar_x_poly_product2_scaled(&G->x4_minus_one, &G->epsilon, -1.0, &coeffs->dM[0][0][2]);
    coeffs->dM[0][1][0] = coeffs->dM[0][0][1];
    grt_lamb_tbar_x_poly_product3_scaled(&G->x2_plus_one, &G->bar_kappa_prime, &G->q, -c_phi, &coeffs->dM[0][1][1]);
    grt_lamb_tbar_x_poly_product2_scaled(&G->x4_minus_one, &G->zeta, -1.0, &coeffs->dM[0][1][2]);
    grt_lamb_tbar_x_poly_product2_scaled(&G->gap, &G->epsilon, -1.0, &coeffs->dM[0][2][0]);
    grt_lamb_tbar_x_poly_product2_scaled(&G->gap, &G->zeta, -1.0, &coeffs->dM[0][2][1]);
    grt_lamb_tbar_x_poly_product3_scaled(&G->x2_minus_one, &G->gap, &G->q, -c_phi, &coeffs->dM[0][2][2]);

    /* 式 (8.3.3b)，源点方向 2 */
    coeffs->dM[1][0][0] = coeffs->dM[0][0][1];
    coeffs->dM[1][0][1] = coeffs->dM[0][1][1];
    coeffs->dM[1][0][2] = coeffs->dM[0][1][2];
    coeffs->dM[1][1][0] = coeffs->dM[0][1][1];
    grt_lamb_tbar_x_poly_product3_scaled(&G->x2_plus_one, &G->bar_kappa, &G->q, -s_phi, &coeffs->dM[1][1][1]);
    grt_lamb_tbar_x_poly_product2_scaled(&G->x4_minus_one, &G->bar_epsilon, -1.0, &coeffs->dM[1][1][2]);
    coeffs->dM[1][2][0] = coeffs->dM[0][2][1];
    grt_lamb_tbar_x_poly_product2_scaled(&G->gap, &G->bar_epsilon, -1.0, &coeffs->dM[1][2][1]);
    grt_lamb_tbar_x_poly_product3_scaled(&G->x2_minus_one, &G->gap, &G->q, -s_phi, &coeffs->dM[1][2][2]);
}


/** 按式 (8.1.6g) 对转换项矩阵做分量置换和变号 */
static void lamb3_transform_conversion_matrix(LAMB_TBAR_X_POLY (*matrix)[3])
{
    LAMB_TBAR_X_POLY source[3][3];

    memcpy(source, matrix, sizeof(source));
    matrix[0][0] = source[0][0];
    matrix[0][1] = source[0][1];
    grt_lamb_tbar_x_poly_scale(&source[2][0], -1.0, &matrix[0][2]);
    matrix[1][0] = source[1][0];
    matrix[1][1] = source[1][1];
    grt_lamb_tbar_x_poly_scale(&source[2][1], -1.0, &matrix[1][2]);
    grt_lamb_tbar_x_poly_scale(&source[0][2], -1.0, &matrix[2][0]);
    grt_lamb_tbar_x_poly_scale(&source[1][2], -1.0, &matrix[2][1]);
    matrix[2][2] = source[2][2];
}


/** 构造转换项的源点竖向导数 */
static void lamb3_make_conversion_vertical_source_derivatives(const LAMB3_CONVERSION_GEOMETRY *G,
                                                               const int constant_sign,
                                                               LAMB3_CONVERSION_COEFF_SET *coeffs)
{
    LAMB_TBAR_X_POLY constant;
    LAMB_TBAR_X_POLY factor;

    grt_lamb_tbar_x_poly_const(&constant, (real_t)constant_sign);
    grt_lamb_tbar_x_poly_add_scaled(&constant, -1.0, &G->x2, &factor);
    for (int i = 0; i < 3; ++i) {
        for (int j = 0; j < 3; ++j) {
            grt_lamb_tbar_x_poly_product2_scaled(&factor, &coeffs->M[i][j], 1.0, &coeffs->dM[2][i][j]);
        }
    }
}


/**
 * 按式 (8.1.6) 的方向因子构造转换项混合二阶导数分子
 * 接收点水平因子为 xi，源点水平因子为 -xi，源点竖向因子由式 (8.3.1) 给出
 */
static void lamb3_make_conversion_mixed_coefficients(const LAMB3_CONVERSION_GEOMETRY *G,
                                                      const LAMB3_VARS *V, const bool sp_wave,
                                                      LAMB_TBAR_X_POLY d2M[3][3][3][3])
{
    const int direction_sign[3] = {-1, -1, 1};
    LAMB3_PARITY_POLY raw[3][3];
    LAMB3_PARITY_POLY transformed[3][3];
    LAMB3_PARITY_POLY xi1;
    LAMB3_PARITY_POLY xi2;
    LAMB3_PARITY_POLY epsilon;
    LAMB3_PARITY_POLY bar_epsilon;
    LAMB3_PARITY_POLY zeta;
    LAMB3_PARITY_POLY source_factor[3];
    LAMB3_PARITY_POLY receiver_factor[2];
    LAMB3_PARITY_POLY factor;
    LAMB3_PARITY_POLY partner;
    LAMB3_PARITY_POLY result;
    LAMB_TBAR_X_POLY source_vertical;
    LAMB_TBAR_X_POLY partner_vertical;
    LAMB_TBAR_X_POLY global_factor;

    lamb3_parity_set_xi(&G->q, V->cf, V->sf, true, &xi1);
    lamb3_parity_set_xi(&G->q, V->cf, V->sf, false, &xi2);
    lamb3_parity_mul(&xi1, &xi1, &G->W, &epsilon);
    lamb3_parity_mul(&xi2, &xi2, &G->W, &bar_epsilon);
    lamb3_parity_mul(&xi1, &xi2, &G->W, &zeta);

    lamb3_parity_mul_real(&epsilon, &G->x2_plus_one, &raw[0][0]);
    lamb3_parity_mul_real(&zeta, &G->x2_plus_one, &raw[0][1]);
    lamb3_parity_mul_real(&xi1, &G->x4_minus_one, &raw[0][2]);
    raw[1][0] = raw[0][1];
    lamb3_parity_mul_real(&bar_epsilon, &G->x2_plus_one, &raw[1][1]);
    lamb3_parity_mul_real(&xi2, &G->x4_minus_one, &raw[1][2]);
    lamb3_parity_mul_real(&xi1, &G->gap, &raw[2][0]);
    lamb3_parity_mul_real(&xi2, &G->gap, &raw[2][1]);
    lamb3_parity_from_real(&G->x2_minus_one, &factor);
    lamb3_parity_mul_real(&factor, &G->gap, &raw[2][2]);

    transformed[0][0] = raw[0][0];
    transformed[0][1] = raw[0][1];
    lamb3_parity_scale(&raw[2][0], -1.0, &transformed[0][2]);
    transformed[1][0] = raw[1][0];
    transformed[1][1] = raw[1][1];
    lamb3_parity_scale(&raw[2][1], -1.0, &transformed[1][2]);
    lamb3_parity_scale(&raw[0][2], -1.0, &transformed[2][0]);
    lamb3_parity_scale(&raw[1][2], -1.0, &transformed[2][1]);
    transformed[2][2] = raw[2][2];

    lamb3_parity_set_xi(&G->q, V->cf, V->sf, true, &receiver_factor[0]);
    lamb3_parity_set_xi(&G->q, V->cf, V->sf, false, &receiver_factor[1]);
    lamb3_parity_scale(&xi1, -1.0, &source_factor[0]);
    lamb3_parity_scale(&xi2, -1.0, &source_factor[1]);

    /* 式 (8.3.1) 中源点竖向导数的 PS/SP 因子 */
    if (sp_wave) {
        grt_lamb_tbar_x_poly_scale(&G->x2_plus_one, -1.0, &source_vertical);
        grt_lamb_tbar_x_poly_scale(&G->x2_minus_one, -1.0, &partner_vertical);
    } else {
        grt_lamb_tbar_x_poly_scale(&G->x2_minus_one, -1.0, &source_vertical);
        grt_lamb_tbar_x_poly_scale(&G->x2_plus_one, -1.0, &partner_vertical);
    }
    lamb3_parity_from_real(&source_vertical, &source_factor[2]);

    /* 各转换项共同的 (x^4-1)F(x) 因子 */
    grt_lamb_tbar_x_poly_product2_scaled(&G->x4_minus_one, &G->F, 1.0, &global_factor);
    const LAMB3_PARITY_POLY (*matrix)[3] = sp_wave ? transformed : raw;
    const LAMB3_PARITY_POLY (*partner_matrix)[3] = sp_wave ? raw : transformed;

    memset(d2M, 0, sizeof(LAMB_TBAR_X_POLY) * 3 * 3 * 3 * 3);
    for (int receiver_direction = 0; receiver_direction < 3; ++receiver_direction) {
        for (int source_direction = 0; source_direction < 3; ++source_direction) {
            for (int i = 0; i < 3; ++i) {
                for (int j = 0; j < 3; ++j) {
                    if (receiver_direction < 2) {
                        lamb3_parity_mul(&receiver_factor[receiver_direction], &source_factor[source_direction],
                                         &G->W, &factor);
                        lamb3_parity_mul(&factor, &matrix[i][j], &G->W, &result);
                    } else {
                        partner = partner_matrix[j][i];
                        lamb3_parity_scale(&partner, direction_sign[i] * direction_sign[j], &partner);
                        lamb3_parity_mul_real(&partner, &partner_vertical, &partner);
                        lamb3_parity_mul(&source_factor[source_direction], &partner, &G->W, &result);
                    }
                    lamb3_parity_mul_real(&result, &global_factor, &result);
                    /* 关于 p 的奇部在对称积分中抵消，只需保存偶部 */
                    d2M[receiver_direction][source_direction][i][j] = result.even;
                }
            }
        }
    }
}


/** 构造一组反射项的全部多项式系数 */
static void make_lamb3_reflection_coefficients(const LAMB3_VARS *V, const bool s_wave, const bool need_mixed,
                                               LAMB3_COEFF_SET *coeffs)
{
    LAMB3_REFLECTION_GEOMETRY G;

    lamb3_make_reflection_geometry(V, s_wave, &G);
    lamb3_make_reflection_matrices(&G, V, s_wave, coeffs);
    if (need_mixed) {
        lamb3_make_reflection_mixed_coefficients(&G, V, s_wave, coeffs);
    }
}


/** 构造一组 PS 或 SP 转换项的全部多项式系数 */
static void make_lamb3_conversion_coefficients(const LAMB3_VARS *V, const bool sp_wave, const bool need_mixed,
                                               LAMB3_CONVERSION_COEFF_SET *coeffs)
{
    LAMB3_CONVERSION_GEOMETRY G;
    LAMB_TBAR_X_POLY global_factor;

    lamb3_make_conversion_geometry(V, sp_wave, &G);
    lamb3_make_conversion_ps_matrices(&G, V, coeffs);
    grt_lamb_tbar_x_poly_product2_scaled(&G.x4_minus_one, &G.F, 1.0, &global_factor);
    for (int i = 0; i < 3; ++i) {
        for (int j = 0; j < 3; ++j) {
            grt_lamb_tbar_x_poly_mul(&global_factor, &coeffs->M[i][j], &coeffs->M[i][j]);
            for (int k = 0; k < 2; ++k) {
                grt_lamb_tbar_x_poly_mul(&global_factor, &coeffs->dM[k][i][j], &coeffs->dM[k][i][j]);
            }
        }
    }

    if (sp_wave) {
        lamb3_transform_conversion_matrix(coeffs->M);
        for (int k = 0; k < 2; ++k) {
            lamb3_transform_conversion_matrix(coeffs->dM[k]);
        }
    }
    lamb3_make_conversion_vertical_source_derivatives(&G, sp_wave ? -1 : 1, coeffs);
    if (need_mixed) {
        lamb3_make_conversion_mixed_coefficients(&G, V, sp_wave, coeffs->d2M);
    }
}
