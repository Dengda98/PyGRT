/**
 * @file   lamb3_coeffs.c_
 * @author Zhu Dengda (zhudengda@mail.iggcas.ac.cn)
 * @date   2026-09
 *
 *    第三类 Lamb 问题中的多项式的 x 系数，由 SymPy 预先推导
 */

#include <string.h>
#include "grt/common/const.h"

#define LAMB3_POLY_SIZE 17
#define LAMB3_TIME_SIZE 5

/** 源点、接收点及材料参数 */
typedef struct {
    real_t nu;                  ///< 泊松比 nu
    real_t k;                   ///< P、S 波速比 k=beta/alpha
    real_t k2;                  ///< k^2
    real_t kp;                  ///< kp=sqrt(1-k^2)
    real_t kp2;                 ///< kp^2=1-k^2
    real_t R;                   ///< 源点和接收点的水平距离 R
    real_t r;                   ///< 直接路径长度 r=sqrt(R^2+(source_depth-receiver_depth)^2)
    real_t rp;                  ///< 反射路径长度 rp=sqrt(R^2+(source_depth+receiver_depth)^2)
    real_t source_depth;        ///< 源点深度 x3'
    real_t receiver_depth;      ///< 接收点深度 x3
    real_t theta;               ///< 直接波射线角 theta=atan2(R,source_depth-receiver_depth)
    real_t theta_ref;           ///< 反射波射线角 theta_ref=atan2(R,source_depth+receiver_depth)
    real_t phi;                 ///< 水平面方位角 phi
    real_t st;                  ///< sin(theta)
    real_t ct;                  ///< cos(theta)
    real_t st_ref;              ///< sin(theta_ref)
    real_t ct_ref;              ///< cos(theta_ref)
    real_t sf;                  ///< sin(phi)
    real_t cf;                  ///< cos(phi)
    real_t theta_c;             ///< 临界角 theta_c=asin(k)
    real_t tps;                 ///< PS 转换项的归一化到时
    real_t tsp;                 ///< SP 转换项的归一化到时
    real_t t_sps;               ///< sPs 项的归一化到时
    real_t reflection_P;        ///< 反射 P 波的归一化到时 k*rp/r
    real_t reflection_S;        ///< 反射 S 波的归一化到时 rp/r
    real_t varsigma;            ///< r/rp，反射项的时间缩放
    real_t r_over_R;            ///< r/R，转换项的时间缩放
    real_t kap1;                ///< 1/kp
    real_t kap2;                ///< 1/kp2
    real_t conversion_scale;    ///< PS/SP 位移项的公共系数
    real_t conversion_dscale;   ///< PS/SP 导数项的公共系数
    real_t angle_ratio;         ///< sf/cf，|cf| 过小时为 0
    bool use_angle_ratio;       ///< |cf| 是否足够大，可用 sf/cf 复用分量
    bool supercritical;         ///< 反射射线角是否超过临界角
    cplx_t rayleigh[3];         ///< 反射项 Rayleigh 多项式的三个根 y[i]，i=0,1,2
    cplx_t rayleigh_shifted[3]; ///< 平移后的反射根 y[i]-kp^2，i=0,1,2
    cplx_t rayleigh_ps[3];      ///< PS/SP 转换项分母三个二次因子的根，i=0,1,2
} LAMB3_VARS;

/** 按 x 和 tbar 分解后的多项式系数 */
typedef struct {
    real_t c[LAMB3_TIME_SIZE][LAMB3_POLY_SIZE]; ///< c[r][m] 是 tbar^r*x^m 的系数，r=0,...,LAMB3_TIME_SIZE-1，m=0,...,LAMB3_POLY_SIZE-1
    int degree;                                 ///< x 的最高次数
    int time_degree;                            ///< tbar 的最高次数
} LAMB3_POLY_COEFF;

/** 反射项的一组预计算多项式系数 */
typedef struct {
    LAMB3_POLY_COEFF M[2][3][3];     ///< M[xi][i][j]，xi=0/1 对应 U/V，i,j=0,1,2 分别为接收点和源点分量
    LAMB3_POLY_COEFF dM[3][2][3][3]; ///< dM[k][xi][i][j]，k=0,1 为显式导数，k=2 在部分分式阶段由 -xM 生成
} LAMB3_COEFF_SET;

/** 转换项的一组预计算多项式系数 */
typedef struct {
    LAMB3_POLY_COEFF M[3][3];     ///< M[i][j]，i,j=0,1,2 分别为接收点和源点分量
    LAMB3_POLY_COEFF dM[3][3][3]; ///< dM[k][i][j]，k=0,1 为显式导数，k=2 由 -(x^2±1)M 生成
} LAMB3_CONVERSION_COEFF_SET;

static void make_lamb3_P_coefficients(const LAMB3_VARS *V, LAMB3_COEFF_SET *coeffs) {
    const real_t k = V->k;
    const real_t c_theta = V->ct_ref;
    const real_t s_theta = V->st_ref;
    const real_t c_phi = V->cf;
    const real_t s_phi = V->sf;
    const real_t k2 = k * k;
    const real_t k4 = k2 * k2;
    const real_t k6 = k4 * k2;
    const real_t k8 = k4 * k4;
    const real_t c_theta2 = c_theta * c_theta;
    const real_t s_theta2 = s_theta * s_theta;
    const real_t s_theta3 = s_theta2 * s_theta;
    const real_t c_phi2 = c_phi * c_phi;
    const real_t s_phi2 = s_phi * s_phi;
    const real_t c_phi_s_phi = c_phi * s_phi;
    const real_t c_theta_c_phi = c_theta * c_phi;
    const real_t c_theta_s_phi = c_theta * s_phi;
    const real_t c_phi2_minus_s_phi2 = (c_phi - s_phi) * (c_phi + s_phi);
    const real_t c_phi2_minus_c_theta2_s_phi2 = (c_phi - c_theta_s_phi) * (c_phi + c_theta_s_phi);
    const real_t k_minus_one_times_k_plus_one = (k - 1.0) * (k + 1.0);
    const real_t two_k2_minus_one = 2.0 * k2 - 1.0;
    const real_t two_k2_minus_one_sq = two_k2_minus_one * two_k2_minus_one;
    const real_t two_k2_minus_one_4 = two_k2_minus_one_sq * two_k2_minus_one_sq;
    const real_t k6_factor = 10.0 * k6 - 14.0 * k4 + 6.0 * k2 - 1.0;
    const real_t k4_factor = 18.0 * k4 - 16.0 * k2 + 3.0;
    const real_t k2_factor = 7.0 * k2 - 3.0;
    const real_t k4_factor_alt = 8.0 * k4 - 8.0 * k2 + 1.0;
    const real_t k4_factor_alt2 = 24.0 * k4 - 24.0 * k2 + 5.0;

    /* P 波反射项 */
    memset(coeffs, 0, sizeof(*coeffs));
    coeffs->M[0][0][0].degree = 10;
    coeffs->M[0][0][0].time_degree = 3;
    coeffs->M[0][0][0].c[0][0] = -k2 * s_phi2 * two_k2_minus_one_4;
    coeffs->M[0][0][0].c[2][0] = -c_phi2_minus_s_phi2 * two_k2_minus_one_4 / s_theta2;
    coeffs->M[0][0][0].c[1][1] = 2.0 * c_theta * c_phi2_minus_s_phi2 * two_k2_minus_one_4 / s_theta2;
    coeffs->M[0][0][0].c[0][2] =
        -(16.0 * c_phi2 * c_theta2 * k8 - 32.0 * c_phi2 * c_theta2 * k6 + 24.0 * c_phi2 * c_theta2 * k4 - 8.0 * c_phi2 * c_theta2 * k2 +
          c_phi2 * c_theta2 - 80.0 * k8 * s_phi2 * s_theta2 - 16.0 * k8 * s_phi2 + 112.0 * k6 * s_phi2 * s_theta2 + 32.0 * k6 * s_phi2 -
          48.0 * k4 * s_phi2 * s_theta2 - 24.0 * k4 * s_phi2 + 8.0 * k2 * s_phi2 * s_theta2 + 8.0 * k2 * s_phi2 - s_phi2) /
        s_theta2;
    coeffs->M[0][0][0].c[2][2] = 8.0 * c_phi2_minus_s_phi2 * k6_factor / s_theta2;
    coeffs->M[0][0][0].c[1][3] = -16.0 * c_theta * c_phi2_minus_s_phi2 * k6_factor / s_theta2;
    coeffs->M[0][0][0].c[0][4] = 8.0 *
                                 (10.0 * c_phi2 * c_theta2 * k6 - 14.0 * c_phi2 * c_theta2 * k4 + 6.0 * c_phi2 * c_theta2 * k2 - c_phi2 * c_theta2 -
                                  18.0 * k6 * s_phi2 * s_theta2 - 10.0 * k6 * s_phi2 + 16.0 * k4 * s_phi2 * s_theta2 + 14.0 * k4 * s_phi2 -
                                  3.0 * k2 * s_phi2 * s_theta2 - 6.0 * k2 * s_phi2 + s_phi2) /
                                 s_theta2;
    coeffs->M[0][0][0].c[2][4] = -8.0 * c_phi2_minus_s_phi2 * k4_factor / s_theta2;
    coeffs->M[0][0][0].c[1][5] = 16.0 * c_theta * c_phi2_minus_s_phi2 * k4_factor / s_theta2;
    coeffs->M[0][0][0].c[0][6] =
        -8.0 *
        (18.0 * c_phi2 * c_theta2 * k4 - 16.0 * c_phi2 * c_theta2 * k2 + 3.0 * c_phi2 * c_theta2 - 14.0 * k4 * s_phi2 * s_theta2 -
         18.0 * k4 * s_phi2 + 6.0 * k2 * s_phi2 * s_theta2 + 16.0 * k2 * s_phi2 - 3.0 * s_phi2) /
        s_theta2;
    coeffs->M[0][0][0].c[2][6] = 16.0 * c_phi2_minus_s_phi2 * k2_factor / s_theta2;
    coeffs->M[0][0][0].c[1][7] = -32.0 * c_theta * c_phi2_minus_s_phi2 * k2_factor / s_theta2;
    coeffs->M[0][0][0].c[0][8] =
        16.0 * (7.0 * c_phi2 * c_theta2 * k2 - 3.0 * c_phi2 * c_theta2 - 2.0 * k2 * s_phi2 * s_theta2 - 7.0 * k2 * s_phi2 + 3.0 * s_phi2) / s_theta2;
    coeffs->M[0][0][0].c[2][8] = -32.0 * c_phi2_minus_s_phi2 / s_theta2;
    coeffs->M[0][0][0].c[1][9] = 64.0 * c_theta * c_phi2_minus_s_phi2 / s_theta2;
    coeffs->M[0][0][0].c[0][10] = -32.0 * (c_theta_c_phi - s_phi) * (c_theta_c_phi + s_phi) / s_theta2;
    coeffs->dM[0][0][0][0].degree = 11;
    coeffs->dM[0][0][0][0].time_degree = 3;
    coeffs->dM[0][0][0][0].c[1][0] = -3.0 * c_phi * k2 * s_phi2 * two_k2_minus_one_4 / s_theta;
    coeffs->dM[0][0][0][0].c[3][0] = -c_phi * (c_phi2 - 3.0 * s_phi2) * two_k2_minus_one_4 / s_theta3;
    coeffs->dM[0][0][0][0].c[0][1] = 3.0 * c_theta_c_phi * k2 * s_phi2 * two_k2_minus_one_4 / s_theta;
    coeffs->dM[0][0][0][0].c[2][1] = 3.0 * c_theta_c_phi * (c_phi2 - 3.0 * s_phi2) * two_k2_minus_one_4 / s_theta3;
    coeffs->dM[0][0][0][0].c[1][2] =
        -3.0 * c_phi *
        (16.0 * c_phi2 * c_theta2 * k8 - 32.0 * c_phi2 * c_theta2 * k6 + 24.0 * c_phi2 * c_theta2 * k4 - 8.0 * c_phi2 * c_theta2 * k2 +
         c_phi2 * c_theta2 - 32.0 * c_theta2 * k8 * s_phi2 + 64.0 * c_theta2 * k6 * s_phi2 - 48.0 * c_theta2 * k4 * s_phi2 +
         16.0 * c_theta2 * k2 * s_phi2 - 2.0 * c_theta2 * s_phi2 - 80.0 * k8 * s_phi2 * s_theta2 - 16.0 * k8 * s_phi2 +
         112.0 * k6 * s_phi2 * s_theta2 + 32.0 * k6 * s_phi2 - 48.0 * k4 * s_phi2 * s_theta2 - 24.0 * k4 * s_phi2 + 8.0 * k2 * s_phi2 * s_theta2 +
         8.0 * k2 * s_phi2 - s_phi2) /
        s_theta3;
    coeffs->dM[0][0][0][0].c[3][2] = 8.0 * c_phi * (c_phi2 - 3.0 * s_phi2) * k6_factor / s_theta3;
    coeffs->dM[0][0][0][0].c[0][3] =
        c_theta_c_phi *
        (16.0 * c_phi2 * c_theta2 * k8 - 32.0 * c_phi2 * c_theta2 * k6 + 24.0 * c_phi2 * c_theta2 * k4 - 8.0 * c_phi2 * c_theta2 * k2 +
         c_phi2 * c_theta2 - 240.0 * k8 * s_phi2 * s_theta2 - 48.0 * k8 * s_phi2 + 336.0 * k6 * s_phi2 * s_theta2 + 96.0 * k6 * s_phi2 -
         144.0 * k4 * s_phi2 * s_theta2 - 72.0 * k4 * s_phi2 + 24.0 * k2 * s_phi2 * s_theta2 + 24.0 * k2 * s_phi2 - 3.0 * s_phi2) /
        s_theta3;
    coeffs->dM[0][0][0][0].c[2][3] = -24.0 * c_theta_c_phi * (c_phi2 - 3.0 * s_phi2) * k6_factor / s_theta3;
    coeffs->dM[0][0][0][0].c[1][4] =
        24.0 * c_phi *
        (10.0 * c_phi2 * c_theta2 * k6 - 14.0 * c_phi2 * c_theta2 * k4 + 6.0 * c_phi2 * c_theta2 * k2 - c_phi2 * c_theta2 -
         20.0 * c_theta2 * k6 * s_phi2 + 28.0 * c_theta2 * k4 * s_phi2 - 12.0 * c_theta2 * k2 * s_phi2 + 2.0 * c_theta2 * s_phi2 -
         18.0 * k6 * s_phi2 * s_theta2 - 10.0 * k6 * s_phi2 + 16.0 * k4 * s_phi2 * s_theta2 + 14.0 * k4 * s_phi2 - 3.0 * k2 * s_phi2 * s_theta2 -
         6.0 * k2 * s_phi2 + s_phi2) /
        s_theta3;
    coeffs->dM[0][0][0][0].c[3][4] = -8.0 * c_phi * (c_phi2 - 3.0 * s_phi2) * k4_factor / s_theta3;
    coeffs->dM[0][0][0][0].c[0][5] = -8.0 * c_theta_c_phi *
                                     (10.0 * c_phi2 * c_theta2 * k6 - 14.0 * c_phi2 * c_theta2 * k4 + 6.0 * c_phi2 * c_theta2 * k2 -
                                      c_phi2 * c_theta2 - 54.0 * k6 * s_phi2 * s_theta2 - 30.0 * k6 * s_phi2 + 48.0 * k4 * s_phi2 * s_theta2 +
                                      42.0 * k4 * s_phi2 - 9.0 * k2 * s_phi2 * s_theta2 - 18.0 * k2 * s_phi2 + 3.0 * s_phi2) /
                                     s_theta3;
    coeffs->dM[0][0][0][0].c[2][5] = 24.0 * c_theta_c_phi * (c_phi2 - 3.0 * s_phi2) * k4_factor / s_theta3;
    coeffs->dM[0][0][0][0].c[1][6] =
        -24.0 * c_phi *
        (18.0 * c_phi2 * c_theta2 * k4 - 16.0 * c_phi2 * c_theta2 * k2 + 3.0 * c_phi2 * c_theta2 - 36.0 * c_theta2 * k4 * s_phi2 +
         32.0 * c_theta2 * k2 * s_phi2 - 6.0 * c_theta2 * s_phi2 - 14.0 * k4 * s_phi2 * s_theta2 - 18.0 * k4 * s_phi2 + 6.0 * k2 * s_phi2 * s_theta2 +
         16.0 * k2 * s_phi2 - 3.0 * s_phi2) /
        s_theta3;
    coeffs->dM[0][0][0][0].c[3][6] = 16.0 * c_phi * (c_phi2 - 3.0 * s_phi2) * k2_factor / s_theta3;
    coeffs->dM[0][0][0][0].c[0][7] =
        8.0 * c_theta_c_phi *
        (18.0 * c_phi2 * c_theta2 * k4 - 16.0 * c_phi2 * c_theta2 * k2 + 3.0 * c_phi2 * c_theta2 - 42.0 * k4 * s_phi2 * s_theta2 -
         54.0 * k4 * s_phi2 + 18.0 * k2 * s_phi2 * s_theta2 + 48.0 * k2 * s_phi2 - 9.0 * s_phi2) /
        s_theta3;
    coeffs->dM[0][0][0][0].c[2][7] = -48.0 * c_theta_c_phi * (c_phi2 - 3.0 * s_phi2) * k2_factor / s_theta3;
    coeffs->dM[0][0][0][0].c[1][8] = 48.0 * c_phi *
                                     (7.0 * c_phi2 * c_theta2 * k2 - 3.0 * c_phi2 * c_theta2 - 14.0 * c_theta2 * k2 * s_phi2 +
                                      6.0 * c_theta2 * s_phi2 - 2.0 * k2 * s_phi2 * s_theta2 - 7.0 * k2 * s_phi2 + 3.0 * s_phi2) /
                                     s_theta3;
    coeffs->dM[0][0][0][0].c[3][8] = -32.0 * c_phi * (c_phi2 - 3.0 * s_phi2) / s_theta3;
    coeffs->dM[0][0][0][0].c[0][9] =
        -16.0 * c_theta_c_phi *
        (7.0 * c_phi2 * c_theta2 * k2 - 3.0 * c_phi2 * c_theta2 - 6.0 * k2 * s_phi2 * s_theta2 - 21.0 * k2 * s_phi2 + 9.0 * s_phi2) / s_theta3;
    coeffs->dM[0][0][0][0].c[2][9] = 96.0 * c_theta_c_phi * (c_phi2 - 3.0 * s_phi2) / s_theta3;
    coeffs->dM[0][0][0][0].c[1][10] = -96.0 * c_phi * (c_phi2 * c_theta2 - 2.0 * c_theta2 * s_phi2 - s_phi2) / s_theta3;
    coeffs->dM[0][0][0][0].c[0][11] = 32.0 * c_theta_c_phi * (c_phi2 * c_theta2 - 3.0 * s_phi2) / s_theta3;
    coeffs->dM[1][0][0][0].degree = 11;
    coeffs->dM[1][0][0][0].time_degree = 3;
    coeffs->dM[1][0][0][0].c[1][0] = -k2 * s_phi * two_k2_minus_one_4 * (3.0 * s_phi2 - 2.0) / s_theta;
    coeffs->dM[1][0][0][0].c[3][0] = -s_phi * two_k2_minus_one_4 * (c_phi2 - 3.0 * s_phi2 + 2.0) / s_theta3;
    coeffs->dM[1][0][0][0].c[0][1] = c_theta * k2 * s_phi * two_k2_minus_one_4 * (3.0 * s_phi2 - 2.0) / s_theta;
    coeffs->dM[1][0][0][0].c[2][1] = 3.0 * c_theta_s_phi * two_k2_minus_one_4 * (c_phi2 - 3.0 * s_phi2 + 2.0) / s_theta3;
    coeffs->dM[1][0][0][0].c[1][2] =
        -s_phi *
        (48.0 * c_phi2 * c_theta2 * k8 - 96.0 * c_phi2 * c_theta2 * k6 + 72.0 * c_phi2 * c_theta2 * k4 - 24.0 * c_phi2 * c_theta2 * k2 +
         3.0 * c_phi2 * c_theta2 - 96.0 * c_theta2 * k8 * s_phi2 + 64.0 * c_theta2 * k8 + 192.0 * c_theta2 * k6 * s_phi2 - 128.0 * c_theta2 * k6 -
         144.0 * c_theta2 * k4 * s_phi2 + 96.0 * c_theta2 * k4 + 48.0 * c_theta2 * k2 * s_phi2 - 32.0 * c_theta2 * k2 - 6.0 * c_theta2 * s_phi2 +
         4.0 * c_theta2 - 240.0 * k8 * s_phi2 * s_theta2 - 48.0 * k8 * s_phi2 + 160.0 * k8 * s_theta2 + 32.0 * k8 + 336.0 * k6 * s_phi2 * s_theta2 +
         96.0 * k6 * s_phi2 - 224.0 * k6 * s_theta2 - 64.0 * k6 - 144.0 * k4 * s_phi2 * s_theta2 - 72.0 * k4 * s_phi2 + 96.0 * k4 * s_theta2 +
         48.0 * k4 + 24.0 * k2 * s_phi2 * s_theta2 + 24.0 * k2 * s_phi2 - 16.0 * k2 * s_theta2 - 16.0 * k2 - 3.0 * s_phi2 + 2.0) /
        s_theta3;
    coeffs->dM[1][0][0][0].c[3][2] = 8.0 * s_phi * (c_phi2 - 3.0 * s_phi2 + 2.0) * k6_factor / s_theta3;
    coeffs->dM[1][0][0][0].c[0][3] =
        c_theta_s_phi *
        (16.0 * c_phi2 * c_theta2 * k8 - 32.0 * c_phi2 * c_theta2 * k6 + 24.0 * c_phi2 * c_theta2 * k4 - 8.0 * c_phi2 * c_theta2 * k2 +
         c_phi2 * c_theta2 - 240.0 * k8 * s_phi2 * s_theta2 - 48.0 * k8 * s_phi2 + 160.0 * k8 * s_theta2 + 32.0 * k8 +
         336.0 * k6 * s_phi2 * s_theta2 + 96.0 * k6 * s_phi2 - 224.0 * k6 * s_theta2 - 64.0 * k6 - 144.0 * k4 * s_phi2 * s_theta2 -
         72.0 * k4 * s_phi2 + 96.0 * k4 * s_theta2 + 48.0 * k4 + 24.0 * k2 * s_phi2 * s_theta2 + 24.0 * k2 * s_phi2 - 16.0 * k2 * s_theta2 -
         16.0 * k2 - 3.0 * s_phi2 + 2.0) /
        s_theta3;
    coeffs->dM[1][0][0][0].c[2][3] = -24.0 * c_theta_s_phi * (c_phi2 - 3.0 * s_phi2 + 2.0) * k6_factor / s_theta3;
    coeffs->dM[1][0][0][0].c[1][4] =
        8.0 * s_phi *
        (30.0 * c_phi2 * c_theta2 * k6 - 42.0 * c_phi2 * c_theta2 * k4 + 18.0 * c_phi2 * c_theta2 * k2 - 3.0 * c_phi2 * c_theta2 -
         60.0 * c_theta2 * k6 * s_phi2 + 40.0 * c_theta2 * k6 + 84.0 * c_theta2 * k4 * s_phi2 - 56.0 * c_theta2 * k4 - 36.0 * c_theta2 * k2 * s_phi2 +
         24.0 * c_theta2 * k2 + 6.0 * c_theta2 * s_phi2 - 4.0 * c_theta2 - 54.0 * k6 * s_phi2 * s_theta2 - 30.0 * k6 * s_phi2 + 36.0 * k6 * s_theta2 +
         20.0 * k6 + 48.0 * k4 * s_phi2 * s_theta2 + 42.0 * k4 * s_phi2 - 32.0 * k4 * s_theta2 - 28.0 * k4 - 9.0 * k2 * s_phi2 * s_theta2 -
         18.0 * k2 * s_phi2 + 6.0 * k2 * s_theta2 + 12.0 * k2 + 3.0 * s_phi2 - 2.0) /
        s_theta3;
