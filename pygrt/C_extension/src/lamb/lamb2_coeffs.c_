/**
 * @file   lamb2_coeffs.c_
 * @author Zhu Dengda (zhudengda@mail.iggcas.ac.cn)
 * @date   2026-08
 *
 *    第二类 Lamb 问题的多项式系数构造
 *
 *    本文件中的 M、N 以及一阶导数系数直接按第七章表 7.2.1、表 7.2.2、
 *    表 7.3.1 和表 7.3.2 构造，混合二阶导数则在同一组谱域分子上同时施加
 *    接收点和源点导数因子；多项式运算只负责把书中的因子相乘、相加，并按
 *    x 和 tbar 保存系数
 */

#include <string.h>

#include "grt/common/const.h"
#include "grt/lamb/lamb_poly.h"


#define LAMB2_PF_TBAR_SIZE 5


/** 与材料、角度和 Rayleigh 根有关的常量 */
typedef struct {
    real_t nu;                              ///< 泊松比 nu
    real_t k;                               ///< P、S 波速比 k=beta/alpha
    real_t k2;                              ///< k^2
    real_t kp;                              ///< k'=sqrt(1-k^2)
    real_t kp2;                             ///< k'^2=1-k^2
    real_t theta;                           ///< 直接波射线角 theta=atan2(R,depsrc)
    real_t phi;                             ///< 水平面方位角 phi
    real_t st;                              ///< sin(theta)
    real_t ct;                              ///< cos(theta)
    real_t sf;                              ///< sin(phi)
    real_t cf;                              ///< cos(phi)
    real_t theta_c;                         ///< 临界角 theta_c=asin(k)
    real_t tSP;                               ///< SP 项的归一化到时 cos(theta-theta_c)
    real_t angle_ratio;                      ///< sf/cf，|cf| 过小时为 0
    bool use_angle_ratio;                    ///< |cf| 是否足够大，可用 sf/cf 复用分量
    bool supercritical;                      ///< 射线角是否超过临界角
    cplx_t rayleigh_roots[3];                ///< Rayleigh 分母的三个根 y_i，i=0,1,2
    cplx_t shifted_rayleigh_roots[3];         ///< 平移后的根 y_i-k'^2，i=0,1,2
} LAMB2_VARS;


/** 一类积分项所需的预计算多项式系数 */
typedef struct {
    LAMB_TBAR_X_POLY M[2][3][3];                  ///< M[xi][i][j]，xi=0/1 对应 U/V
    LAMB_TBAR_X_POLY dMs[2][3][3][3];             ///< dMs[xi][kp][i][j]，源点坐标导数
    LAMB_TBAR_X_POLY receiver_vertical[2][3];    ///< receiver_vertical[xi][j] 是接收点竖向导数的 [2][j] 分量
    LAMB_TBAR_X_POLY d2M[2][3][3][3][3];          ///< d2M[xi][k][kp][i][j]，混合导数的积分分子
} LAMB2_COEFF_SET;


/** 书中变量代换后的公共多项式 */
typedef struct {
    LAMB_TBAR_X_POLY x;                 ///< 积分变量 x
    LAMB_TBAR_X_POLY x2;                ///< x^2
    LAMB_TBAR_X_POLY qbar;              ///< qbar=(x*cos(theta)-tbar)/sin(theta)
    LAMB_TBAR_X_POLY qbar2;             ///< qbar^2
    LAMB_TBAR_X_POLY pbar2;             ///< pbar^2
    LAMB_TBAR_X_POLY g;                 ///< P 项中的 g=x^2-k^2
    LAMB_TBAR_X_POLY g_prime;           ///< S 项中的 g'=x^2-1
    LAMB_TBAR_X_POLY eta_alpha2;        ///< eta_alpha^2
    LAMB_TBAR_X_POLY eta_beta2;         ///< eta_beta^2
    LAMB_TBAR_X_POLY eta_other2;        ///< 未选作 x 的互补垂向根的平方
    LAMB_TBAR_X_POLY gamma;             ///< gamma
    LAMB_TBAR_X_POLY epsilon;           ///< epsilon
    LAMB_TBAR_X_POLY bar_epsilon;       ///< bar_epsilon
    LAMB_TBAR_X_POLY zeta;              ///< zeta
    LAMB_TBAR_X_POLY kappa;             ///< kappa
    LAMB_TBAR_X_POLY bar_kappa;         ///< bar_kappa
    LAMB_TBAR_X_POLY kappa_prime;       ///< kappa'=kappa+2*pbar^2
    LAMB_TBAR_X_POLY bar_kappa_prime;   ///< bar_kappa'=bar_kappa+2*pbar^2
    LAMB_TBAR_X_POLY w;                 ///< w=qbar^2-pbar^2=-g 或 -g'
    LAMB_TBAR_X_POLY h;                 ///< h=eta_beta^2-w
} LAMB2_GEOMETRY;


/** de-Hoop 变换后 xi_1^a*xi_2^b 的 p 偶部因子 */
typedef struct {
    LAMB_TBAR_X_POLY xi[5][5];           ///< xi[a][b] 是 xi_1^a*xi_2^b 的 p 偶部
} LAMB2_DEHOOP_FACTORS;


/** 关于互补垂向根 y 的两项表达式 A_even+y*A_odd */
typedef struct {
    LAMB_TBAR_X_POLY even;               ///< 不含 y 的部分
    LAMB_TBAR_X_POLY odd;                ///< y 的系数
} LAMB2_ROOT_POLY;


/** 构造 P 波或 S 波的书中变量 */
static void lamb2_make_geometry(const LAMB2_VARS *V, const bool s_wave, LAMB2_GEOMETRY *G)
{
    const real_t k2 = V->k2;
    const real_t c_theta = V->ct;
    const real_t s_theta = V->st;
    const real_t c_phi = V->cf;
    const real_t s_phi = V->sf;
    const real_t s_theta2 = s_theta * s_theta;
    const real_t c_phi2 = c_phi * c_phi;
    const real_t s_phi2 = s_phi * s_phi;

    LAMB_TBAR_X_POLY one;
    LAMB_TBAR_X_POLY tbar;
    LAMB_TBAR_X_POLY tbar2;
    LAMB_TBAR_X_POLY xt;
    LAMB_TBAR_X_POLY constant;
    LAMB_TBAR_X_POLY term1;
    LAMB_TBAR_X_POLY term2;
    LAMB_TBAR_X_POLY sum;

    memset(G, 0, sizeof(*G));
    grt_lamb_tbar_x_poly_const(&one, 1.0);
    grt_lamb_tbar_x_poly_x(&G->x);
    grt_lamb_tbar_x_poly_mul(&G->x, &G->x, &G->x2);
    grt_lamb_tbar_x_poly_tbar(&tbar);
    grt_lamb_tbar_x_poly_mul(&tbar, &tbar, &tbar2);
    grt_lamb_tbar_x_poly_mul(&G->x, &tbar, &xt);

    /* 式 (7.2.1) 和式 (7.3.1) 中的 qbar 与 pbar^2 */
    grt_lamb_tbar_x_poly_scale(&G->x, c_theta, &G->qbar);
    grt_lamb_tbar_x_poly_add_scaled(&G->qbar, -1.0, &tbar, &G->qbar);
    grt_lamb_tbar_x_poly_scale(&G->qbar, 1.0 / s_theta, &G->qbar);
    grt_lamb_tbar_x_poly_mul(&G->qbar, &G->qbar, &G->qbar2);

    G->pbar2 = G->x2;
    grt_lamb_tbar_x_poly_add_scaled(&G->pbar2, -2.0 * c_theta, &xt, &G->pbar2);
    grt_lamb_tbar_x_poly_add(&G->pbar2, &tbar2, &G->pbar2);
    grt_lamb_tbar_x_poly_const(&constant, s_wave ? s_theta2 : k2 * s_theta2);
    grt_lamb_tbar_x_poly_add_scaled(&G->pbar2, -1.0, &constant, &G->pbar2);
    grt_lamb_tbar_x_poly_scale(&G->pbar2, 1.0 / s_theta2, &G->pbar2);

    if (s_wave) {
        /* S 项取 x=eta_beta，g'=x^2-1 */
        G->g_prime = G->x2;
        grt_lamb_tbar_x_poly_add_scaled(&G->g_prime, -1.0, &one, &G->g_prime);
        G->eta_beta2 = G->x2;
        G->eta_alpha2 = G->x2;
        grt_lamb_tbar_x_poly_const(&constant, k2 - 1.0);
        grt_lamb_tbar_x_poly_add(&G->eta_alpha2, &constant, &G->eta_alpha2);
        G->eta_other2 = G->eta_alpha2;

        grt_lamb_tbar_x_poly_scale(&G->x2, 2.0, &G->gamma);
        grt_lamb_tbar_x_poly_add_scaled(&G->gamma, -1.0, &one, &G->gamma);
        grt_lamb_tbar_x_poly_scale(&G->g_prime, -1.0, &G->w);
    } else {
        /* P 项取 x=eta_alpha，g=x^2-k^2 */
        G->g = G->x2;
        grt_lamb_tbar_x_poly_const(&constant, k2);
        grt_lamb_tbar_x_poly_add_scaled(&G->g, -1.0, &constant, &G->g);
        G->eta_alpha2 = G->x2;
        G->eta_beta2 = G->x2;
        grt_lamb_tbar_x_poly_const(&constant, 1.0 - k2);
        grt_lamb_tbar_x_poly_add(&G->eta_beta2, &constant, &G->eta_beta2);
        G->eta_other2 = G->eta_beta2;

        grt_lamb_tbar_x_poly_scale(&G->x2, 2.0, &G->gamma);
        grt_lamb_tbar_x_poly_const(&constant, 1.0 - 2.0 * k2);
        grt_lamb_tbar_x_poly_add(&G->gamma, &constant, &G->gamma);
        grt_lamb_tbar_x_poly_scale(&G->g, -1.0, &G->w);
    }

    G->h = G->eta_beta2;
    grt_lamb_tbar_x_poly_add_scaled(&G->h, -1.0, &G->w, &G->h);

    /* 式 (7.1.3g)--(7.1.3h) 中的角度组合 */
    grt_lamb_tbar_x_poly_scale(&G->qbar2, c_phi2, &term1);
    grt_lamb_tbar_x_poly_scale(&G->pbar2, -s_phi2, &term2);
    grt_lamb_tbar_x_poly_add(&term1, &term2, &G->epsilon);

    grt_lamb_tbar_x_poly_scale(&G->qbar2, s_phi2, &term1);
    grt_lamb_tbar_x_poly_scale(&G->pbar2, -c_phi2, &term2);
    grt_lamb_tbar_x_poly_add(&term1, &term2, &G->bar_epsilon);

    grt_lamb_tbar_x_poly_add(&G->qbar2, &G->pbar2, &sum);
    grt_lamb_tbar_x_poly_scale(&sum, s_phi * c_phi, &G->zeta);

    grt_lamb_tbar_x_poly_scale(&G->qbar2, c_phi2, &term1);
    grt_lamb_tbar_x_poly_scale(&G->pbar2, -3.0 * s_phi2, &term2);
    grt_lamb_tbar_x_poly_add(&term1, &term2, &G->kappa);

    grt_lamb_tbar_x_poly_scale(&G->qbar2, s_phi2, &term1);
    grt_lamb_tbar_x_poly_scale(&G->pbar2, -3.0 * c_phi2, &term2);
    grt_lamb_tbar_x_poly_add(&term1, &term2, &G->bar_kappa);

    grt_lamb_tbar_x_poly_add_scaled(&G->kappa, 2.0, &G->pbar2, &G->kappa_prime);
    grt_lamb_tbar_x_poly_add_scaled(&G->bar_kappa, 2.0, &G->pbar2, &G->bar_kappa_prime);
}


/** 构造式 (7.3.1) 中的 f1(z) */
static void lamb2_make_f1(const LAMB2_GEOMETRY *G, const LAMB_TBAR_X_POLY *gamma3,
                          const LAMB_TBAR_X_POLY *z, LAMB_TBAR_X_POLY *result)
{
    LAMB_TBAR_X_POLY x2_minus_z;
    LAMB_TBAR_X_POLY first;
    LAMB_TBAR_X_POLY second;

    grt_lamb_tbar_x_poly_add_scaled(&G->x2, -1.0, z, &x2_minus_z);
    grt_lamb_tbar_x_poly_mul(&x2_minus_z, gamma3, &first);
    grt_lamb_tbar_x_poly_product4_scaled(&G->x2, &G->g_prime, &G->eta_alpha2, z, 16.0, &second);
    grt_lamb_tbar_x_poly_add(&first, &second, result);
}


/** 构造式 (7.3.1) 中的 f2(z) */
static void lamb2_make_f2(const LAMB2_GEOMETRY *G, const LAMB_TBAR_X_POLY *z,
                          LAMB_TBAR_X_POLY *result)
{
    LAMB_TBAR_X_POLY x2_minus_z;
    LAMB_TBAR_X_POLY first;
    LAMB_TBAR_X_POLY second;

    grt_lamb_tbar_x_poly_add_scaled(&G->x2, -1.0, z, &x2_minus_z);
    grt_lamb_tbar_x_poly_mul(&G->g_prime, &x2_minus_z, &first);
    grt_lamb_tbar_x_poly_mul(&G->gamma, z, &second);
    grt_lamb_tbar_x_poly_add(&first, &second, result);
}


/** 按自由表面关系构造接收点竖向导数最后一行 */
static void lamb2_make_receiver_vertical(const LAMB2_GEOMETRY *G, const LAMB2_VARS *V,
                                          const bool s_wave, LAMB_TBAR_X_POLY receiver_vertical[2][3])
{
    const real_t chi = 1.0 - 2.0 * V->k2;
    const real_t c_phi = V->cf;
    const real_t s_phi = V->sf;
    const LAMB_TBAR_X_POLY *g = s_wave ? &G->g_prime : &G->g;
    const LAMB_TBAR_X_POLY *q2_minus_p2 = &G->w;
    LAMB_TBAR_X_POLY gamma2;
    LAMB_TBAR_X_POLY gamma3;
    LAMB_TBAR_X_POLY g2;
    LAMB_TBAR_X_POLY x3;

    grt_lamb_tbar_x_poly_mul(&G->gamma, &G->gamma, &gamma2);
    grt_lamb_tbar_x_poly_mul(&gamma2, &G->gamma, &gamma3);
    grt_lamb_tbar_x_poly_mul(g, g, &g2);
    grt_lamb_tbar_x_poly_mul(&G->x2, &G->x, &x3);

    for (int xi = 0; xi < 2; ++xi) {
        LAMB_TBAR_X_POLY common;
        LAMB_TBAR_X_POLY last;

        if (!s_wave && xi == 0) {
            /* 接收点竖向导数的新增公式，来自式 (7.2.3a)--(7.2.3b) 与自由表面条件 */
            grt_lamb_tbar_x_poly_product5_scaled(&G->x2, g, &G->eta_beta2, &G->qbar, q2_minus_p2,
                                       -8.0 * chi, &common);
            grt_lamb_tbar_x_poly_product4_scaled(&x3, g, &G->eta_beta2, q2_minus_p2,
                                       -8.0 * chi, &last);
        } else if (!s_wave) {
            grt_lamb_tbar_x_poly_product5_scaled(&G->x, &G->qbar, &G->eta_beta2, &gamma2, q2_minus_p2,
                                       -2.0 * chi, &common);
            grt_lamb_tbar_x_poly_product4_scaled(&G->x2, &G->eta_beta2, &gamma2, q2_minus_p2,
                                       -2.0 * chi, &last);
        } else if (xi == 0) {
            grt_lamb_tbar_x_poly_product3_scaled(&G->x2, &G->qbar, &gamma3, -chi, &common);
            grt_lamb_tbar_x_poly_product3_scaled(&G->x, &gamma3, q2_minus_p2, chi, &last);
        } else {
            grt_lamb_tbar_x_poly_product5_scaled(&x3, g, &G->eta_alpha2, &G->gamma, &G->qbar,
                                       -4.0 * chi, &common);
            grt_lamb_tbar_x_poly_product5_scaled(&G->x2, g, &G->eta_alpha2, &G->gamma, q2_minus_p2,
                                       4.0 * chi, &last);
        }

        grt_lamb_tbar_x_poly_scale(&common, c_phi, &receiver_vertical[xi][0]);
        grt_lamb_tbar_x_poly_scale(&common, s_phi, &receiver_vertical[xi][1]);
        receiver_vertical[xi][2] = last;
    }
}


/** 构造源点导数以及接收点竖向边界分子 */
static void lamb2_make_derivative_coefficients(const LAMB2_GEOMETRY *G, const LAMB2_VARS *V,
                                                const bool s_wave, LAMB2_COEFF_SET *coeffs)
{
    for (int xi = 0; xi < 2; ++xi) {
        for (int i = 0; i < 3; ++i) {
            for (int j = 0; j < 3; ++j) {
                grt_lamb_tbar_x_poly_product2_scaled(&G->x, &coeffs->M[xi][i][j], -1.0,
                                           &coeffs->dMs[xi][2][i][j]);
            }
        }
    }

    lamb2_make_receiver_vertical(G, V, s_wave, coeffs->receiver_vertical);
}


/*
 * 混合二阶导数先在变换前同时乘接收点和源点导数因子，再进行 de-Hoop 变换
 * 下面的 X[a][b] 是 xi_1^a*xi_2^b 的 p 偶部，所有结果都直接写成 U/V 两组分子
 */


/** 构造 de-Hoop 变换后所需的 xi 乘积因子 */
static void lamb2_make_dehoop_factors(const LAMB2_GEOMETRY *G, const LAMB2_VARS *V,
                                      LAMB2_DEHOOP_FACTORS *factors)
{
    const real_t c_phi = V->cf;
    const real_t s_phi = V->sf;
    const real_t c_phi2 = c_phi * c_phi;
    const real_t s_phi2 = s_phi * s_phi;
    const real_t c_phi_s_phi = c_phi * s_phi;
    const real_t c_phi2_minus_s_phi2 = c_phi2 - s_phi2;

    LAMB_TBAR_X_POLY term1;
    LAMB_TBAR_X_POLY term2;

    memset(factors, 0, sizeof(*factors));
    grt_lamb_tbar_x_poly_const(&factors->xi[0][0], 1.0);

    /* X10、X01 */
    grt_lamb_tbar_x_poly_scale(&G->qbar, c_phi, &factors->xi[1][0]);
    grt_lamb_tbar_x_poly_scale(&G->qbar, s_phi, &factors->xi[0][1]);

    /* X20、X11、X02 */
    factors->xi[2][0] = G->epsilon;
    factors->xi[1][1] = G->zeta;
    factors->xi[0][2] = G->bar_epsilon;

    /* X30、X21、X12、X03 */
    grt_lamb_tbar_x_poly_product2_scaled(&G->qbar, &G->kappa, c_phi, &factors->xi[3][0]);
    grt_lamb_tbar_x_poly_product2_scaled(&G->qbar, &G->kappa_prime, s_phi, &factors->xi[2][1]);
    grt_lamb_tbar_x_poly_product2_scaled(&G->qbar, &G->bar_kappa_prime, c_phi, &factors->xi[1][2]);
    grt_lamb_tbar_x_poly_product2_scaled(&G->qbar, &G->bar_kappa, s_phi, &factors->xi[0][3]);

    /* X40 */
    grt_lamb_tbar_x_poly_mul(&G->epsilon, &G->epsilon, &term1);
    grt_lamb_tbar_x_poly_product2_scaled(&G->qbar2, &G->pbar2,
                               4.0 * c_phi2 * s_phi2, &term2);
    grt_lamb_tbar_x_poly_add_scaled(&term1, -1.0, &term2, &factors->xi[4][0]);

    /* X31 */
    grt_lamb_tbar_x_poly_mul(&G->epsilon, &G->zeta, &term1);
    grt_lamb_tbar_x_poly_product2_scaled(&G->qbar2, &G->pbar2,
                               2.0 * c_phi_s_phi * c_phi2_minus_s_phi2, &term2);
    grt_lamb_tbar_x_poly_add(&term1, &term2, &factors->xi[3][1]);

    /* X22 */
    grt_lamb_tbar_x_poly_mul(&G->zeta, &G->zeta, &term1);
    grt_lamb_tbar_x_poly_product2_scaled(&G->qbar2, &G->pbar2,
                               c_phi2_minus_s_phi2 * c_phi2_minus_s_phi2, &term2);
    grt_lamb_tbar_x_poly_add_scaled(&term1, -1.0, &term2, &factors->xi[2][2]);

    /* X13 */
    grt_lamb_tbar_x_poly_mul(&G->zeta, &G->bar_epsilon, &term1);
    grt_lamb_tbar_x_poly_product2_scaled(&G->qbar2, &G->pbar2,
                               2.0 * c_phi_s_phi * c_phi2_minus_s_phi2, &term2);
    grt_lamb_tbar_x_poly_add_scaled(&term1, -1.0, &term2, &factors->xi[1][3]);

    /* X04 */
    grt_lamb_tbar_x_poly_mul(&G->bar_epsilon, &G->bar_epsilon, &term1);
    grt_lamb_tbar_x_poly_product2_scaled(&G->qbar2, &G->pbar2,
                               4.0 * c_phi2 * s_phi2, &term2);
    grt_lamb_tbar_x_poly_add_scaled(&term1, -1.0, &term2, &factors->xi[0][4]);
}


/** 清空一个关于互补垂向根的两项表达式 */
static void lamb2_root_zero(LAMB2_ROOT_POLY *value)
{
    grt_lamb_tbar_x_poly_zero(&value->even);
    grt_lamb_tbar_x_poly_zero(&value->odd);
}


/** 相加两个关于互补垂向根的两项表达式 */
static void lamb2_root_add(const LAMB2_ROOT_POLY *left, const LAMB2_ROOT_POLY *right,
                           LAMB2_ROOT_POLY *result)
{
    grt_lamb_tbar_x_poly_add(&left->even, &right->even, &result->even);
    grt_lamb_tbar_x_poly_add(&left->odd, &right->odd, &result->odd);
}


/** 缩放一个关于互补垂向根的两项表达式 */
static void lamb2_root_scale(const LAMB2_ROOT_POLY *source, const real_t scale,
                             LAMB2_ROOT_POLY *result)
{
    grt_lamb_tbar_x_poly_scale(&source->even, scale, &result->even);
    grt_lamb_tbar_x_poly_scale(&source->odd, scale, &result->odd);
}


/** 乘以一个不含互补垂向根的多项式 */
static void lamb2_root_scale_poly(const LAMB2_ROOT_POLY *source,
                                  const LAMB_TBAR_X_POLY *factor, const real_t scale,
                                  LAMB2_ROOT_POLY *result)
{
    grt_lamb_tbar_x_poly_product2_scaled(&source->even, factor, scale, &result->even);
    grt_lamb_tbar_x_poly_product2_scaled(&source->odd, factor, scale, &result->odd);
}


/** 相乘两个关于互补垂向根的两项表达式并约去 y^2 */
static void lamb2_root_mul(const LAMB2_ROOT_POLY *left, const LAMB2_ROOT_POLY *right,
                           const LAMB_TBAR_X_POLY *eta_other2, LAMB2_ROOT_POLY *result)
{
    LAMB_TBAR_X_POLY even_even;
    LAMB_TBAR_X_POLY odd_odd;
    LAMB_TBAR_X_POLY odd_odd_reduced;
    LAMB_TBAR_X_POLY even_odd;
    LAMB_TBAR_X_POLY odd_even;

    grt_lamb_tbar_x_poly_mul(&left->even, &right->even, &even_even);
    grt_lamb_tbar_x_poly_mul(&left->odd, &right->odd, &odd_odd);
    grt_lamb_tbar_x_poly_mul(&odd_odd, eta_other2, &odd_odd_reduced);
    grt_lamb_tbar_x_poly_add(&even_even, &odd_odd_reduced, &result->even);

    grt_lamb_tbar_x_poly_mul(&left->even, &right->odd, &even_odd);
    grt_lamb_tbar_x_poly_mul(&left->odd, &right->even, &odd_even);
    grt_lamb_tbar_x_poly_add(&even_odd, &odd_even, &result->odd);
}


/** 构造 P 项一个导数方向组合的 3×3 分子矩阵 */
/* a、b 表示 de-Hoop 因子中的 xi_1、xi_2 次数，u_power 和 v_power 表示对应的 x 次数 */
static void lamb2_make_P_d2_matrix(const LAMB2_DEHOOP_FACTORS *factors,
                                   const LAMB_TBAR_X_POLY x_power[5], const int a, const int b,
                                   const int u_power[3][3], const int v_power[3][3],
                                   const LAMB_TBAR_X_POLY *top_u, const LAMB_TBAR_X_POLY *top_v,
                                   const LAMB_TBAR_X_POLY *bottom_u, const LAMB_TBAR_X_POLY *bottom_v,
                                   LAMB_TBAR_X_POLY u[3][3], LAMB_TBAR_X_POLY v[3][3])
{
    grt_lamb_tbar_x_poly_product3(top_u, &x_power[u_power[0][0]], &factors->xi[a + 2][b], &u[0][0]);
    grt_lamb_tbar_x_poly_product3(top_u, &x_power[u_power[0][1]], &factors->xi[a + 1][b + 1], &u[0][1]);
    grt_lamb_tbar_x_poly_product3(top_u, &x_power[u_power[0][2]], &factors->xi[a + 1][b], &u[0][2]);
    grt_lamb_tbar_x_poly_product3(top_u, &x_power[u_power[1][0]], &factors->xi[a + 1][b + 1], &u[1][0]);
    grt_lamb_tbar_x_poly_product3(top_u, &x_power[u_power[1][1]], &factors->xi[a][b + 2], &u[1][1]);
    grt_lamb_tbar_x_poly_product3(top_u, &x_power[u_power[1][2]], &factors->xi[a][b + 1], &u[1][2]);
    grt_lamb_tbar_x_poly_product3(bottom_u, &x_power[u_power[2][0]], &factors->xi[a + 1][b], &u[2][0]);
    grt_lamb_tbar_x_poly_product3(bottom_u, &x_power[u_power[2][1]], &factors->xi[a][b + 1], &u[2][1]);
    grt_lamb_tbar_x_poly_product3(bottom_u, &x_power[u_power[2][2]], &factors->xi[a][b], &u[2][2]);

    grt_lamb_tbar_x_poly_product3(top_v, &x_power[v_power[0][0]], &factors->xi[a + 2][b], &v[0][0]);
    grt_lamb_tbar_x_poly_product3(top_v, &x_power[v_power[0][1]], &factors->xi[a + 1][b + 1], &v[0][1]);
    grt_lamb_tbar_x_poly_product3(top_v, &x_power[v_power[0][2]], &factors->xi[a + 1][b], &v[0][2]);
    grt_lamb_tbar_x_poly_product3(top_v, &x_power[v_power[1][0]], &factors->xi[a + 1][b + 1], &v[1][0]);
    grt_lamb_tbar_x_poly_product3(top_v, &x_power[v_power[1][1]], &factors->xi[a][b + 2], &v[1][1]);
    grt_lamb_tbar_x_poly_product3(top_v, &x_power[v_power[1][2]], &factors->xi[a][b + 1], &v[1][2]);
    grt_lamb_tbar_x_poly_product3(bottom_v, &x_power[v_power[2][0]], &factors->xi[a + 1][b], &v[2][0]);
    grt_lamb_tbar_x_poly_product3(bottom_v, &x_power[v_power[2][1]], &factors->xi[a][b + 1], &v[2][1]);
    grt_lamb_tbar_x_poly_product3(bottom_v, &x_power[v_power[2][2]], &factors->xi[a][b], &v[2][2]);
}


/** 保存或复用一组 U/V 分子矩阵 */
static void lamb2_copy_d2_matrix(LAMB_TBAR_X_POLY target_u[3][3],
                                 LAMB_TBAR_X_POLY target_v[3][3],
                                 const LAMB_TBAR_X_POLY source_u[3][3],
                                 const LAMB_TBAR_X_POLY source_v[3][3])
{
    for (int i = 0; i < 3; ++i) {
        for (int j = 0; j < 3; ++j) {
            target_u[i][j] = source_u[i][j];
            target_v[i][j] = source_v[i][j];
        }
    }
}


/**
 * 按 P 项的接收点、源点导数因子构造混合二阶导数分子
 * 先由第 7.1 节的方向导数关系确定因子，再沿用第 7.2 节表中的 U/V 分解结构
 */
static void lamb2_make_P_d2_coefficients(const LAMB2_GEOMETRY *G, const LAMB2_VARS *V,
                                          LAMB2_COEFF_SET *coeffs)
{
    /* hh、hv、vh、vv 分别表示水平-水平、水平-竖向、竖向-水平和竖向-竖向 */
    static const int hh_u[3][3] = {{2, 2, 3}, {2, 2, 3}, {1, 1, 2}};
    static const int hh_v[3][3] = {{1, 1, 2}, {1, 1, 2}, {2, 2, 3}};
    static const int hv_u[3][3] = {{3, 3, 4}, {3, 3, 4}, {2, 2, 3}};
    static const int hv_v[3][3] = {{2, 2, 3}, {2, 2, 3}, {3, 3, 4}};
    static const int vh_u[3][3] = {{1, 1, 2}, {1, 1, 2}, {2, 2, 3}};
    static const int vh_v[3][3] = {{2, 2, 3}, {2, 2, 3}, {1, 1, 2}};
    static const int vv_u[3][3] = {{2, 2, 3}, {2, 2, 3}, {3, 3, 4}};
    static const int vv_v[3][3] = {{3, 3, 4}, {3, 3, 4}, {2, 2, 3}};

    LAMB2_DEHOOP_FACTORS factors;
    LAMB_TBAR_X_POLY x_power[5];
    LAMB_TBAR_X_POLY h2;
    LAMB_TBAR_X_POLY h3;
    LAMB_TBAR_X_POLY w2;
    LAMB_TBAR_X_POLY h_plus_2w;
    LAMB_TBAR_X_POLY two_eta_other2_minus_h;
    LAMB_TBAR_X_POLY two_x2_minus_h;
    LAMB_TBAR_X_POLY top_h_u;
    LAMB_TBAR_X_POLY top_h_v;
    LAMB_TBAR_X_POLY bottom_h_u;
    LAMB_TBAR_X_POLY bottom_h_v;
    LAMB_TBAR_X_POLY top_v_u;
    LAMB_TBAR_X_POLY top_v_v;
    LAMB_TBAR_X_POLY bottom_v_u;
    LAMB_TBAR_X_POLY bottom_v_v;
    LAMB_TBAR_X_POLY u[3][3];
    LAMB_TBAR_X_POLY v[3][3];

    lamb2_make_dehoop_factors(G, V, &factors);
    grt_lamb_tbar_x_poly_const(&x_power[0], 1.0);
    x_power[1] = G->x;
    x_power[2] = G->x2;
    grt_lamb_tbar_x_poly_mul(&G->x2, &G->x, &x_power[3]);
    grt_lamb_tbar_x_poly_mul(&G->x2, &G->x2, &x_power[4]);

    grt_lamb_tbar_x_poly_mul(&G->h, &G->h, &h2);
    grt_lamb_tbar_x_poly_mul(&h2, &G->h, &h3);
    grt_lamb_tbar_x_poly_mul(&G->w, &G->w, &w2);
    /* P 项中 h+2w=1、2*eta_beta^2-h=1、2*x^2-h=2*k^2-1 */
    grt_lamb_tbar_x_poly_const(&h_plus_2w, 1.0);
    grt_lamb_tbar_x_poly_const(&two_eta_other2_minus_h, 1.0);
    grt_lamb_tbar_x_poly_const(&two_x2_minus_h, 2.0 * V->k2 - 1.0);

    /* 接收点、源点均为水平方向时的两行和最后一行 */
    grt_lamb_tbar_x_poly_product3_scaled(&G->eta_other2, &G->w, &h_plus_2w, 8.0, &top_h_u);
    grt_lamb_tbar_x_poly_product3_scaled(&G->eta_other2, &h2, &h_plus_2w, -2.0, &top_h_v);
    grt_lamb_tbar_x_poly_product2_scaled(&h3, &h_plus_2w, -1.0, &bottom_h_u);
    grt_lamb_tbar_x_poly_product4_scaled(&G->eta_other2, &G->h, &G->w, &h_plus_2w,
                               4.0, &bottom_h_v);

    /* 接收点竖向、源点水平方向时的两行和最后一行 */
    grt_lamb_tbar_x_poly_product2_scaled(&h3, &two_eta_other2_minus_h, 1.0, &top_v_u);
    grt_lamb_tbar_x_poly_product4_scaled(&G->eta_other2, &G->h, &G->w, &two_eta_other2_minus_h,
                               -4.0, &top_v_v);
    grt_lamb_tbar_x_poly_product3_scaled(&G->eta_other2, &w2, &two_x2_minus_h, 8.0, &bottom_v_u);
    grt_lamb_tbar_x_poly_product4_scaled(&G->eta_other2, &h2, &G->w, &two_x2_minus_h,
                               -2.0, &bottom_v_v);

    memset(coeffs->d2M, 0, sizeof(coeffs->d2M));

    /* 水平接收点方向与水平源点方向，对应 hh */
    lamb2_make_P_d2_matrix(&factors, x_power, 2, 0, hh_u, hh_v,
                           &top_h_u, &top_h_v, &bottom_h_u, &bottom_h_v, u, v);
    lamb2_copy_d2_matrix(coeffs->d2M[0][0][0], coeffs->d2M[1][0][0], u, v);
    lamb2_make_P_d2_matrix(&factors, x_power, 1, 1, hh_u, hh_v,
                           &top_h_u, &top_h_v, &bottom_h_u, &bottom_h_v, u, v);
    lamb2_copy_d2_matrix(coeffs->d2M[0][0][1], coeffs->d2M[1][0][1], u, v);
    lamb2_copy_d2_matrix(coeffs->d2M[0][1][0], coeffs->d2M[1][1][0],
                         coeffs->d2M[0][0][1], coeffs->d2M[1][0][1]);
    lamb2_make_P_d2_matrix(&factors, x_power, 0, 2, hh_u, hh_v,
                           &top_h_u, &top_h_v, &bottom_h_u, &bottom_h_v, u, v);
    lamb2_copy_d2_matrix(coeffs->d2M[0][1][1], coeffs->d2M[1][1][1], u, v);

    /* 水平接收点方向与竖向源点方向，对应 hv */
    lamb2_make_P_d2_matrix(&factors, x_power, 1, 0, hv_u, hv_v,
                           &top_h_u, &top_h_v, &bottom_h_u, &bottom_h_v, u, v);
    lamb2_copy_d2_matrix(coeffs->d2M[0][0][2], coeffs->d2M[1][0][2], u, v);
    lamb2_make_P_d2_matrix(&factors, x_power, 0, 1, hv_u, hv_v,
                           &top_h_u, &top_h_v, &bottom_h_u, &bottom_h_v, u, v);
    lamb2_copy_d2_matrix(coeffs->d2M[0][1][2], coeffs->d2M[1][1][2], u, v);

    /* 竖向接收点方向与水平源点方向，对应 vh */
    lamb2_make_P_d2_matrix(&factors, x_power, 1, 0, vh_u, vh_v,
                           &top_v_u, &top_v_v, &bottom_v_u, &bottom_v_v, u, v);
    lamb2_copy_d2_matrix(coeffs->d2M[0][2][0], coeffs->d2M[1][2][0], u, v);
    lamb2_make_P_d2_matrix(&factors, x_power, 0, 1, vh_u, vh_v,
                           &top_v_u, &top_v_v, &bottom_v_u, &bottom_v_v, u, v);
    lamb2_copy_d2_matrix(coeffs->d2M[0][2][1], coeffs->d2M[1][2][1], u, v);

    /* 接收点和源点均为竖向方向，对应 vv */
    lamb2_make_P_d2_matrix(&factors, x_power, 0, 0, vv_u, vv_v,
                           &top_v_u, &top_v_v, &bottom_v_u, &bottom_v_v, u, v);
    lamb2_copy_d2_matrix(coeffs->d2M[0][2][2], coeffs->d2M[1][2][2], u, v);
}


/** 构造已经吸收 Rayleigh 因子的 S 项矩阵块 */
static void lamb2_make_S_dehoop_blocks(const LAMB2_DEHOOP_FACTORS *factors,
                                       const LAMB2_GEOMETRY *G, const int a, const int b,
                                       const LAMB2_ROOT_POLY *rayleigh_prime,
                                       const LAMB2_ROOT_POLY *rayleigh_dagger_times_s,
                                       const LAMB2_ROOT_POLY *rayleigh_dagger2,
                                       const LAMB2_ROOT_POLY *root_c,
                                       const LAMB2_ROOT_POLY *root_y_c,
                                       LAMB_TBAR_X_POLY s0[3][3],
                                       LAMB2_ROOT_POLY rd_ss[3][3],
                                       LAMB2_ROOT_POLY c_sp[3][3])
{
    LAMB_TBAR_X_POLY term1;
    LAMB2_ROOT_POLY term2;

    /* S0 */
    grt_lamb_tbar_x_poly_mul(&G->x2, &factors->xi[a][b], &term1);
    grt_lamb_tbar_x_poly_add(&factors->xi[a][b + 2], &term1, &s0[0][0]);
    grt_lamb_tbar_x_poly_scale(&factors->xi[a + 1][b + 1], -1.0, &s0[0][1]);
    grt_lamb_tbar_x_poly_product2_scaled(&G->x, &factors->xi[a + 1][b], -1.0, &s0[0][2]);
    s0[1][0] = s0[0][1];
    grt_lamb_tbar_x_poly_mul(&G->x2, &factors->xi[a][b], &term1);
    grt_lamb_tbar_x_poly_add(&factors->xi[a + 2][b], &term1, &s0[1][1]);
    grt_lamb_tbar_x_poly_product2_scaled(&G->x, &factors->xi[a][b + 1], -1.0, &s0[1][2]);
    s0[2][0] = s0[0][2];
    s0[2][1] = s0[1][2];
    grt_lamb_tbar_x_poly_product2_scaled(&G->w, &factors->xi[a][b], 1.0, &s0[2][2]);

    /* R^dagger*S_SS，先把 R^dagger*R、R^dagger*T 和 (R^dagger)^2 化简 */
    lamb2_root_scale_poly(rayleigh_prime, &factors->xi[a][b], 1.0, &rd_ss[0][0]);
    lamb2_root_scale_poly(rayleigh_dagger_times_s, &factors->xi[a + 2][b], -1.0, &term2);
    lamb2_root_add(&rd_ss[0][0], &term2, &rd_ss[0][0]);
    lamb2_root_scale_poly(rayleigh_dagger_times_s, &factors->xi[a + 1][b + 1], -1.0, &rd_ss[0][1]);
    lamb2_root_scale_poly(rayleigh_dagger2, &factors->xi[a + 1][b], -1.0, &term2);
    lamb2_root_scale_poly(&term2, &G->x, 1.0, &rd_ss[0][2]);
    rd_ss[1][0] = rd_ss[0][1];
    lamb2_root_scale_poly(rayleigh_prime, &factors->xi[a][b], 1.0, &rd_ss[1][1]);
    lamb2_root_scale_poly(rayleigh_dagger_times_s, &factors->xi[a][b + 2], -1.0, &term2);
    lamb2_root_add(&rd_ss[1][1], &term2, &rd_ss[1][1]);
    lamb2_root_scale_poly(rayleigh_dagger2, &factors->xi[a][b + 1], -1.0, &term2);
    lamb2_root_scale_poly(&term2, &G->x, 1.0, &rd_ss[1][2]);
    lamb2_root_scale(&rd_ss[0][2], -1.0, &rd_ss[2][0]);
    lamb2_root_scale(&rd_ss[1][2], -1.0, &rd_ss[2][1]);
    lamb2_root_scale_poly(rayleigh_dagger2, &factors->xi[a][b], -1.0, &term2);
    lamb2_root_scale_poly(&term2, &G->w, 1.0, &rd_ss[2][2]);

    /* 2*x*h*R^dagger*S_SP */
    grt_lamb_tbar_x_poly_product2_scaled(&G->x, &factors->xi[a + 2][b], 1.0, &term1);
    lamb2_root_scale_poly(root_c, &term1, 1.0, &c_sp[0][0]);
    grt_lamb_tbar_x_poly_product2_scaled(&G->x, &factors->xi[a + 1][b + 1], 1.0, &term1);
    lamb2_root_scale_poly(root_c, &term1, 1.0, &c_sp[0][1]);
    c_sp[1][0] = c_sp[0][1];
    grt_lamb_tbar_x_poly_product2_scaled(&G->w, &factors->xi[a + 1][b], -1.0, &term1);
    lamb2_root_scale_poly(root_c, &term1, 1.0, &c_sp[0][2]);
    grt_lamb_tbar_x_poly_product2_scaled(&G->x, &factors->xi[a][b + 2], 1.0, &term1);
    lamb2_root_scale_poly(root_c, &term1, 1.0, &c_sp[1][1]);
    grt_lamb_tbar_x_poly_product2_scaled(&G->w, &factors->xi[a][b + 1], -1.0, &term1);
    lamb2_root_scale_poly(root_c, &term1, 1.0, &c_sp[1][2]);
    grt_lamb_tbar_x_poly_product2_scaled(&G->x, &factors->xi[a + 1][b], -1.0, &term1);
    lamb2_root_scale_poly(root_y_c, &term1, 1.0, &c_sp[2][0]);
    grt_lamb_tbar_x_poly_product2_scaled(&G->x, &factors->xi[a][b + 1], -1.0, &term1);
    lamb2_root_scale_poly(root_y_c, &term1, 1.0, &c_sp[2][1]);
    grt_lamb_tbar_x_poly_product2_scaled(&G->w, &factors->xi[a][b], 1.0, &term1);
    lamb2_root_scale_poly(root_y_c, &term1, 1.0, &c_sp[2][2]);
}


/** 构造 S 项的 Rayleigh 因子 */
static void lamb2_make_S_root_factors(const LAMB2_GEOMETRY *G,
                                      LAMB2_ROOT_POLY *rayleigh_prime,
                                      LAMB2_ROOT_POLY *rayleigh_dagger_times_s,
                                      LAMB2_ROOT_POLY *rayleigh_dagger2,
                                      LAMB2_ROOT_POLY *root_c,
                                      LAMB2_ROOT_POLY *root_y,
                                      LAMB2_ROOT_POLY *root_y_c)
{
    LAMB_TBAR_X_POLY h2;
    LAMB_TBAR_X_POLY h4;
    LAMB_TBAR_X_POLY x3;
    LAMB_TBAR_X_POLY b;
    LAMB_TBAR_X_POLY b2;
    LAMB_TBAR_X_POLY t1;
    LAMB_TBAR_X_POLY t1_minus_b;
    LAMB_TBAR_X_POLY h2_b;
    LAMB_TBAR_X_POLY h2_t1_minus_b;
    LAMB_TBAR_X_POLY eta_other2_b2;
    LAMB_TBAR_X_POLY eta_other2_b_t1;
    LAMB_TBAR_X_POLY factor;
    LAMB2_ROOT_POLY rayleigh_dagger;

    grt_lamb_tbar_x_poly_mul(&G->h, &G->h, &h2);
    grt_lamb_tbar_x_poly_mul(&h2, &h2, &h4);
    grt_lamb_tbar_x_poly_mul(&G->x2, &G->x, &x3);
    grt_lamb_tbar_x_poly_product2_scaled(&G->x, &G->w, 4.0, &b);
    grt_lamb_tbar_x_poly_add_scaled(&b, 8.0, &x3, &t1);
    grt_lamb_tbar_x_poly_mul(&b, &b, &b2);
    grt_lamb_tbar_x_poly_product2_scaled(&G->eta_other2, &b2, 1.0, &eta_other2_b2);
    grt_lamb_tbar_x_poly_product3(&G->eta_other2, &b, &t1, &eta_other2_b_t1);
    grt_lamb_tbar_x_poly_add_scaled(&t1, -1.0, &b, &t1_minus_b);
    grt_lamb_tbar_x_poly_product2_scaled(&h2, &t1_minus_b, 1.0, &h2_t1_minus_b);
    grt_lamb_tbar_x_poly_product2_scaled(&h2, &b, 1.0, &h2_b);

    lamb2_root_zero(rayleigh_prime);
    grt_lamb_tbar_x_poly_add_scaled(&h4, -1.0, &eta_other2_b2, &rayleigh_prime->even);
    lamb2_root_zero(rayleigh_dagger_times_s);
    grt_lamb_tbar_x_poly_add_scaled(&h4, -1.0, &eta_other2_b_t1, &rayleigh_dagger_times_s->even);
    rayleigh_dagger_times_s->odd = h2_t1_minus_b;

    lamb2_root_zero(rayleigh_dagger2);
    rayleigh_dagger2->even = h4;
    grt_lamb_tbar_x_poly_add_scaled(&rayleigh_dagger2->even, 1.0, &eta_other2_b2, &rayleigh_dagger2->even);
    grt_lamb_tbar_x_poly_scale(&h2_b, -2.0, &rayleigh_dagger2->odd);

    lamb2_root_zero(&rayleigh_dagger);
    rayleigh_dagger.even = h2;
    grt_lamb_tbar_x_poly_scale(&b, -1.0, &rayleigh_dagger.odd);

    grt_lamb_tbar_x_poly_product2_scaled(&G->x, &G->h, 2.0, &factor);
    lamb2_root_scale_poly(&rayleigh_dagger, &factor, 1.0, root_c);

    lamb2_root_zero(root_y);
    grt_lamb_tbar_x_poly_const(&root_y->odd, 1.0);
    lamb2_root_mul(root_y, root_c, &G->eta_other2, root_y_c);
}


/** 构造 S 项一个接收点方向组合的两项分子矩阵 */
static void lamb2_make_S_d2_root_matrix(const LAMB2_DEHOOP_FACTORS *factors,
                                        const LAMB2_GEOMETRY *G, const int a, const int b,
                                        const bool receiver_vertical,
                                        const LAMB2_ROOT_POLY *rayleigh_prime,
                                        const LAMB2_ROOT_POLY *rayleigh_dagger_times_s,
                                        const LAMB2_ROOT_POLY *rayleigh_dagger2,
                                        const LAMB2_ROOT_POLY *root_y,
                                        const LAMB2_ROOT_POLY *root_c,
                                        const LAMB2_ROOT_POLY *root_y_c,
                                        LAMB2_ROOT_POLY result[3][3])
{
    LAMB_TBAR_X_POLY s0[3][3];
    LAMB2_ROOT_POLY rd_ss[3][3];
    LAMB2_ROOT_POLY c_sp[3][3];
    LAMB2_ROOT_POLY x_rayleigh_prime;
    LAMB2_ROOT_POLY x_rd_ss;
    LAMB2_ROOT_POLY y_c_sp;

    lamb2_make_S_dehoop_blocks(factors, G, a, b, rayleigh_prime,
                               rayleigh_dagger_times_s, rayleigh_dagger2,
                               root_c, root_y_c, s0, rd_ss, c_sp);
    if (receiver_vertical) {
        lamb2_root_scale_poly(rayleigh_prime, &G->x, 1.0, &x_rayleigh_prime);
    }

    for (int i = 0; i < 3; ++i) {
        for (int j = 0; j < 3; ++j) {
            lamb2_root_zero(&result[i][j]);
            if (!receiver_vertical) {
                lamb2_root_scale_poly(rayleigh_prime, &s0[i][j], 0.5, &x_rd_ss);
                lamb2_root_add(&result[i][j], &x_rd_ss, &result[i][j]);
                lamb2_root_scale(&rd_ss[i][j], 0.5, &x_rd_ss);
                lamb2_root_add(&result[i][j], &x_rd_ss, &result[i][j]);
                lamb2_root_scale(&c_sp[i][j], 1.0, &y_c_sp);
                lamb2_root_add(&result[i][j], &y_c_sp, &result[i][j]);
            } else {
                lamb2_root_scale_poly(&x_rayleigh_prime, &s0[i][j], 0.5, &x_rd_ss);
                lamb2_root_add(&result[i][j], &x_rd_ss, &result[i][j]);
                lamb2_root_scale_poly(&rd_ss[i][j], &G->x, -0.5, &x_rd_ss);
                lamb2_root_add(&result[i][j], &x_rd_ss, &result[i][j]);
                lamb2_root_mul(root_y, &c_sp[i][j], &G->eta_other2, &y_c_sp);
                lamb2_root_scale(&y_c_sp, -1.0, &y_c_sp);
                lamb2_root_add(&result[i][j], &y_c_sp, &result[i][j]);
            }
        }
    }
}


/** 将关于互补垂向根的两项分子写入 U/V 数组 */
static void lamb2_store_root_d2_matrix(const LAMB2_ROOT_POLY source[3][3],
                                       const LAMB2_GEOMETRY *G, const real_t scale,
                                       const LAMB_TBAR_X_POLY *extra,
                                       LAMB_TBAR_X_POLY target_u[3][3],
                                       LAMB_TBAR_X_POLY target_v[3][3])
{
    LAMB_TBAR_X_POLY v;

    for (int i = 0; i < 3; ++i) {
        for (int j = 0; j < 3; ++j) {
            if (extra == NULL) {
                grt_lamb_tbar_x_poly_scale(&source[i][j].even, scale, &target_u[i][j]);
            } else {
                grt_lamb_tbar_x_poly_product2_scaled(&source[i][j].even, extra, scale, &target_u[i][j]);
            }
            grt_lamb_tbar_x_poly_mul(&source[i][j].odd, &G->eta_other2, &v);
            if (extra == NULL) {
                grt_lamb_tbar_x_poly_scale(&v, scale, &target_v[i][j]);
            } else {
                grt_lamb_tbar_x_poly_product2_scaled(&v, extra, scale, &target_v[i][j]);
            }
        }
    }
}


/**
 * 按 S 项的接收点、源点导数因子构造混合二阶导数分子
 * 先由第 7.1 节的方向导数关系确定因子，再沿用第 7.3 节表中的 U/V 分解结构
 */
static void lamb2_make_S_d2_coefficients(const LAMB2_GEOMETRY *G, const LAMB2_VARS *V,
                                          LAMB2_COEFF_SET *coeffs)
{
    LAMB2_DEHOOP_FACTORS factors;
    LAMB2_ROOT_POLY rayleigh_prime;
    LAMB2_ROOT_POLY rayleigh_dagger_times_s;
    LAMB2_ROOT_POLY rayleigh_dagger2;
    LAMB2_ROOT_POLY root_y;
    LAMB2_ROOT_POLY root_c;
    LAMB2_ROOT_POLY root_y_c;
    LAMB2_ROOT_POLY group[3][3];
    LAMB2_ROOT_POLY receiver_vertical[3][3];

    lamb2_make_dehoop_factors(G, V, &factors);
    lamb2_make_S_root_factors(G, &rayleigh_prime, &rayleigh_dagger_times_s,
                              &rayleigh_dagger2, &root_c, &root_y, &root_y_c);
    memset(coeffs->d2M, 0, sizeof(coeffs->d2M));

    /* 水平接收点方向与水平源点方向，对应 hh */
    lamb2_make_S_d2_root_matrix(&factors, G, 2, 0, false,
                                &rayleigh_prime, &rayleigh_dagger_times_s, &rayleigh_dagger2,
                                &root_y, &root_c, &root_y_c, group);
    lamb2_store_root_d2_matrix(group, G, -1.0, NULL,
                               coeffs->d2M[0][0][0], coeffs->d2M[1][0][0]);
    lamb2_make_S_d2_root_matrix(&factors, G, 1, 1, false,
                                &rayleigh_prime, &rayleigh_dagger_times_s, &rayleigh_dagger2,
                                &root_y, &root_c, &root_y_c, group);
    lamb2_store_root_d2_matrix(group, G, -1.0, NULL,
                               coeffs->d2M[0][0][1], coeffs->d2M[1][0][1]);
    lamb2_copy_d2_matrix(coeffs->d2M[0][1][0], coeffs->d2M[1][1][0],
                         coeffs->d2M[0][0][1], coeffs->d2M[1][0][1]);
    lamb2_make_S_d2_root_matrix(&factors, G, 0, 2, false,
                                &rayleigh_prime, &rayleigh_dagger_times_s, &rayleigh_dagger2,
                                &root_y, &root_c, &root_y_c, group);
    lamb2_store_root_d2_matrix(group, G, -1.0, NULL,
                               coeffs->d2M[0][1][1], coeffs->d2M[1][1][1]);

    /* 水平接收点方向与竖向源点方向，对应 hv */
    lamb2_make_S_d2_root_matrix(&factors, G, 1, 0, false,
                                &rayleigh_prime, &rayleigh_dagger_times_s, &rayleigh_dagger2,
                                &root_y, &root_c, &root_y_c, group);
    lamb2_store_root_d2_matrix(group, G, -1.0, &G->x,
                               coeffs->d2M[0][0][2], coeffs->d2M[1][0][2]);
    lamb2_make_S_d2_root_matrix(&factors, G, 0, 1, false,
                                &rayleigh_prime, &rayleigh_dagger_times_s, &rayleigh_dagger2,
                                &root_y, &root_c, &root_y_c, group);
    lamb2_store_root_d2_matrix(group, G, -1.0, &G->x,
                               coeffs->d2M[0][1][2], coeffs->d2M[1][1][2]);

    /* 竖向接收点方向与水平源点方向，对应 vh */
    lamb2_make_S_d2_root_matrix(&factors, G, 1, 0, true,
                                &rayleigh_prime, &rayleigh_dagger_times_s, &rayleigh_dagger2,
                                &root_y, &root_c, &root_y_c, receiver_vertical);
    lamb2_store_root_d2_matrix(receiver_vertical, G, -1.0, NULL,
                               coeffs->d2M[0][2][0], coeffs->d2M[1][2][0]);
    lamb2_make_S_d2_root_matrix(&factors, G, 0, 1, true,
                                &rayleigh_prime, &rayleigh_dagger_times_s, &rayleigh_dagger2,
                                &root_y, &root_c, &root_y_c, receiver_vertical);
    lamb2_store_root_d2_matrix(receiver_vertical, G, -1.0, NULL,
                               coeffs->d2M[0][2][1], coeffs->d2M[1][2][1]);

    /* 接收点和源点均为竖向方向，对应 vv */
    lamb2_make_S_d2_root_matrix(&factors, G, 0, 0, true,
                                &rayleigh_prime, &rayleigh_dagger_times_s, &rayleigh_dagger2,
                                &root_y, &root_c, &root_y_c, receiver_vertical);
    lamb2_store_root_d2_matrix(receiver_vertical, G, -1.0, &G->x,
                               coeffs->d2M[0][2][2], coeffs->d2M[1][2][2]);
}


/** 构造第二类 Lamb 问题的 P 波系数 */
static void make_lamb2_P_coefficients(const LAMB2_VARS *V, const bool need_mixed, LAMB2_COEFF_SET *coeffs)
{
    const real_t c_phi = V->cf;
    const real_t s_phi = V->sf;
    LAMB2_GEOMETRY G;
    LAMB_TBAR_X_POLY gamma2;
    LAMB_TBAR_X_POLY gamma3;
    LAMB_TBAR_X_POLY x3;

    lamb2_make_geometry(V, false, &G);
    memset(coeffs, 0, sizeof(*coeffs));
    grt_lamb_tbar_x_poly_mul(&G.gamma, &G.gamma, &gamma2);
    grt_lamb_tbar_x_poly_mul(&gamma2, &G.gamma, &gamma3);
    grt_lamb_tbar_x_poly_mul(&G.x2, &G.x, &x3);

    for (int xi = 0; xi < 2; ++xi) {
        LAMB_TBAR_X_POLY (*M)[3] = coeffs->M[xi];
        LAMB_TBAR_X_POLY (*dM_x1)[3] = coeffs->dMs[xi][0];
        LAMB_TBAR_X_POLY (*dM_x2)[3] = coeffs->dMs[xi][1];

        if (xi == 0) {
            /* 表 7.2.1，xi=1 */
            grt_lamb_tbar_x_poly_product4_scaled(&G.x2, &G.g, &G.eta_beta2, &G.epsilon, 8.0, &M[0][0]);
            grt_lamb_tbar_x_poly_product4_scaled(&G.x2, &G.g, &G.eta_beta2, &G.zeta, 8.0, &M[0][1]);
            grt_lamb_tbar_x_poly_product4_scaled(&x3, &G.g, &G.eta_beta2, &G.qbar, 8.0 * c_phi, &M[0][2]);
            grt_lamb_tbar_x_poly_product4_scaled(&x3, &G.g, &G.eta_beta2, &G.qbar, 8.0 * s_phi, &M[1][2]);
            grt_lamb_tbar_x_poly_product4_scaled(&G.x2, &G.g, &G.eta_beta2, &G.bar_epsilon, 8.0, &M[1][1]);
            grt_lamb_tbar_x_poly_product3_scaled(&G.x, &gamma3, &G.qbar, c_phi, &M[2][0]);
            grt_lamb_tbar_x_poly_product3_scaled(&G.x, &gamma3, &G.qbar, s_phi, &M[2][1]);
            grt_lamb_tbar_x_poly_product2_scaled(&G.x2, &gamma3, 1.0, &M[2][2]);

            /* 表 7.2.2，xi=1 的源点 x1' 导数 */
            grt_lamb_tbar_x_poly_product5_scaled(&G.x2, &G.qbar, &G.g, &G.eta_beta2, &G.kappa,
                                       -8.0 * c_phi, &dM_x1[0][0]);
            grt_lamb_tbar_x_poly_product5_scaled(&G.x2, &G.qbar, &G.g, &G.eta_beta2, &G.kappa_prime,
                                       -8.0 * s_phi, &dM_x1[0][1]);
            grt_lamb_tbar_x_poly_product4_scaled(&x3, &G.g, &G.eta_beta2, &G.epsilon, -8.0, &dM_x1[0][2]);
            grt_lamb_tbar_x_poly_product5_scaled(&G.x2, &G.qbar, &G.g, &G.eta_beta2, &G.bar_kappa_prime,
                                       -8.0 * c_phi, &dM_x1[1][1]);
            grt_lamb_tbar_x_poly_product4_scaled(&x3, &G.g, &G.eta_beta2, &G.zeta, -8.0, &dM_x1[1][2]);
            grt_lamb_tbar_x_poly_product3_scaled(&G.x, &gamma3, &G.epsilon, -1.0, &dM_x1[2][0]);
            grt_lamb_tbar_x_poly_product3_scaled(&G.x, &gamma3, &G.zeta, -1.0, &dM_x1[2][1]);
            grt_lamb_tbar_x_poly_product3_scaled(&G.x2, &G.qbar, &gamma3, -c_phi, &dM_x1[2][2]);
            dM_x1[1][0] = dM_x1[0][1];

            /* 式 (7.1.6a) 的矩阵关系构造 x2' 导数 */
            dM_x2[0][0] = dM_x1[0][1];
            dM_x2[0][1] = dM_x1[1][1];
            dM_x2[0][2] = dM_x1[1][2];
            dM_x2[1][0] = dM_x2[0][1];
            grt_lamb_tbar_x_poly_product5_scaled(&G.x2, &G.qbar, &G.g, &G.eta_beta2, &G.bar_kappa,
                                       -8.0 * s_phi, &dM_x2[1][1]);
            grt_lamb_tbar_x_poly_product4_scaled(&x3, &G.g, &G.eta_beta2, &G.bar_epsilon, -8.0, &dM_x2[1][2]);
            dM_x2[2][0] = dM_x1[2][1];
            grt_lamb_tbar_x_poly_product3_scaled(&G.x, &gamma3, &G.bar_epsilon, -1.0, &dM_x2[2][1]);
            grt_lamb_tbar_x_poly_product3_scaled(&G.x2, &G.qbar, &gamma3, -s_phi, &dM_x2[2][2]);
        } else {
            /* 表 7.2.1，xi=2 */
            grt_lamb_tbar_x_poly_product4_scaled(&G.x, &G.eta_beta2, &gamma2, &G.epsilon, 2.0, &M[0][0]);
            grt_lamb_tbar_x_poly_product4_scaled(&G.x, &G.eta_beta2, &gamma2, &G.zeta, 2.0, &M[0][1]);
            grt_lamb_tbar_x_poly_product4_scaled(&G.x2, &G.eta_beta2, &gamma2, &G.qbar, 2.0 * c_phi, &M[0][2]);
            grt_lamb_tbar_x_poly_product4_scaled(&G.x2, &G.eta_beta2, &gamma2, &G.qbar, 2.0 * s_phi, &M[1][2]);
            grt_lamb_tbar_x_poly_product4_scaled(&G.x, &G.eta_beta2, &gamma2, &G.bar_epsilon, 2.0, &M[1][1]);
            grt_lamb_tbar_x_poly_product5_scaled(&G.x2, &G.g, &G.eta_beta2, &G.gamma, &G.qbar,
                                       4.0 * c_phi, &M[2][0]);
            grt_lamb_tbar_x_poly_product5_scaled(&G.x2, &G.g, &G.eta_beta2, &G.gamma, &G.qbar,
                                       4.0 * s_phi, &M[2][1]);
            grt_lamb_tbar_x_poly_product4_scaled(&x3, &G.g, &G.eta_beta2, &G.gamma, 4.0, &M[2][2]);

            /* 表 7.2.2，xi=2 的源点 x1' 导数 */
            grt_lamb_tbar_x_poly_product5_scaled(&G.x, &G.qbar, &G.eta_beta2, &gamma2, &G.kappa,
                                       -2.0 * c_phi, &dM_x1[0][0]);
            grt_lamb_tbar_x_poly_product5_scaled(&G.x, &G.qbar, &G.eta_beta2, &gamma2, &G.kappa_prime,
                                       -2.0 * s_phi, &dM_x1[0][1]);
            grt_lamb_tbar_x_poly_product4_scaled(&G.x2, &G.eta_beta2, &gamma2, &G.epsilon, -2.0, &dM_x1[0][2]);
            grt_lamb_tbar_x_poly_product5_scaled(&G.x, &G.qbar, &G.eta_beta2, &gamma2, &G.bar_kappa_prime,
                                       -2.0 * c_phi, &dM_x1[1][1]);
            grt_lamb_tbar_x_poly_product4_scaled(&G.x2, &G.eta_beta2, &gamma2, &G.zeta, -2.0, &dM_x1[1][2]);
            grt_lamb_tbar_x_poly_product5_scaled(&G.x2, &G.g, &G.eta_beta2, &G.gamma, &G.epsilon,
                                       -4.0, &dM_x1[2][0]);
            grt_lamb_tbar_x_poly_product5_scaled(&G.x2, &G.g, &G.eta_beta2, &G.gamma, &G.zeta,
                                       -4.0, &dM_x1[2][1]);
            grt_lamb_tbar_x_poly_product5_scaled(&x3, &G.g, &G.qbar, &G.eta_beta2, &G.gamma,
                                       -4.0 * c_phi, &dM_x1[2][2]);
            dM_x1[1][0] = dM_x1[0][1];

            /* 式 (7.1.6a) 的矩阵关系构造 x2' 导数 */
            dM_x2[0][0] = dM_x1[0][1];
            dM_x2[0][1] = dM_x1[1][1];
            dM_x2[0][2] = dM_x1[1][2];
            dM_x2[1][0] = dM_x2[0][1];
            grt_lamb_tbar_x_poly_product5_scaled(&G.x, &G.qbar, &G.eta_beta2, &gamma2, &G.bar_kappa,
                                       -2.0 * s_phi, &dM_x2[1][1]);
            grt_lamb_tbar_x_poly_product4_scaled(&G.x2, &G.eta_beta2, &gamma2, &G.bar_epsilon, -2.0, &dM_x2[1][2]);
            dM_x2[2][0] = dM_x1[2][1];
            grt_lamb_tbar_x_poly_product5_scaled(&G.x2, &G.g, &G.eta_beta2, &G.gamma, &G.bar_epsilon,
                                       -4.0, &dM_x2[2][1]);
            grt_lamb_tbar_x_poly_product5_scaled(&x3, &G.g, &G.qbar, &G.eta_beta2, &G.gamma,
                                       -4.0 * s_phi, &dM_x2[2][2]);
        }

        M[1][0] = M[0][1];
    }

    lamb2_make_derivative_coefficients(&G, V, false, coeffs);
    if (need_mixed) {
        lamb2_make_P_d2_coefficients(&G, V, coeffs);
    }
}


/** 构造第二类 Lamb 问题的 S 波系数 */
static void make_lamb2_S_coefficients(const LAMB2_VARS *V, const bool need_mixed, LAMB2_COEFF_SET *coeffs)
{
    const real_t c_phi = V->cf;
    const real_t s_phi = V->sf;
    LAMB2_GEOMETRY G;
    LAMB_TBAR_X_POLY gamma2;
    LAMB_TBAR_X_POLY gamma3;
    LAMB_TBAR_X_POLY g2;
    LAMB_TBAR_X_POLY x3;
    LAMB_TBAR_X_POLY common_N1;
    LAMB_TBAR_X_POLY gamma_minus_g;
    LAMB_TBAR_X_POLY g_minus_gamma;
    LAMB_TBAR_X_POLY f1_epsilon;
    LAMB_TBAR_X_POLY f1_bar_epsilon;
    LAMB_TBAR_X_POLY f1_kappa;
    LAMB_TBAR_X_POLY f1_bar_kappa;
    LAMB_TBAR_X_POLY f1_kappa_prime;
    LAMB_TBAR_X_POLY f1_bar_kappa_prime;
    LAMB_TBAR_X_POLY f2_kappa;
    LAMB_TBAR_X_POLY f2_bar_kappa;
    LAMB_TBAR_X_POLY f2_kappa_prime;
    LAMB_TBAR_X_POLY f2_bar_kappa_prime;
    LAMB_TBAR_X_POLY f2_epsilon;
    LAMB_TBAR_X_POLY f2_bar_epsilon;

    lamb2_make_geometry(V, true, &G);
    memset(coeffs, 0, sizeof(*coeffs));
    grt_lamb_tbar_x_poly_mul(&G.gamma, &G.gamma, &gamma2);
    grt_lamb_tbar_x_poly_mul(&gamma2, &G.gamma, &gamma3);
    grt_lamb_tbar_x_poly_mul(&G.g_prime, &G.g_prime, &g2);
    grt_lamb_tbar_x_poly_mul(&G.x2, &G.x, &x3);
    grt_lamb_tbar_x_poly_product3_scaled(&G.x2, &G.g_prime, &G.eta_alpha2, -16.0, &common_N1);
    grt_lamb_tbar_x_poly_add(&gamma3, &common_N1, &common_N1);
    grt_lamb_tbar_x_poly_add_scaled(&G.gamma, -1.0, &G.g_prime, &gamma_minus_g);
    grt_lamb_tbar_x_poly_add_scaled(&G.g_prime, -1.0, &G.gamma, &g_minus_gamma);

    lamb2_make_f1(&G, &gamma3, &G.epsilon, &f1_epsilon);
    lamb2_make_f1(&G, &gamma3, &G.bar_epsilon, &f1_bar_epsilon);
    lamb2_make_f1(&G, &gamma3, &G.kappa, &f1_kappa);
    lamb2_make_f1(&G, &gamma3, &G.bar_kappa, &f1_bar_kappa);
    lamb2_make_f1(&G, &gamma3, &G.kappa_prime, &f1_kappa_prime);
    lamb2_make_f1(&G, &gamma3, &G.bar_kappa_prime, &f1_bar_kappa_prime);
    lamb2_make_f2(&G, &G.kappa, &f2_kappa);
    lamb2_make_f2(&G, &G.bar_kappa, &f2_bar_kappa);
    lamb2_make_f2(&G, &G.kappa_prime, &f2_kappa_prime);
    lamb2_make_f2(&G, &G.bar_kappa_prime, &f2_bar_kappa_prime);
    lamb2_make_f2(&G, &G.epsilon, &f2_epsilon);
    lamb2_make_f2(&G, &G.bar_epsilon, &f2_bar_epsilon);

    for (int xi = 0; xi < 2; ++xi) {
        LAMB_TBAR_X_POLY (*N)[3] = coeffs->M[xi];
        LAMB_TBAR_X_POLY (*dN_x1)[3] = coeffs->dMs[xi][0];
        LAMB_TBAR_X_POLY (*dN_x2)[3] = coeffs->dMs[xi][1];

        if (xi == 0) {
            /* 表 7.3.1，xi=1 */
            N[0][0] = f1_bar_epsilon;
            grt_lamb_tbar_x_poly_mul(&common_N1, &G.zeta, &N[0][1]);
            grt_lamb_tbar_x_poly_product3_scaled(&G.x, &G.qbar, &gamma3, -c_phi, &N[0][2]);
            grt_lamb_tbar_x_poly_product3_scaled(&G.x, &G.qbar, &gamma3, -s_phi, &N[1][2]);
            N[1][1] = f1_epsilon;
            grt_lamb_tbar_x_poly_product4_scaled(&x3, &G.g_prime, &G.eta_alpha2, &G.qbar,
                                       -8.0 * c_phi, &N[2][0]);
            grt_lamb_tbar_x_poly_product4_scaled(&x3, &G.g_prime, &G.eta_alpha2, &G.qbar,
                                       -8.0 * s_phi, &N[2][1]);
            grt_lamb_tbar_x_poly_product3_scaled(&G.x2, &g2, &G.eta_alpha2, -8.0, &N[2][2]);

            /* 表 7.3.2，xi=1 的源点 x1' 导数 */
            grt_lamb_tbar_x_poly_product2_scaled(&f1_bar_kappa_prime, &G.qbar, -c_phi, &dN_x1[0][0]);
            grt_lamb_tbar_x_poly_product3_scaled(&common_N1, &G.kappa_prime, &G.qbar,
                                       -s_phi, &dN_x1[0][1]);
            grt_lamb_tbar_x_poly_product3(&G.x, &G.epsilon, &gamma3, &dN_x1[0][2]);
            grt_lamb_tbar_x_poly_product2_scaled(&f1_kappa, &G.qbar, -c_phi, &dN_x1[1][1]);
            grt_lamb_tbar_x_poly_product3(&G.x, &G.zeta, &gamma3, &dN_x1[1][2]);
            grt_lamb_tbar_x_poly_product4_scaled(&x3, &G.g_prime, &G.eta_alpha2, &G.epsilon,
                                       8.0, &dN_x1[2][0]);
            grt_lamb_tbar_x_poly_product4_scaled(&x3, &G.g_prime, &G.eta_alpha2, &G.zeta,
                                       8.0, &dN_x1[2][1]);
            grt_lamb_tbar_x_poly_product4_scaled(&G.x2, &g2, &G.eta_alpha2, &G.qbar,
                                       8.0 * c_phi, &dN_x1[2][2]);
            dN_x1[1][0] = dN_x1[0][1];

            /* 式 (7.1.6d)--(7.1.6f) 的矩阵关系构造 x2' 导数 */
            grt_lamb_tbar_x_poly_product2_scaled(&f1_bar_kappa, &G.qbar, -s_phi, &dN_x2[0][0]);
            grt_lamb_tbar_x_poly_product3_scaled(&common_N1, &G.bar_kappa_prime, &G.qbar,
                                       -c_phi, &dN_x2[0][1]);
            dN_x2[0][2] = dN_x1[1][2];
            grt_lamb_tbar_x_poly_product2_scaled(&f1_kappa_prime, &G.qbar, -s_phi, &dN_x2[1][1]);
            grt_lamb_tbar_x_poly_product3(&G.x, &G.bar_epsilon, &gamma3, &dN_x2[1][2]);
            dN_x2[2][0] = dN_x1[2][1];
            grt_lamb_tbar_x_poly_product4_scaled(&x3, &G.g_prime, &G.eta_alpha2, &G.bar_epsilon,
                                       8.0, &dN_x2[2][1]);
            grt_lamb_tbar_x_poly_product4_scaled(&G.x2, &g2, &G.eta_alpha2, &G.qbar,
                                       8.0 * s_phi, &dN_x2[2][2]);
            dN_x2[1][0] = dN_x2[0][1];
        } else {
            /* 表 7.3.1，xi=2 */
            grt_lamb_tbar_x_poly_product4_scaled(&G.x, &G.eta_alpha2, &G.gamma, &f2_bar_epsilon,
                                       4.0, &N[0][0]);
            grt_lamb_tbar_x_poly_product5_scaled(&G.x, &G.eta_alpha2, &G.gamma, &gamma_minus_g,
                                       &G.zeta, -4.0, &N[0][1]);
            grt_lamb_tbar_x_poly_product5_scaled(&G.x2, &G.g_prime, &G.eta_alpha2, &G.gamma,
                                       &G.qbar, -4.0 * c_phi, &N[0][2]);
            grt_lamb_tbar_x_poly_product5_scaled(&G.x2, &G.g_prime, &G.eta_alpha2, &G.gamma,
                                       &G.qbar, -4.0 * s_phi, &N[1][2]);
            grt_lamb_tbar_x_poly_product4_scaled(&G.x, &G.eta_alpha2, &G.gamma, &f2_epsilon,
                                       4.0, &N[1][1]);
            grt_lamb_tbar_x_poly_product4_scaled(&G.x2, &G.eta_alpha2, &gamma2, &G.qbar,
                                       -2.0 * c_phi, &N[2][0]);
            grt_lamb_tbar_x_poly_product4_scaled(&G.x2, &G.eta_alpha2, &gamma2, &G.qbar,
                                       -2.0 * s_phi, &N[2][1]);
            grt_lamb_tbar_x_poly_product4_scaled(&G.x, &G.g_prime, &G.eta_alpha2, &gamma2,
                                       -2.0, &N[2][2]);

            /* 表 7.3.2，xi=2 的源点 x1' 导数 */
            grt_lamb_tbar_x_poly_product5_scaled(&G.x, &G.eta_alpha2, &G.gamma, &f2_bar_kappa_prime,
                                       &G.qbar, -4.0 * c_phi, &dN_x1[0][0]);
            grt_lamb_tbar_x_poly_product6_scaled(&G.x, &G.eta_alpha2, &G.gamma, &g_minus_gamma,
                                       &G.kappa_prime, &G.qbar, -4.0 * s_phi, &dN_x1[0][1]);
            grt_lamb_tbar_x_poly_product5_scaled(&G.x2, &G.g_prime, &G.eta_alpha2, &G.gamma,
                                       &G.epsilon, 4.0, &dN_x1[0][2]);
            grt_lamb_tbar_x_poly_product5_scaled(&G.x, &G.eta_alpha2, &G.gamma, &f2_kappa,
                                       &G.qbar, -4.0 * c_phi, &dN_x1[1][1]);
            grt_lamb_tbar_x_poly_product5_scaled(&G.x2, &G.g_prime, &G.eta_alpha2, &G.gamma,
                                       &G.zeta, 4.0, &dN_x1[1][2]);
            grt_lamb_tbar_x_poly_product4_scaled(&G.x2, &G.eta_alpha2, &gamma2, &G.epsilon,
                                       2.0, &dN_x1[2][0]);
            grt_lamb_tbar_x_poly_product4_scaled(&G.x2, &G.eta_alpha2, &gamma2, &G.zeta,
                                       2.0, &dN_x1[2][1]);
            grt_lamb_tbar_x_poly_product5_scaled(&G.x, &G.g_prime, &G.eta_alpha2, &gamma2, &G.qbar,
                                       2.0 * c_phi, &dN_x1[2][2]);
            dN_x1[1][0] = dN_x1[0][1];

            /* 式 (7.1.6d)--(7.1.6f) 的矩阵关系构造 x2' 导数 */
            grt_lamb_tbar_x_poly_product5_scaled(&G.x, &G.eta_alpha2, &G.gamma, &f2_bar_kappa,
                                       &G.qbar, -4.0 * s_phi, &dN_x2[0][0]);
            grt_lamb_tbar_x_poly_product6_scaled(&G.x, &G.eta_alpha2, &G.gamma, &g_minus_gamma,
                                       &G.bar_kappa_prime, &G.qbar, -4.0 * c_phi, &dN_x2[0][1]);
            dN_x2[0][2] = dN_x1[1][2];
            grt_lamb_tbar_x_poly_product5_scaled(&G.x, &G.eta_alpha2, &G.gamma, &f2_kappa_prime,
                                       &G.qbar, -4.0 * s_phi, &dN_x2[1][1]);
            grt_lamb_tbar_x_poly_product5_scaled(&G.x2, &G.g_prime, &G.eta_alpha2, &G.gamma,
                                       &G.bar_epsilon, 4.0, &dN_x2[1][2]);
            dN_x2[2][0] = dN_x1[2][1];
            grt_lamb_tbar_x_poly_product4_scaled(&G.x2, &G.eta_alpha2, &gamma2, &G.bar_epsilon,
                                       2.0, &dN_x2[2][1]);
            grt_lamb_tbar_x_poly_product5_scaled(&G.x, &G.g_prime, &G.eta_alpha2, &gamma2, &G.qbar,
                                       2.0 * s_phi, &dN_x2[2][2]);
            dN_x2[1][0] = dN_x2[0][1];
        }

        N[1][0] = N[0][1];
    }

    lamb2_make_derivative_coefficients(&G, V, true, coeffs);
    if (need_mixed) {
        lamb2_make_S_d2_coefficients(&G, V, coeffs);
    }
}
