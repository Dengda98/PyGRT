/**
 * @file   lamb2_coeffs.c_
 * @author Zhu Dengda (zhudengda@mail.iggcas.ac.cn)
 * @date   2026-08
 *
 *    第二类 Lamb 问题中的多项式的 x 系数，由 SymPy 预先推导
 */

#include <string.h>
#include "grt/common/const.h"


#define LAMB2_POLY_SIZE 16
#define LAMB2_TIME_SIZE 4


/** 与材料、角度和 Rayleigh 根有关的常量 */
typedef struct {
    real_t nu;            ///< 泊松比 nu
    real_t k;             ///< P、S 波速比 k=beta/alpha
    real_t k2;            ///< k^2
    real_t kp;            ///< kp=sqrt(1-k^2)
    real_t kp2;           ///< kp^2=1-k^2
    real_t theta;         ///< 直接波射线角 theta=atan2(R,source_depth)
    real_t phi;           ///< 水平面方位角 phi
    real_t st;            ///< sin(theta)
    real_t ct;            ///< cos(theta)
    real_t sf;            ///< sin(phi)
    real_t cf;            ///< cos(phi)
    real_t theta_c;       ///< 临界角 theta_c=asin(k)
    real_t t_sp;          ///< SP 项的归一化到时 cos(theta-theta_c)
    real_t angle_ratio;   ///< sf/cf，|cf| 过小时为 0
    bool use_angle_ratio; ///< |cf| 是否足够大，可用 sf/cf 复用分量
    bool supercritical;   ///< 射线角是否超过临界角
    cplx_t y[3];          ///< Rayleigh 多项式的三个根 y[i]，i=0,1,2
    cplx_t yp[3];         ///< 平移后的根 yp[i]=y[i]-kp^2，i=0,1,2
} LAMB2_VARS;


/** 按 x 和 tbar 分解后的多项式系数 */
typedef struct {
    real_t c[LAMB2_TIME_SIZE][LAMB2_POLY_SIZE]; ///< c[r][m] 是 tbar^r*x^m 的系数，r=0,...,LAMB2_TIME_SIZE-1，m=0,...,LAMB2_POLY_SIZE-1
    int degree;                                 ///< x 的最高次数
    int time_degree;                            ///< tbar 的最高次数
} LAMB2_POLY_COEFF;

/** 一类积分项所需的预计算多项式系数 */
typedef struct {
    LAMB2_POLY_COEFF M[2][3][3];              ///< M[xi][i][j]，xi=0/1 对应 U/V，i,j=0,1,2 分别为接收点和源点分量
    LAMB2_POLY_COEFF dM[2][2][3][3];          ///< dM[xi][k][i][j]，xi=0/1 对应 U/V，k=0,1 为水平方向，竖向由 -xM 生成
    LAMB2_POLY_COEFF receiver_vertical[2][3]; ///< receiver_vertical[xi][j]，xi=0/1 对应 U/V，固定为接收点分量 i=2 的 [2][j] 分量
} LAMB2_COEFF_SET;

static void make_lamb2_P_coefficients(const LAMB2_VARS *V, LAMB2_COEFF_SET *coeffs) {
    const real_t k = V->k;
    const real_t c_theta = V->ct;
    const real_t s_theta = V->st;
    const real_t c_phi = V->cf;
    const real_t s_phi = V->sf;

    /* 共享的幂次和三角函数平方 */
    const real_t k2 = k * k;
    const real_t k4 = k2 * k2;
    const real_t c_theta2 = c_theta * c_theta;
    const real_t s_theta2 = s_theta * s_theta;
    const real_t s_theta3 = s_theta2 * s_theta;
    const real_t c_phi2 = c_phi * c_phi;
    const real_t s_phi2 = s_phi * s_phi;

    /* 共享的角度乘积 */
    const real_t c_theta_c_phi = c_theta * c_phi;
    const real_t c_theta_s_phi = c_theta * s_phi;
    const real_t c_phi_s_phi = c_phi * s_phi;

    /* 系数中反复出现的材料参数组合 */
    const real_t k_minus_one = k - 1.0;
    const real_t k_plus_one = k + 1.0;
    const real_t k_minus_one_times_k_plus_one = k_minus_one * k_plus_one;
    const real_t two_k2_minus_one = 2.0 * k2 - 1.0;
    const real_t two_k2_minus_one_sq = two_k2_minus_one * two_k2_minus_one;
    const real_t two_k2_minus_one_cube = two_k2_minus_one_sq * two_k2_minus_one;

    /* 系数中反复出现的方位角组合 */
    const real_t c_phi2_minus_s_phi2 = (c_phi - s_phi) * (c_phi + s_phi);
    const real_t c_phi2_minus_c_theta2_s_phi2 = (c_phi - c_theta_s_phi) * (c_phi + c_theta_s_phi);
    const real_t c_phi2_c_theta2_minus_s_phi2 = (c_theta_c_phi - s_phi) * (c_theta_c_phi + s_phi);
    const real_t c_phi2_minus_3_s_phi2 = c_phi2 - 3.0 * s_phi2;
    const real_t c_phi2_minus_3_s_phi2_plus_2 = c_phi2_minus_3_s_phi2 + 2.0;

    /* P 波系数中反复出现的 k 多项式因子 */
    const real_t three_k2_minus_two = 3.0 * k2 - 2.0;
    const real_t six_k2_minus_five = 6.0 * k2 - 5.0;
    const real_t six_k4_minus_six_k2_plus_one = 6.0 * k4 - 6.0 * k2 + 1.0;

    memset(coeffs, 0, sizeof(*coeffs));

    coeffs->M[0][0][0].degree = 8;
    coeffs->M[0][0][0].time_degree = 2;
    coeffs->M[0][0][0].c[0][2] = 8.0 * k4 * s_phi2 * k_minus_one_times_k_plus_one;
    coeffs->M[0][0][0].c[2][2] = 8.0 * k2 * c_phi2_minus_s_phi2 * k_minus_one_times_k_plus_one / s_theta2;
    coeffs->M[0][0][0].c[1][3] = -16.0 * c_theta * k2 * c_phi2_minus_s_phi2 * k_minus_one_times_k_plus_one / s_theta2;
    coeffs->M[0][0][0].c[0][4] =
        (8.0 * k2 * (c_phi2 * c_theta2 * k2 - c_phi2 * c_theta2 - 2.0 * k2 * s_phi2 * s_theta2 - k2 * s_phi2 + s_phi2 * s_theta2 + s_phi2) /
         s_theta2);
    coeffs->M[0][0][0].c[2][4] = -8.0 * c_phi2_minus_s_phi2 * two_k2_minus_one / s_theta2;
    coeffs->M[0][0][0].c[1][5] = 16.0 * c_theta * c_phi2_minus_s_phi2 * two_k2_minus_one / s_theta2;
    coeffs->M[0][0][0].c[0][6] =
        (-8.0 * (2.0 * c_phi2 * c_theta2 * k2 - c_phi2 * c_theta2 - k2 * s_phi2 * s_theta2 - 2.0 * k2 * s_phi2 + s_phi2) / s_theta2);
    coeffs->M[0][0][0].c[2][6] = 8.0 * c_phi2_minus_s_phi2 / s_theta2;
    coeffs->M[0][0][0].c[1][7] = -16.0 * c_theta * c_phi2_minus_s_phi2 / s_theta2;
    coeffs->M[0][0][0].c[0][8] = 8.0 * c_phi2_c_theta2_minus_s_phi2 / s_theta2;
    coeffs->M[0][0][1].degree = 8;
    coeffs->M[0][0][1].time_degree = 2;
    coeffs->M[0][0][1].c[0][2] = -8.0 * c_phi * k4 * s_phi * k_minus_one_times_k_plus_one;
    coeffs->M[0][0][1].c[2][2] = 16.0 * c_phi * k2 * s_phi * k_minus_one_times_k_plus_one / s_theta2;
    coeffs->M[0][0][1].c[1][3] = -32.0 * c_theta_c_phi * k2 * s_phi * k_minus_one_times_k_plus_one / s_theta2;
    coeffs->M[0][0][1].c[0][4] = (8.0 * c_phi * k2 * s_phi * (c_theta2 * k2 - c_theta2 + 2.0 * k2 * s_theta2 + k2 - s_theta2 - 1.0) / s_theta2);
    coeffs->M[0][0][1].c[2][4] = -16.0 * c_phi_s_phi * two_k2_minus_one / s_theta2;
    coeffs->M[0][0][1].c[1][5] = 32.0 * c_theta_c_phi * s_phi * two_k2_minus_one / s_theta2;
    coeffs->M[0][0][1].c[0][6] = (-8.0 * c_phi_s_phi * (2.0 * c_theta2 * k2 - c_theta2 + k2 * s_theta2 + 2.0 * k2 - 1.0) / s_theta2);
    coeffs->M[0][0][1].c[2][6] = 16.0 * c_phi_s_phi / s_theta2;
    coeffs->M[0][0][1].c[1][7] = -32.0 * c_theta_c_phi * s_phi / s_theta2;
    coeffs->M[0][0][1].c[0][8] = 8.0 * c_phi_s_phi * (c_theta2 + 1.0) / s_theta2;
    coeffs->M[0][0][2].degree = 8;
    coeffs->M[0][0][2].time_degree = 1;
    coeffs->M[0][0][2].c[1][3] = -8.0 * c_phi * k2 * k_minus_one_times_k_plus_one / s_theta;
    coeffs->M[0][0][2].c[0][4] = 8.0 * c_theta_c_phi * k2 * k_minus_one_times_k_plus_one / s_theta;
    coeffs->M[0][0][2].c[1][5] = 8.0 * c_phi * two_k2_minus_one / s_theta;
    coeffs->M[0][0][2].c[0][6] = -8.0 * c_theta_c_phi * two_k2_minus_one / s_theta;
    coeffs->M[0][0][2].c[1][7] = -8.0 * c_phi / s_theta;
    coeffs->M[0][0][2].c[0][8] = 8.0 * c_theta_c_phi / s_theta;
    coeffs->M[0][1][0].degree = 8;
    coeffs->M[0][1][0].time_degree = 2;
    coeffs->M[0][1][0].c[0][2] = -8.0 * c_phi * k4 * s_phi * k_minus_one_times_k_plus_one;
    coeffs->M[0][1][0].c[2][2] = 16.0 * c_phi * k2 * s_phi * k_minus_one_times_k_plus_one / s_theta2;
    coeffs->M[0][1][0].c[1][3] = -32.0 * c_theta_c_phi * k2 * s_phi * k_minus_one_times_k_plus_one / s_theta2;
    coeffs->M[0][1][0].c[0][4] = (8.0 * c_phi * k2 * s_phi * (c_theta2 * k2 - c_theta2 + 2.0 * k2 * s_theta2 + k2 - s_theta2 - 1.0) / s_theta2);
    coeffs->M[0][1][0].c[2][4] = -16.0 * c_phi_s_phi * two_k2_minus_one / s_theta2;
    coeffs->M[0][1][0].c[1][5] = 32.0 * c_theta_c_phi * s_phi * two_k2_minus_one / s_theta2;
    coeffs->M[0][1][0].c[0][6] = (-8.0 * c_phi_s_phi * (2.0 * c_theta2 * k2 - c_theta2 + k2 * s_theta2 + 2.0 * k2 - 1.0) / s_theta2);
    coeffs->M[0][1][0].c[2][6] = 16.0 * c_phi_s_phi / s_theta2;
    coeffs->M[0][1][0].c[1][7] = -32.0 * c_theta_c_phi * s_phi / s_theta2;
    coeffs->M[0][1][0].c[0][8] = 8.0 * c_phi_s_phi * (c_theta2 + 1.0) / s_theta2;
    coeffs->M[0][1][1].degree = 8;
    coeffs->M[0][1][1].time_degree = 2;
    coeffs->M[0][1][1].c[0][2] = 8.0 * c_phi2 * k4 * k_minus_one_times_k_plus_one;
    coeffs->M[0][1][1].c[2][2] = -8.0 * k2 * c_phi2_minus_s_phi2 * k_minus_one_times_k_plus_one / s_theta2;
    coeffs->M[0][1][1].c[1][3] = 16.0 * c_theta * k2 * c_phi2_minus_s_phi2 * k_minus_one_times_k_plus_one / s_theta2;
    coeffs->M[0][1][1].c[0][4] =
        (-8.0 * k2 * (2.0 * c_phi2 * k2 * s_theta2 + c_phi2 * k2 - c_phi2 * s_theta2 - c_phi2 - c_theta2 * k2 * s_phi2 + c_theta2 * s_phi2) /
         s_theta2);
    coeffs->M[0][1][1].c[2][4] = 8.0 * c_phi2_minus_s_phi2 * two_k2_minus_one / s_theta2;
    coeffs->M[0][1][1].c[1][5] = -16.0 * c_theta * c_phi2_minus_s_phi2 * two_k2_minus_one / s_theta2;
    coeffs->M[0][1][1].c[0][6] =
        (8.0 * (c_phi2 * k2 * s_theta2 + 2.0 * c_phi2 * k2 - c_phi2 - 2.0 * c_theta2 * k2 * s_phi2 + c_theta2 * s_phi2) / s_theta2);
    coeffs->M[0][1][1].c[2][6] = -8.0 * c_phi2_minus_s_phi2 / s_theta2;
    coeffs->M[0][1][1].c[1][7] = 16.0 * c_theta * c_phi2_minus_s_phi2 / s_theta2;
    coeffs->M[0][1][1].c[0][8] = -8.0 * c_phi2_minus_c_theta2_s_phi2 / s_theta2;
    coeffs->M[0][1][2].degree = 8;
    coeffs->M[0][1][2].time_degree = 1;
    coeffs->M[0][1][2].c[1][3] = -8.0 * k2 * s_phi * k_minus_one_times_k_plus_one / s_theta;
    coeffs->M[0][1][2].c[0][4] = 8.0 * c_theta * k2 * s_phi * k_minus_one_times_k_plus_one / s_theta;
    coeffs->M[0][1][2].c[1][5] = 8.0 * s_phi * two_k2_minus_one / s_theta;
    coeffs->M[0][1][2].c[0][6] = -8.0 * c_theta_s_phi * two_k2_minus_one / s_theta;
    coeffs->M[0][1][2].c[1][7] = -8.0 * s_phi / s_theta;
    coeffs->M[0][1][2].c[0][8] = 8.0 * c_theta_s_phi / s_theta;
    coeffs->M[0][2][0].degree = 8;
    coeffs->M[0][2][0].time_degree = 1;
    coeffs->M[0][2][0].c[1][1] = c_phi * two_k2_minus_one_cube / s_theta;
    coeffs->M[0][2][0].c[0][2] = -c_theta_c_phi * two_k2_minus_one_cube / s_theta;
    coeffs->M[0][2][0].c[1][3] = -6.0 * c_phi * two_k2_minus_one_sq / s_theta;
    coeffs->M[0][2][0].c[0][4] = 6.0 * c_theta_c_phi * two_k2_minus_one_sq / s_theta;
    coeffs->M[0][2][0].c[1][5] = 12.0 * c_phi * two_k2_minus_one / s_theta;
    coeffs->M[0][2][0].c[0][6] = -12.0 * c_theta_c_phi * two_k2_minus_one / s_theta;
    coeffs->M[0][2][0].c[1][7] = -8.0 * c_phi / s_theta;
    coeffs->M[0][2][0].c[0][8] = 8.0 * c_theta_c_phi / s_theta;
    coeffs->M[0][2][1].degree = 8;
    coeffs->M[0][2][1].time_degree = 1;
    coeffs->M[0][2][1].c[1][1] = s_phi * two_k2_minus_one_cube / s_theta;
    coeffs->M[0][2][1].c[0][2] = -c_theta_s_phi * two_k2_minus_one_cube / s_theta;
    coeffs->M[0][2][1].c[1][3] = -6.0 * s_phi * two_k2_minus_one_sq / s_theta;
    coeffs->M[0][2][1].c[0][4] = 6.0 * c_theta_s_phi * two_k2_minus_one_sq / s_theta;
    coeffs->M[0][2][1].c[1][5] = 12.0 * s_phi * two_k2_minus_one / s_theta;
    coeffs->M[0][2][1].c[0][6] = -12.0 * c_theta_s_phi * two_k2_minus_one / s_theta;
    coeffs->M[0][2][1].c[1][7] = -8.0 * s_phi / s_theta;
    coeffs->M[0][2][1].c[0][8] = 8.0 * c_theta_s_phi / s_theta;
    coeffs->M[0][2][2].degree = 8;
    coeffs->M[0][2][2].time_degree = 0;
    coeffs->M[0][2][2].c[0][2] = -two_k2_minus_one_cube;
    coeffs->M[0][2][2].c[0][4] = 6.0 * two_k2_minus_one_sq;
    coeffs->M[0][2][2].c[0][6] = -12.0 * two_k2_minus_one;
    coeffs->M[0][2][2].c[0][8] = 8.0;
    coeffs->dM[0][0][0][0].degree = 9;
    coeffs->dM[0][0][0][0].time_degree = 3;
    coeffs->dM[0][0][0][0].c[1][2] = 24.0 * c_phi * k4 * s_phi2 * k_minus_one_times_k_plus_one / s_theta;
    coeffs->dM[0][0][0][0].c[3][2] = (8.0 * c_phi * k2 * c_phi2_minus_3_s_phi2 * k_minus_one_times_k_plus_one / s_theta3);
    coeffs->dM[0][0][0][0].c[0][3] = -24.0 * c_theta_c_phi * k4 * s_phi2 * k_minus_one_times_k_plus_one / s_theta;
    coeffs->dM[0][0][0][0].c[2][3] = (-24.0 * c_theta_c_phi * k2 * c_phi2_minus_3_s_phi2 * k_minus_one_times_k_plus_one / s_theta3);
    coeffs->dM[0][0][0][0].c[1][4] = (24.0 * c_phi * k2 *
                                      (c_phi2 * c_theta2 * k2 - c_phi2 * c_theta2 - 2.0 * c_theta2 * k2 * s_phi2 + 2.0 * c_theta2 * s_phi2 -
                                       2.0 * k2 * s_phi2 * s_theta2 - k2 * s_phi2 + s_phi2 * s_theta2 + s_phi2) /
                                      s_theta3);
    coeffs->dM[0][0][0][0].c[3][4] = -8.0 * c_phi * c_phi2_minus_3_s_phi2 * two_k2_minus_one / s_theta3;
    coeffs->dM[0][0][0][0].c[0][5] =
        (-8.0 * c_theta_c_phi * k2 *
         (c_phi2 * c_theta2 * k2 - c_phi2 * c_theta2 - 6.0 * k2 * s_phi2 * s_theta2 - 3.0 * k2 * s_phi2 + 3.0 * s_phi2 * s_theta2 + 3.0 * s_phi2) /
         s_theta3);
    coeffs->dM[0][0][0][0].c[2][5] = (24.0 * c_theta_c_phi * c_phi2_minus_3_s_phi2 * two_k2_minus_one / s_theta3);
    coeffs->dM[0][0][0][0].c[1][6] = (-24.0 * c_phi *
                                      (2.0 * c_phi2 * c_theta2 * k2 - c_phi2 * c_theta2 - 4.0 * c_theta2 * k2 * s_phi2 + 2.0 * c_theta2 * s_phi2 -
                                       k2 * s_phi2 * s_theta2 - 2.0 * k2 * s_phi2 + s_phi2) /
                                      s_theta3);
    coeffs->dM[0][0][0][0].c[3][6] = 8.0 * c_phi * c_phi2_minus_3_s_phi2 / s_theta3;
    coeffs->dM[0][0][0][0].c[0][7] =
        (8.0 * c_theta_c_phi * (2.0 * c_phi2 * c_theta2 * k2 - c_phi2 * c_theta2 - 3.0 * k2 * s_phi2 * s_theta2 - 6.0 * k2 * s_phi2 + 3.0 * s_phi2) /
         s_theta3);
    coeffs->dM[0][0][0][0].c[2][7] = -24.0 * c_theta_c_phi * c_phi2_minus_3_s_phi2 / s_theta3;
    coeffs->dM[0][0][0][0].c[1][8] = (24.0 * c_phi * (c_phi2 * c_theta2 - 2.0 * c_theta2 * s_phi2 - s_phi2) / s_theta3);
    coeffs->dM[0][0][0][0].c[0][9] = (-8.0 * c_theta_c_phi * (c_phi2 * c_theta2 - 3.0 * s_phi2) / s_theta3);
    coeffs->dM[0][0][0][1].degree = 9;
    coeffs->dM[0][0][0][1].time_degree = 3;
    coeffs->dM[0][0][0][1].c[1][2] = 8.0 * k4 * s_phi * k_minus_one_times_k_plus_one * (3.0 * s_phi2 - 2.0) / s_theta;
    coeffs->dM[0][0][0][1].c[3][2] = (8.0 * k2 * s_phi * k_minus_one_times_k_plus_one * c_phi2_minus_3_s_phi2_plus_2 / s_theta3);
    coeffs->dM[0][0][0][1].c[0][3] = -8.0 * c_theta * k4 * s_phi * k_minus_one_times_k_plus_one * (3.0 * s_phi2 - 2.0) / s_theta;
    coeffs->dM[0][0][0][1].c[2][3] = (-24.0 * c_theta * k2 * s_phi * k_minus_one_times_k_plus_one * c_phi2_minus_3_s_phi2_plus_2 / s_theta3);
    coeffs->dM[0][0][0][1].c[1][4] = (8.0 * k2 * s_phi *
                                      (3.0 * c_phi2 * c_theta2 * k2 - 3.0 * c_phi2 * c_theta2 - 6.0 * c_theta2 * k2 * s_phi2 + 4.0 * c_theta2 * k2 +
                                       6.0 * c_theta2 * s_phi2 - 4.0 * c_theta2 - 6.0 * k2 * s_phi2 * s_theta2 - 3.0 * k2 * s_phi2 +
                                       4.0 * k2 * s_theta2 + 2.0 * k2 + 3.0 * s_phi2 * s_theta2 + 3.0 * s_phi2 - 2.0 * s_theta2 - 2.0) /
                                      s_theta3);
    coeffs->dM[0][0][0][1].c[3][4] = (-8.0 * s_phi * two_k2_minus_one * c_phi2_minus_3_s_phi2_plus_2 / s_theta3);
    coeffs->dM[0][0][0][1].c[0][5] = (-8.0 * c_theta * k2 * s_phi *
                                      (c_phi2 * c_theta2 * k2 - c_phi2 * c_theta2 - 6.0 * k2 * s_phi2 * s_theta2 - 3.0 * k2 * s_phi2 +
                                       4.0 * k2 * s_theta2 + 2.0 * k2 + 3.0 * s_phi2 * s_theta2 + 3.0 * s_phi2 - 2.0 * s_theta2 - 2.0) /
                                      s_theta3);
    coeffs->dM[0][0][0][1].c[2][5] = (24.0 * c_theta_s_phi * two_k2_minus_one * c_phi2_minus_3_s_phi2_plus_2 / s_theta3);
