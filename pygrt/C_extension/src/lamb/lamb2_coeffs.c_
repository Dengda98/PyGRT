         s_theta2);
    coeffs->dM[1][1][2][0].c[2][4] = -8.0 * c_phi_s_phi * six_k4_minus_six_k2_plus_one / s_theta2;
    coeffs->dM[1][1][2][0].c[1][5] = 16.0 * c_theta_c_phi * s_phi * six_k4_minus_six_k2_plus_one / s_theta2;
    coeffs->dM[1][1][2][0].c[0][6] =
        (-4.0 * c_phi_s_phi *
         (6.0 * c_theta2 * k4 - 6.0 * c_theta2 * k2 + c_theta2 + 6.0 * k4 * s_theta2 + 6.0 * k4 - 3.0 * k2 * s_theta2 - 6.0 * k2 + 1.0) / s_theta2);
    coeffs->dM[1][1][2][0].c[2][6] = 24.0 * c_phi_s_phi * two_k2_minus_one / s_theta2;
    coeffs->dM[1][1][2][0].c[1][7] = -48.0 * c_theta_c_phi * s_phi * two_k2_minus_one / s_theta2;
    coeffs->dM[1][1][2][0].c[0][8] = (4.0 * c_phi_s_phi * (6.0 * c_theta2 * k2 - 3.0 * c_theta2 + 2.0 * k2 * s_theta2 + 6.0 * k2 - 3.0) / s_theta2);
    coeffs->dM[1][1][2][0].c[2][8] = -16.0 * c_phi_s_phi / s_theta2;
    coeffs->dM[1][1][2][0].c[1][9] = 32.0 * c_theta_c_phi * s_phi / s_theta2;
    coeffs->dM[1][1][2][0].c[0][10] = -8.0 * c_phi_s_phi * (c_theta2 + 1.0) / s_theta2;
    coeffs->dM[1][1][2][1].degree = 10;
    coeffs->dM[1][1][2][1].time_degree = 2;
    coeffs->dM[1][1][2][1].c[0][2] = 4.0 * c_phi2 * k4 * k_minus_one_times_k_plus_one * two_k2_minus_one;
    coeffs->dM[1][1][2][1].c[2][2] = -4.0 * k2 * c_phi2_minus_s_phi2 * k_minus_one_times_k_plus_one * two_k2_minus_one / s_theta2;
    coeffs->dM[1][1][2][1].c[1][3] = (8.0 * c_theta * k2 * c_phi2_minus_s_phi2 * k_minus_one_times_k_plus_one * two_k2_minus_one / s_theta2);
    coeffs->dM[1][1][2][1].c[0][4] = (-4.0 * k2 *
                                      (6.0 * c_phi2 * k4 * s_theta2 + 2.0 * c_phi2 * k4 - 6.0 * c_phi2 * k2 * s_theta2 - 3.0 * c_phi2 * k2 +
                                       c_phi2 * s_theta2 + c_phi2 - 2.0 * c_theta2 * k4 * s_phi2 + 3.0 * c_theta2 * k2 * s_phi2 - c_theta2 * s_phi2) /
                                      s_theta2);
    coeffs->dM[1][1][2][1].c[2][4] = 4.0 * c_phi2_minus_s_phi2 * six_k4_minus_six_k2_plus_one / s_theta2;
    coeffs->dM[1][1][2][1].c[1][5] = (-8.0 * c_theta * c_phi2_minus_s_phi2 * six_k4_minus_six_k2_plus_one / s_theta2);
    coeffs->dM[1][1][2][1].c[0][6] = (4.0 *
                                      (6.0 * c_phi2 * k4 * s_theta2 + 6.0 * c_phi2 * k4 - 3.0 * c_phi2 * k2 * s_theta2 - 6.0 * c_phi2 * k2 + c_phi2 -
                                       6.0 * c_theta2 * k4 * s_phi2 + 6.0 * c_theta2 * k2 * s_phi2 - c_theta2 * s_phi2) /
                                      s_theta2);
    coeffs->dM[1][1][2][1].c[2][6] = -12.0 * c_phi2_minus_s_phi2 * two_k2_minus_one / s_theta2;
    coeffs->dM[1][1][2][1].c[1][7] = 24.0 * c_theta * c_phi2_minus_s_phi2 * two_k2_minus_one / s_theta2;
    coeffs->dM[1][1][2][1].c[0][8] =
        (-4.0 * (2.0 * c_phi2 * k2 * s_theta2 + 6.0 * c_phi2 * k2 - 3.0 * c_phi2 - 6.0 * c_theta2 * k2 * s_phi2 + 3.0 * c_theta2 * s_phi2) /
         s_theta2);
    coeffs->dM[1][1][2][1].c[2][8] = 8.0 * c_phi2_minus_s_phi2 / s_theta2;
    coeffs->dM[1][1][2][1].c[1][9] = -16.0 * c_theta * c_phi2_minus_s_phi2 / s_theta2;
    coeffs->dM[1][1][2][1].c[0][10] = 8.0 * c_phi2_minus_c_theta2_s_phi2 / s_theta2;
    coeffs->dM[1][1][2][2].degree = 10;
    coeffs->dM[1][1][2][2].time_degree = 1;
    coeffs->dM[1][1][2][2].c[1][3] = -4.0 * k2 * s_phi * k_minus_one_times_k_plus_one * two_k2_minus_one / s_theta;
    coeffs->dM[1][1][2][2].c[0][4] = 4.0 * c_theta * k2 * s_phi * k_minus_one_times_k_plus_one * two_k2_minus_one / s_theta;
    coeffs->dM[1][1][2][2].c[1][5] = 4.0 * s_phi * six_k4_minus_six_k2_plus_one / s_theta;
    coeffs->dM[1][1][2][2].c[0][6] = -4.0 * c_theta_s_phi * six_k4_minus_six_k2_plus_one / s_theta;
    coeffs->dM[1][1][2][2].c[1][7] = -12.0 * s_phi * two_k2_minus_one / s_theta;
    coeffs->dM[1][1][2][2].c[0][8] = 12.0 * c_theta_s_phi * two_k2_minus_one / s_theta;
    coeffs->dM[1][1][2][2].c[1][9] = 8.0 * s_phi / s_theta;
    coeffs->dM[1][1][2][2].c[0][10] = -8.0 * c_theta_s_phi / s_theta;
    coeffs->receiver_vertical[1][0].degree = 10;
    coeffs->receiver_vertical[1][0].time_degree = 1;
    coeffs->receiver_vertical[1][0].c[1][1] = (2.0 * c_phi * k2 * k_minus_one_times_k_plus_one * two_k2_minus_one_cube / s_theta);
    coeffs->receiver_vertical[1][0].c[0][2] = (-2.0 * c_theta_c_phi * k2 * k_minus_one_times_k_plus_one * two_k2_minus_one_cube / s_theta);
    coeffs->receiver_vertical[1][0].c[1][3] = (-2.0 * c_phi * two_k2_minus_one_sq * (8.0 * k4 - 8.0 * k2 + 1.0) / s_theta);
    coeffs->receiver_vertical[1][0].c[0][4] = (2.0 * c_theta_c_phi * two_k2_minus_one_sq * (8.0 * k4 - 8.0 * k2 + 1.0) / s_theta);
    coeffs->receiver_vertical[1][0].c[1][5] = 2.0 * c_phi * two_k2_minus_one * (24.0 * k4 - 24.0 * k2 + 5.0) / s_theta;
    coeffs->receiver_vertical[1][0].c[0][6] = -2.0 * c_theta_c_phi * two_k2_minus_one * (24.0 * k4 - 24.0 * k2 + 5.0) / s_theta;
    coeffs->receiver_vertical[1][0].c[1][7] = -16.0 * c_phi * two_k2_minus_one_sq / s_theta;
    coeffs->receiver_vertical[1][0].c[0][8] = 16.0 * c_theta_c_phi * two_k2_minus_one_sq / s_theta;
    coeffs->receiver_vertical[1][0].c[1][9] = 8.0 * c_phi * two_k2_minus_one / s_theta;
    coeffs->receiver_vertical[1][0].c[0][10] = -8.0 * c_theta_c_phi * two_k2_minus_one / s_theta;
    coeffs->receiver_vertical[1][1].degree = 10;
    coeffs->receiver_vertical[1][1].time_degree = 1;
    coeffs->receiver_vertical[1][1].c[1][1] = (2.0 * k2 * s_phi * k_minus_one_times_k_plus_one * two_k2_minus_one_cube / s_theta);
    coeffs->receiver_vertical[1][1].c[0][2] = (-2.0 * c_theta * k2 * s_phi * k_minus_one_times_k_plus_one * two_k2_minus_one_cube / s_theta);
    coeffs->receiver_vertical[1][1].c[1][3] = (-2.0 * s_phi * two_k2_minus_one_sq * (8.0 * k4 - 8.0 * k2 + 1.0) / s_theta);
    coeffs->receiver_vertical[1][1].c[0][4] = (2.0 * c_theta_s_phi * two_k2_minus_one_sq * (8.0 * k4 - 8.0 * k2 + 1.0) / s_theta);
    coeffs->receiver_vertical[1][1].c[1][5] = 2.0 * s_phi * two_k2_minus_one * (24.0 * k4 - 24.0 * k2 + 5.0) / s_theta;
    coeffs->receiver_vertical[1][1].c[0][6] = -2.0 * c_theta_s_phi * two_k2_minus_one * (24.0 * k4 - 24.0 * k2 + 5.0) / s_theta;
    coeffs->receiver_vertical[1][1].c[1][7] = -16.0 * s_phi * two_k2_minus_one_sq / s_theta;
    coeffs->receiver_vertical[1][1].c[0][8] = 16.0 * c_theta_s_phi * two_k2_minus_one_sq / s_theta;
    coeffs->receiver_vertical[1][1].c[1][9] = 8.0 * s_phi * two_k2_minus_one / s_theta;
    coeffs->receiver_vertical[1][1].c[0][10] = -8.0 * c_theta_s_phi * two_k2_minus_one / s_theta;
    coeffs->receiver_vertical[1][2].degree = 10;
    coeffs->receiver_vertical[1][2].time_degree = 0;
    coeffs->receiver_vertical[1][2].c[0][2] = -2.0 * k2 * k_minus_one_times_k_plus_one * two_k2_minus_one_cube;
    coeffs->receiver_vertical[1][2].c[0][4] = 2.0 * two_k2_minus_one_sq * (8.0 * k4 - 8.0 * k2 + 1.0);
    coeffs->receiver_vertical[1][2].c[0][6] = -2.0 * two_k2_minus_one * (24.0 * k4 - 24.0 * k2 + 5.0);
    coeffs->receiver_vertical[1][2].c[0][8] = 16.0 * two_k2_minus_one_sq;
    coeffs->receiver_vertical[1][2].c[0][10] = -8.0 * two_k2_minus_one;
}

static void make_lamb2_S_coefficients(const LAMB2_VARS *V, LAMB2_COEFF_SET *coeffs) {
    const real_t k = V->k;
    const real_t c_theta = V->ct;
    const real_t s_theta = V->st;
    const real_t c_phi = V->cf;
    const real_t s_phi = V->sf;

    /* 共享的幂次和三角函数平方 */
    const real_t k2 = k * k;
    const real_t c_theta2 = c_theta * c_theta;
    const real_t s_theta2 = s_theta * s_theta;
    const real_t s_theta3 = s_theta2 * s_theta;
    const real_t c_phi2 = c_phi * c_phi;
    const real_t s_phi2 = s_phi * s_phi;

    /* 共享的角度乘积 */
    const real_t c_theta_c_phi = c_theta * c_phi;
    const real_t c_theta_s_phi = c_theta * s_phi;
    const real_t c_phi_s_phi = c_phi * s_phi;

    /* 系数中反复出现的材料参数组合 */
    const real_t k_minus_one = k - 1.0;
    const real_t k_plus_one = k + 1.0;
    const real_t k_minus_one_times_k_plus_one = k_minus_one * k_plus_one;
    const real_t two_k2_minus_one = 2.0 * k2 - 1.0;

    /* 系数中反复出现的方位角组合 */
    const real_t c_phi2_minus_s_phi2 = (c_phi - s_phi) * (c_phi + s_phi);
    const real_t c_phi2_minus_c_theta2_s_phi2 = (c_phi - c_theta_s_phi) * (c_phi + c_theta_s_phi);
    const real_t c_phi2_c_theta2_minus_s_phi2 = (c_theta_c_phi - s_phi) * (c_theta_c_phi + s_phi);
    const real_t c_phi2_minus_3_s_phi2 = c_phi2 - 3.0 * s_phi2;
    const real_t c_phi2_minus_3_s_phi2_plus_2 = c_phi2_minus_3_s_phi2 + 2.0;

    /* S 波系数中反复出现的 k 多项式因子 */
    const real_t two_k2_minus_three = 2.0 * k2 - 3.0;
    const real_t two_k2_minus_five = 2.0 * k2 - 5.0;
    const real_t four_k2_minus_five = 4.0 * k2 - 5.0;
    const real_t eight_k2_minus_five = 8.0 * k2 - 5.0;
    const real_t three_k2_minus_four = 3.0 * k2 - 4.0;

    memset(coeffs, 0, sizeof(*coeffs));

    coeffs->M[0][0][0].degree = 8;
    coeffs->M[0][0][0].time_degree = 2;
    coeffs->M[0][0][0].c[0][0] = c_phi2;
    coeffs->M[0][0][0].c[2][0] = -c_phi2_minus_s_phi2 / s_theta2;
    coeffs->M[0][0][0].c[1][1] = 2.0 * c_theta * c_phi2_minus_s_phi2 / s_theta2;
    coeffs->M[0][0][0].c[0][2] = (-(16.0 * c_phi2 * k2 * s_theta2 - 10.0 * c_phi2 * s_theta2 + c_phi2 - c_theta2 * s_phi2 + s_theta2) / s_theta2);
    coeffs->M[0][0][0].c[2][2] = 2.0 * c_phi2_minus_s_phi2 * eight_k2_minus_five / s_theta2;
    coeffs->M[0][0][0].c[1][3] = -4.0 * c_theta * c_phi2_minus_s_phi2 * eight_k2_minus_five / s_theta2;
    coeffs->M[0][0][0].c[0][4] = (2.0 *
                                  (8.0 * c_phi2 * k2 * s_theta2 + 8.0 * c_phi2 * k2 - 10.0 * c_phi2 * s_theta2 - 5.0 * c_phi2 -
                                   8.0 * c_theta2 * k2 * s_phi2 + 5.0 * c_theta2 * s_phi2 + 3.0 * s_theta2) /
                                  s_theta2);
    coeffs->M[0][0][0].c[2][4] = -4.0 * c_phi2_minus_s_phi2 * four_k2_minus_five / s_theta2;
    coeffs->M[0][0][0].c[1][5] = 8.0 * c_theta * c_phi2_minus_s_phi2 * four_k2_minus_five / s_theta2;
    coeffs->M[0][0][0].c[0][6] =
        (-4.0 *
         (4.0 * c_phi2 * k2 - 2.0 * c_phi2 * s_theta2 - 5.0 * c_phi2 - 4.0 * c_theta2 * k2 * s_phi2 + 5.0 * c_theta2 * s_phi2 + 3.0 * s_theta2) /
         s_theta2);
    coeffs->M[0][0][0].c[2][6] = -8.0 * c_phi2_minus_s_phi2 / s_theta2;
    coeffs->M[0][0][0].c[1][7] = 16.0 * c_theta * c_phi2_minus_s_phi2 / s_theta2;
    coeffs->M[0][0][0].c[0][8] = (-8.0 * (c_phi2 - c_theta2 * s_phi2 - s_theta2) / s_theta2);
    coeffs->M[0][0][1].degree = 8;
    coeffs->M[0][0][1].time_degree = 2;
    coeffs->M[0][0][1].c[0][0] = c_phi_s_phi;
    coeffs->M[0][0][1].c[2][0] = -2.0 * c_phi_s_phi / s_theta2;
    coeffs->M[0][0][1].c[1][1] = 4.0 * c_theta_c_phi * s_phi / s_theta2;
    coeffs->M[0][0][1].c[0][2] = (-c_phi_s_phi * (c_theta2 + 16.0 * k2 * s_theta2 - 10.0 * s_theta2 + 1.0) / s_theta2);
    coeffs->M[0][0][1].c[2][2] = 4.0 * c_phi_s_phi * eight_k2_minus_five / s_theta2;
    coeffs->M[0][0][1].c[1][3] = -8.0 * c_theta_c_phi * s_phi * eight_k2_minus_five / s_theta2;
    coeffs->M[0][0][1].c[0][4] =
        (2.0 * c_phi_s_phi * (8.0 * c_theta2 * k2 - 5.0 * c_theta2 + 8.0 * k2 * s_theta2 + 8.0 * k2 - 10.0 * s_theta2 - 5.0) / s_theta2);
    coeffs->M[0][0][1].c[2][4] = -8.0 * c_phi_s_phi * four_k2_minus_five / s_theta2;
    coeffs->M[0][0][1].c[1][5] = 16.0 * c_theta_c_phi * s_phi * four_k2_minus_five / s_theta2;
    coeffs->M[0][0][1].c[0][6] = (-4.0 * c_phi_s_phi * (4.0 * c_theta2 * k2 - 5.0 * c_theta2 + 4.0 * k2 - 2.0 * s_theta2 - 5.0) / s_theta2);
    coeffs->M[0][0][1].c[2][6] = -16.0 * c_phi_s_phi / s_theta2;
    coeffs->M[0][0][1].c[1][7] = 32.0 * c_theta_c_phi * s_phi / s_theta2;
    coeffs->M[0][0][1].c[0][8] = -8.0 * c_phi_s_phi * (c_theta2 + 1.0) / s_theta2;
    coeffs->M[0][0][2].degree = 8;
    coeffs->M[0][0][2].time_degree = 1;
    coeffs->M[0][0][2].c[1][1] = -c_phi / s_theta;
    coeffs->M[0][0][2].c[0][2] = c_theta_c_phi / s_theta;
    coeffs->M[0][0][2].c[1][3] = 6.0 * c_phi / s_theta;
    coeffs->M[0][0][2].c[0][4] = -6.0 * c_theta_c_phi / s_theta;
    coeffs->M[0][0][2].c[1][5] = -12.0 * c_phi / s_theta;
    coeffs->M[0][0][2].c[0][6] = 12.0 * c_theta_c_phi / s_theta;
    coeffs->M[0][0][2].c[1][7] = 8.0 * c_phi / s_theta;
    coeffs->M[0][0][2].c[0][8] = -8.0 * c_theta_c_phi / s_theta;
    coeffs->M[0][1][0].degree = 8;
    coeffs->M[0][1][0].time_degree = 2;
    coeffs->M[0][1][0].c[0][0] = c_phi_s_phi;
    coeffs->M[0][1][0].c[2][0] = -2.0 * c_phi_s_phi / s_theta2;
    coeffs->M[0][1][0].c[1][1] = 4.0 * c_theta_c_phi * s_phi / s_theta2;
    coeffs->M[0][1][0].c[0][2] = (-c_phi_s_phi * (c_theta2 + 16.0 * k2 * s_theta2 - 10.0 * s_theta2 + 1.0) / s_theta2);
    coeffs->M[0][1][0].c[2][2] = 4.0 * c_phi_s_phi * eight_k2_minus_five / s_theta2;
    coeffs->M[0][1][0].c[1][3] = -8.0 * c_theta_c_phi * s_phi * eight_k2_minus_five / s_theta2;
    coeffs->M[0][1][0].c[0][4] =
        (2.0 * c_phi_s_phi * (8.0 * c_theta2 * k2 - 5.0 * c_theta2 + 8.0 * k2 * s_theta2 + 8.0 * k2 - 10.0 * s_theta2 - 5.0) / s_theta2);
    coeffs->M[0][1][0].c[2][4] = -8.0 * c_phi_s_phi * four_k2_minus_five / s_theta2;
    coeffs->M[0][1][0].c[1][5] = 16.0 * c_theta_c_phi * s_phi * four_k2_minus_five / s_theta2;
    coeffs->M[0][1][0].c[0][6] = (-4.0 * c_phi_s_phi * (4.0 * c_theta2 * k2 - 5.0 * c_theta2 + 4.0 * k2 - 2.0 * s_theta2 - 5.0) / s_theta2);
    coeffs->M[0][1][0].c[2][6] = -16.0 * c_phi_s_phi / s_theta2;
    coeffs->M[0][1][0].c[1][7] = 32.0 * c_theta_c_phi * s_phi / s_theta2;
    coeffs->M[0][1][0].c[0][8] = -8.0 * c_phi_s_phi * (c_theta2 + 1.0) / s_theta2;
    coeffs->M[0][1][1].degree = 8;
    coeffs->M[0][1][1].time_degree = 2;
    coeffs->M[0][1][1].c[0][0] = s_phi2;
    coeffs->M[0][1][1].c[2][0] = c_phi2_minus_s_phi2 / s_theta2;
    coeffs->M[0][1][1].c[1][1] = -2.0 * c_theta * c_phi2_minus_s_phi2 / s_theta2;
    coeffs->M[0][1][1].c[0][2] = (-(-c_phi2 * c_theta2 + 16.0 * k2 * s_phi2 * s_theta2 - 10.0 * s_phi2 * s_theta2 + s_phi2 + s_theta2) / s_theta2);
    coeffs->M[0][1][1].c[2][2] = -2.0 * c_phi2_minus_s_phi2 * eight_k2_minus_five / s_theta2;
    coeffs->M[0][1][1].c[1][3] = 4.0 * c_theta * c_phi2_minus_s_phi2 * eight_k2_minus_five / s_theta2;
    coeffs->M[0][1][1].c[0][4] = (-2.0 *
                                  (8.0 * c_phi2 * c_theta2 * k2 - 5.0 * c_phi2 * c_theta2 - 8.0 * k2 * s_phi2 * s_theta2 - 8.0 * k2 * s_phi2 +
                                   10.0 * s_phi2 * s_theta2 + 5.0 * s_phi2 - 3.0 * s_theta2) /
                                  s_theta2);
    coeffs->M[0][1][1].c[2][4] = 4.0 * c_phi2_minus_s_phi2 * four_k2_minus_five / s_theta2;
    coeffs->M[0][1][1].c[1][5] = -8.0 * c_theta * c_phi2_minus_s_phi2 * four_k2_minus_five / s_theta2;
    coeffs->M[0][1][1].c[0][6] =
        (4.0 *
         (4.0 * c_phi2 * c_theta2 * k2 - 5.0 * c_phi2 * c_theta2 - 4.0 * k2 * s_phi2 + 2.0 * s_phi2 * s_theta2 + 5.0 * s_phi2 - 3.0 * s_theta2) /
         s_theta2);
    coeffs->M[0][1][1].c[2][6] = 8.0 * c_phi2_minus_s_phi2 / s_theta2;
    coeffs->M[0][1][1].c[1][7] = -16.0 * c_theta * c_phi2_minus_s_phi2 / s_theta2;
    coeffs->M[0][1][1].c[0][8] = (8.0 * (c_phi2 * c_theta2 - s_phi2 + s_theta2) / s_theta2);
    coeffs->M[0][1][2].degree = 8;
    coeffs->M[0][1][2].time_degree = 1;
    coeffs->M[0][1][2].c[1][1] = -s_phi / s_theta;
